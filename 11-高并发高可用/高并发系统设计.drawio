        <mxCell id="h08_o2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#DC2626;strokeWidth=1.3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="695" y="440" as="sourcePoint" />
