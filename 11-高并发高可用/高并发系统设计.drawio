ometry x="436" y="366" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p26" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="100" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p27" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="148" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p28" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="196" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p29" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="244" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p30" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="292" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p31" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="340" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p32" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="388" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_p33" value="" style="rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="436" y="402" width="40" height="28" as="geometry"/></mxCell><mxCell id="h06_t34" value="被 B 的慢响应&#10;占满 → 新请求进不来" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="336" width="250" height="60" as="geometry"/></mxCell><mxCell id="h06_t35" value="B 恢复后，A 的线程池仍然被“还在等”的请求占着；&#10;所以“恢复”比“故障”更难。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="700" height="44" as="geometry"/></mxCell><mxCell id="h06_t36" value="根因不是 B 慢，而是 A 用同步阻塞的方式等 B。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="510" width="700" height="20" as="geometry"/></mxCell><mxCell id="h06_p37" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="680" height="430" as="geometry"/></mxCell><mxCell id="h06_t38" value="三道防线：超时 → 熔断 → 舱壁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="168" width="620" height="24" as="geometry"/></mxCell><mxCell id="h06_p39" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="884" y="206" width="620" height="94" as="geometry"/></mxCell><mxCell id="h06_t40" value="① 超时" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="218" width="100" height="22" as="geometry"/></mxCell><mxCell id="h06_t41" value="限制单次等待；但 QPS 高时仍会占满线程。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="218" width="400" height="40" as="geometry"/></mxCell><mxCell id="h06_t42" value="基础，不充分" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="266" width="400" height="20" as="geometry"/></mxCell><mxCell id="h06_p43" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="884" y="312" width="620" height="94" as="geometry"/></mxCell><mxCell id="h06_t44" value="② 熔断" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="324" width="100" height="22" as="geometry"/></mxCell><mxCell id="h06_t45" value="错误率 / 慢调用超阈值 → 快速失败，不占线程。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="324" width="400" height="40" as="geometry"/></mxCell><mxCell id="h06_t46" value="释放线程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="372" width="400" height="20" as="geometry"/></mxCell><mxCell id="h06_p47" value="" style="rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="884" y="418" width="620" height="94" as="geometry"/></mxCell><mxCell id="h06_t48" value="③ 舱壁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="430" width="100" height="22" as="geometry"/></mxCell><mxCell id="h06_t49" value="每个下游独立线程池，一个池满不影响其他。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="430" width="400" height="40" as="geometry"/></mxCell><mxCell id="h06_t50" value="隔离故障" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="478" width="400" height="20" as="geometry"/></mxCell><mxCell id="h06_t51" value="三者配合，才能防止级联；缺一个都会留缺口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="524" width="620" height="30" as="geometry"/></mxCell><mxCell id="h06_p52" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1480" height="200" as="geometry"/></mxCell><mxCell id="h06_t53" value="舱壁隔离：一个舱进水，船不会全沉" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="628" width="1400" height="24" as="geometry"/></mxCell><mxCell id="h06_b54" value="线程池 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="670" width="240" height="56" as="geometry"/></mxCell><mxCell id="h06_t55" value="服务 A 正常" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="734" width="240" height="22" as="geometry"/></mxCell><mxCell id="h06_t56" value="互不影响" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="240" height="22" as="geometry"/></mxCell><mxCell id="h06_b57" value="线程池 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="670" width="240" height="56" as="geometry"/></mxCell><mxCell id="h06_t58" value="服务 B 挂了" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="400" y="734" width="240" height="22" as="geometry"/></mxCell><mxCell id="h06_t59" value="只影响本池" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="240" height="22" as="geometry"/></mxCell><mxCell id="h06_b60" value="线程池 3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="670" width="240" height="56" as="geometry"/></mxCell><mxCell id="h06_t61" value="服务 C 正常" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="734" width="240" height="22" as="geometry"/></mxCell><mxCell id="h06_t62" value="互不影响" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="760" width="240" height="22" as="geometry"/></mxCell><mxCell id="h06_t63" value="没有隔离：一个慢下游占满所有线程 → 整个服务不可用。&#10;有隔离：只有对应线程池被占满 → 其他功能继续服务。&#10;Hystrix / Sentinel 都是这个思路。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="480" height="90" as="geometry"/></mxCell><mxCell id="h06_p64" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h06_t65" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h06_t66" value="超时是基础，熔断是止损，舱壁是隔离；核心不是“少发请求”，而是“别让线程被无效等待占满”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h07" name="07 限流"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h07_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h07_title" value="限流：不是拒绝，是保护" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h07_sub" value="令牌桶允许突发，漏桶输出平滑，固定窗口有边界突刺，滑动窗口更精确；限流要分级。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="h07_num" value="07 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="h07_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h07_p1" value="" style="rounded=1;arcSize=16;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="350" height="300" as="geometry"/></mxCell><mxCell id="h07_t2" value="① 令牌桶" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="178" width="310" height="24" as="geometry"/></mxCell><mxCell id="h07_t3" value="固定速率放令牌，桶可攒令牌" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="212" width="310" height="40" as="geometry"/></mxCell><mxCell id="h07_t4" value="特点" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="262" width="310" height="20" as="geometry"/></mxCell><mxCell id="h07_t5" value="允许突发" style="text;html=1;strokeC