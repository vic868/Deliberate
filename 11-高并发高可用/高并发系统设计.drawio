icalAlign=top;fontSize=8.0;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="376" width="300" height="20" as="geometry"/></mxCell><mxCell id="h03_t14" value="布隆 · 互斥锁 · 随机 TTL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.0;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="430" y="352" width="330" height="40" as="geometry"/></mxCell><mxCell id="h03_p15" value="" style="rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="412" width="700" height="60" as="geometry"/></mxCell><mxCell id="h03_t16" value="④ 数据层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.8;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="420" width="140" height="20" as="geometry"/></mxCell><mxCell id="h03_t17" value="连接池耗尽 / 慢查询" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.0;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="444" width="300" height="20" as="geometry"/></mxCell><mxCell id="h03_t18" value="连接池 · 索引 · 读写分离" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.0;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="330" height="40" as="geometry"/></mxCell><mxCell id="h03_p19" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="480" width="700" height="60" as="geometry"/></mxCell><mxCell id="h03_t20" value="⑤ 基础设施" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.8;fontColor=#64748B;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="488" width="140" height="20" as="geometry"/></mxCell><mxCell id="h03_t21" value="CPU / 带宽 / 磁盘硬上限" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.0;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="512" width="300" height="20" as="geometry"/></mxCell><mxCell id="h03_t22" value="容量规划 · 扩容" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.0;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="430" y="488" width="330" height="40" as="geometry"/></mxCell><mxCell id="h03_t23" value="接入层公式：Max Clients = worker_processes × worker_connections / 2&#10;带宽 ≈ 峰值 QPS × 响应体大小 × 8 bit；生产至少 2 台 Nginx。&#10;木桶效应：容量 = 最慢那层的容量；优化快的层没有意义。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="552" width="700" height="60" as="geometry"/></mxCell><mxCell id="h03_p24" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="700" height="460" as="geometry"/></mxCell><mxCell id="h03_t25" value="Why：六条致命因果链" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="168" width="640" height="24" as="geometry"/></mxCell><mxCell id="h03_p26" value="" style="rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="206" width="310" height="84" as="geometry"/></mxCell><mxCell id="h03_t27" value="① 流量突增" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="878" y="216" width="280" height="20" as="geometry"/></mxCell><mxCell id="h03_t28" value="突增 → 无扩容 → 资源耗尽" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="878" y="244" width="280" height="36" as="geometry"/></mxCell><mxCell id="h03_p29" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1194" y="206" width="310" height="84" as="geometry"/></mxCell><mxCell id="h03_t30" value="② 热点数据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1208" y="216" width="280" height="20" as="geometry"/></mxCell><mxCell id="h03_t31" value="热点 key → 集中失效 → 击穿 DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1208" y="244" width="280" height="36" as="geometry"/></mxCell><mxCell id="h03_p32" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="306" width="310" height="84" as="geometry"/></mxCell><mxCell id="h03_t33" value="③ 同步阻塞" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="878" y="316" width="280" height="20" as="geometry"/></mxCell><mxCell id="h03_t34" value="慢请求 → 占线程 → 正常请求饿死" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="878" y="344" width="280" height="36" as="geometry"/></mxCell><mxCell id="h03_p35" value="" style="rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1194" y="306" width="310" height="84" as="geometry"/></mxCell><mxCell id="h03_t36" value="④ 锁竞争" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1208" y="316" width="280" height="20" as="geometry"/></mxCell><mxCell id="h03_t37" value="竞争 → 并行变串行 → 吞吐骤降" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1208" y="344" width="280" height="36" as="geometry"/></mxCell><mxCell id="h03_p38" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="406" width="310" height="84" as="geometry"/></mxCell><mxCell id="h03_t39" value="⑤ 慢查询" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="878" y="416" width="280" height="20" as="geometry"/></mxCell><mxCell id="h03_t40" value="慢 SQL → 占连接 → 死亡螺旋" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="878" y="444" width="280" height="36" as="geometry"/></mxCell><mxCell id="h03_p41" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1194" y="406" width="310" height="84" as="geometry"/></mxCell><mxCell id="h03_t42" value="⑥ 下游故障" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1208" y="416" width="280" height="20" as="geometry"/></mxCell><mxCell id="h03_t43" value="下游挂 → 重试风暴 → 全链雪崩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1208" y="444" width="280" height="36" as="geometry"/></mxCell><mxCell id="h03_p44" value="" style="rounded=1;arcSize=14;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="1480" height="210" as="geometry"/></mxCell><mxCell id="h03_t45" value="最可怕的是叠加" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="648" width="300" height="24" as="geometry"/></mxCell><mxCell id="h03_t46" value="热点 key 过期 → 请求打到 DB → 慢查询 → 占满连接池 → 上游线程池阻塞 → 开始重试 → 流量翻倍 → 全线崩溃。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#F8FAFC;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="680" width="1360" height="100" as="geometry"/></mxCell><mxCell id="h03_t47" value="单点问题可能还能扛；叠加起来就是雪崩。排查时要沿链路找“下一块倒下的多米诺”，而不是只盯一个指标。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#CBD5E1;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="750" width="1360" height="60" as="geometry"/></mxCell><mxCell id="h03_p48" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h03_t49" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h03_t50" value="高并发排查第一原则：系统容量由最慢的一层决定；第二原则：故障会沿调用链叠加，必须全链路看。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h04" name="04 缓存三兄弟"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h04_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h04_title" value="缓存三兄弟：第一道防线，破了后面就是裸奔" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h04_sub" value="穿透查不存在，击穿是单个热点过期，雪崩是大量失效或 Redis 挂掉——三种“面”完全不同。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="h04_num" value="04 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="h04_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h04_p1" value="" style="rounded=1;arcSize=16;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="460" height="310" as="geometry"/></mxCell><mxCell id="h04_t2" value="① 穿透" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="178" width="120" height="26" as="geometry"/></mxCell><mxCell id="h04_t3" value="缓存和 DB 都没有" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="212" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t4" value="海量不存在的 key 绕过缓存，直击 DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="240" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t5" value="·  布隆过滤器：挡“一定不存在”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="282" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t6" value="·  空值缓存：短 TTL 兜底" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="308" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t7" value="·  参数校验 / 限流" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="334" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t8" value="防线等级：★★" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="390" width="420" height="60" as="geometry"/></mxCell><mxCell id="h04_p9" value="" style="rounded=1;arcSize=16;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="460" height="310" as="geometry"/></mxCell><mxCell id="h04_t10" value="② 击穿" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="178" width="120" height="26" as="geometry"/></mxCell><mxCell id="h04_t11" value="单个超级热点 key 过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="212" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t12" value="瞬间大量请求同时查 DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="240" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t13" value="·  互斥锁：只放一个请求重建" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="282" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t14" value="·  逻辑过期：旧值 + 异步刷新" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="308" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t15" value="·  热点 key 永不过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="334" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t16" value="防线等级：★★" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="390" width="420" height="60" as="geometry"/></mxCell><mxCell id="h04_p17" value="" style="rounded=1;arcSize=16;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="460" height="310" as="geometry"/></mxCell><mxCell id="h04_t18" value="③ 雪崩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="178" width="120" height="26" as="geometry"/></mxCell><mxCell id="h04_t19" value="大量 key 同时过期 / Redis 挂" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="212" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t20" value="所有请求涌向 DB，DB 必崩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="240" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t21" value="·  随机 TTL：打散过期时间" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="282" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t22" value="·  多级缓存：本地 + Redis" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="308" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t23" value="·  熔断降级：保住 DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="334" width="420" height="20" as="geometry"/></mxCell><mxCell id="h04_t24" value="防线等级：★★★" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="390" width="420" height="60" as="geometry"/></mxCell><mxCell id="h04_p25" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="1480" height="320" as="geometry"/></mxCell><mxCell id="h04_t26" value="把请求挡在 DB 之前：缓存是第一道防线" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="518" width="1400" height="24" as="geometry"/></mxCell><mxCell id="h04_b27" value="请求" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="570" width="160" height="58" as="geometry"/></mxCell><mxCell id="h04_b28" value="缓存层&#10;布隆 / 空值 / 互斥锁 / 随机 TTL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="546" width="260" height="106" as="geometry"/></mxCell><mxCell id="h04_b29" value="DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="570" width="160" height="58" as="geometry"/></mxCell><mxCell id="h04_a30" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="599" as="sourcePoint"/><mxPoint x="340" y="599" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h04_a31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="599" as="sourcePoint"/><mxPoint x="700" y="599" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h04_t32" value="未命中" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="570.0" y="579.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="h04_a33" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="640" as="sourcePoint"/><mxPoint x="700" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h04_t34" value="穿透 / 雪崩" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="570.0" y="610.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="h04_t35" value="① 穿透用布隆过滤器 + 空值缓存；&#10;② 击穿用互斥锁 / 逻辑过期；&#10;③ 雪崩用随机 TTL + 多级缓存 + 熔断。&#10;共同目标：别让“缓存失效”变成“DB 失效”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="600" height="90" as="geometry"/></mxCell><mxCell id="h04_p36" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="880" y="660" width="620" height="120" as="geometry"/></mxCell><mxCell id="h04_t37" value="面试点：三种问题怎么区分？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="898" y="674" width="590" height="20" as="geometry"/></mxCell><mxCell id="h04_t38" value="穿透是“数据不存在”；击穿是“一个热点 key 过期”；&#10;雪崩是“大量 key 同时失效 / Redis 挂掉”。&#10;先说“面”的大小，再说解法，层次立刻清楚。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="898" y="702" width="590" height="68" as="geometry"/></mxCell><mxCell id="h04_p39" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h04_t40" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h04_t41" value="缓存是高并发的第一道防线：它挡住的不是流量，而是“无效流量”和“重复重建”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h05" name="05 数据层"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h05_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h05_title" value="数据层：有状态，所以最难扩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h05_sub" value="无状态加机器，有状态要分库分表；连接池不是越大越好；慢查询是死亡螺旋的触发器。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="h05_num" value="05 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="h05_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h05_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="720" height="320" as="geometry"/></mxCell><mxCell id="h05_t2" value="为什么数据库最难扩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="660" height="24" as="geometry"/></mxCell><mxCell id="h05_p3" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="208" width="672" height="74" as="geometry"/></mxCell><mxCell id="h05_t4" value="接入 / 应用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="218" width="150" height="22" as="geometry"/></mxCell><mxCell id="h05_t5" value="无状态" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="218" width="180" height="22" as="geometry"/></mxCell><mxCell id="h05_t6" value="加机器即可水平扩展" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="246" width="470" height="24" as="geometry"/></mxCell><mxCell id="h05_p7" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="296" width="672" height="74" as="geometry"/></mxCell><mxCell id="h05_t8" value="缓存" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="306" width="150" height="22" as="geometry"/></mxCell><mxCell id="h05_t9" value="有状态，但可重建" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="306" width="180" height="22" as="geometry"/></mxCell><mxCell id="h05_t10" value="丢了从 DB 重建，扩容中等" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="334" width="470" height="24" as="geometry"/></mxCell><mxCell id="h05_p11" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="384" width="672" height="74" as="geometry"/></mxCell><mxCell id="h05_t12" value="数据层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="394" width="150" height="22" as="geometry"/></mxCell><mxCell id="h05_t13" value="有状态 + 真相来源" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="394" width="180" height="22" as="geometry"/></mxCell><mxCell id="h05_t14" value="分库分表、迁移、一致性，最难" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="422" width="470" height="24" as="geometry"/></mxCell><mxCell id="h05_t15" value="结论：尽量把压力挡在 DB 之前（缓存、MQ），而不是让 DB 硬扛。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="486" width="672" height="20" as="geometry"/></mxCell><mxCell id="h05_p16" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="720" height="320" as="geometry"/></mxCell><mxCell id="h05_t17" value="连接池：越大越好吗？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="168" width="660" height="24" as="geometry"/></mxCell><mxCell id="h05_p18" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="844" y="208" width="660" height="70" as="geometry"/></mxCell><mxCell id="h05_t19" value="经验公式" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="220" width="620" height="20" as="geometry"/></mxCell><mxCell id="h05_t20" value="连接数 ≈ CPU 核心数 × 2 + 有效磁盘数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="246" width="620" height="24" as="geometry"/></mxCell><mxCell id="h05_ax" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="380" as="sourcePoint"/><mxPoint x="1320" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h05_ay" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="380" as="sourcePoint"/><mxPoint x="880" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h05_t21" value="连接数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="388" width="60" height="16" as="geometry"/></mxCell><mxCell id="h05_t22" value="吞吐" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1230" y="388" width="80" height="16" as="geometry"/></mxCell><mxCell id=