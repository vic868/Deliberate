        <mxCell id="h11_t2" value="① 接入层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="174" width="400" height="24" as="geometry" />
