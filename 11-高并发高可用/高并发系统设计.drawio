          <mxGeometry height="22" width="240" x="400" y="734" as="geometry" />
        </mxCell>
        <mxCell id="h06_t59" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" value="只影响本池" vertex="1">
