        <mxCell id="h11_t3" value="☐  Nginx 连接数 / 带宽已评估" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
