          <mxGeometry height="20" width="280" x="878" y="416" as="geometry" />
        </mxCell>
        <mxCell id="h03_t40" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" value="慢 SQL → 占连接 → 死亡螺旋" vertex="1">
