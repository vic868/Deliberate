        <mxCell id="h06_t34" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" value="被 B 的慢响应&#xa;占满 → 新请求进不来" vertex="1">
