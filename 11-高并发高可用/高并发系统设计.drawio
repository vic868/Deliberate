            <mxPoint x="330" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_b6" value="Redis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="220" width="160" height="60" as="geometry" />
