          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="118" as="sourcePoint" />
            <mxPoint x="1540" y="118" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h08_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="780" height="480" as="geometry" />
        </mxCell>
        <mxCell id="h08_t2" value="熔断器三态：关闭 → 打开 → 半开" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="168" width="720" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h08_b3" value="① Closed&#xa;关闭" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="250" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h08_b4" value="② Open&#xa;打开" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h08_b5" value="③ Half-Open&#xa;半开" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="315" y="470" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h08_t6" value="正常调用&#xa;统计错误率" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="128" y="366" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h08_t7" value="快速失败&#xa;不调用下游" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="366" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h08_t8" value="放少量请求&#xa;试探恢复" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="333" y="586" width="150" height="40" as="geometry" />
