          </mxGeometry>
        </mxCell>
        <mxCell id="h08_t10" value="错误率 &gt; 阈值" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="280" width="140" height="20" as="geometry" />
        </mxCell>
