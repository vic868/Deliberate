        <mxCell id="h03_t46" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#F8FAFC;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="热点 key 过期 → 请求打到 DB → 慢查询 → 占满连接池 → 上游线程池阻塞 → 开始重试 → 流量翻倍 → 全线崩溃。" vertex="1">
