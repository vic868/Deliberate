        <mxCell id="h06_t48" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="③ 舱壁" vertex="1">
