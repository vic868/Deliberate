        </mxCell>
        <mxCell id="h08_title" value="熔断与降级：机制和策略，不是一回事" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="36" width="1180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h08_sub" value="熔断是开关，降级是预案；打开状态快速失败，半开状态少量试探。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="82" width="1330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h08_num" value="08 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1370" y="44" width="170" height="24" as="geometry" />
        </mxCell>
