        <mxCell id="h06_b60" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" value="线程池 3" vertex="1">
