 / 熔断 / MQ / 锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1248" y="712" width="240" height="40" as="geometry"/></mxCell><mxCell id="h02_p47" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h02_t48" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h02_t49" value="先说“要看容量和峰值”，再给方案；直接背“加缓存、限流、MQ”反而显得没有判断力。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h03" name="03 五层与因果链"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h03_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h03_title" value="五层架构 + 木桶效应 + 六条致命因果链" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h03_sub" value="容量由最慢那层决定；故障最可怕的不是单点，而是六条链叠加成雪崩。" style="text;html=1;strokeColor=none;fil