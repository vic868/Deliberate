8" width="480" height="24" as="geometry"/></mxCell><mxCell id="h07_t67" value="只做全局 1000 QPS：一个恶意用户刷满，所有人被拒。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1024" y="548" width="480" height="40" as="geometry"/></mxCell><mxCell id="h07_p68" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1024" y="598" width="220" height="80" as="geometry"/></mxCell><mxCell id="h07_t69" value="全局 1000 QPS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1042" y="610" width="184" height="20" as="geometry"/></mxCell><mxCell id="h07_t70" value="恶意用户占满" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1042" y="636" width="184" height="30" as="geometry"/></mxCell><mxCell id="h07_p71" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1264" y="598" width="250" height="80" as="geometry"/></mxCell><mxCell id="h07_t72" value="用户级 10 QPS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="610" width="220" height="20" as="geometry"/></mxCell><mxCell id="h07_t73" value="恶意用户只能占 10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1282" y="636" width="220" height="30" as="geometry"/></mxCell><mxCell id="h07_t74" value="分级维度：接口级 → 用户级 → IP 级 → 全局级。&#10;先保护整体，再隔离个体；限流不是无脑拒绝，而是有策略的保护。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1024" y="700" width="480" height="90" as="geometry"/></mxCell><mxCell id="h07_p75" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h07_t76" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h07_t77" value="限流的目的不是“拒绝请求”，而是“保住系统”：让超出容量的部分快速失败，让系统留在可服务区间。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h08" name="08 熔断降级"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h08_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h08_title" value="熔断与降级：机制和策略，不是一回事" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h08_sub" value="熔断是开关，降级是预案；打开状态快速失败，半开状态少量试探。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="h08_num" value="08 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="h08_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="780" height="480" as="geometry"/></mxCell><mxCell id="h08_t2" value="熔断器三态：关闭 → 打开 → 半开" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="720" height="24" as="geometry"/></mxCell><mxCell id="h08_b3" value="① Closed&#10;关闭" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="180" height="110" as="geometry"/></mxCell><mxCell id="h08_b4" value="② Open&#10;打开" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="180" height="110" as="geometry"/></mxCell><mxCell id="h08_b5" value="③ Half-Open&#10;半开" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="315" y="470" width="180" height="110" as="geometry"/></mxCell><mxCell id="h08_t6" value="正常调用&#10;统计错误率" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="366" width="150" height="40" as="geometry"/></mxCell><mxCell id="h08_t7" value="快速失败&#10;不调用下游" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="366" width="120" height="40" as="geometry"/></mxCell><mxCell id="h08_t8" value="放少量请求&#10;试探恢复" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="333" y="586" width="150" height="40" as="geometry"/></mxCell><mxCell id="h08_a9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="305" as="sourcePoint"/><mxPoint x="520" y="305" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_t10" value="错误率 &gt; 阈值" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="140" height="20" as="geometry"/></mxCell><mxCell id="h08_o1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#DC2626;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="360" as="sourcePoint"/><mxPoint x="695" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_o2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#DC2626;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="440" as="sourcePoint"/><mxPoint x="405" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_a11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.3;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="440" as="sourcePoint"/><mxPoint x="405" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_t12" value="等待一段时间" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="705" y="400" width="110" height="20" as="geometry"/></mxCell><mxCell id="h08_c1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#059669;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="525" as="sourcePoint"/><mxPoint x="200" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_a13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.3;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="525" as="sourcePoint"/><mxPoint x="200" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_t14" value="试探成功 → 关闭" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="210" y="430" width="150" height="20" as="geometry"/></mxCell><mxCell id="h08_f1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D97706;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="525" as="sourcePoint"/><mxPoint x="640" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_a15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.3;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="525" as="sourcePoint"/><mxPoint x="640" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h08_t16" value="试探失败 → 继续打开" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="650" y="440" width="110" height="20" as="geometry"/></mxCell><mxCell id="h08_t17" value="打开状态的价值：快速失败不占线程；不是“少发请求”，而是“释放线程”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="606" width="720" height="20" as="geometry"/></mxCell><mxCell id="h08_p18" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="680" height="450" as="geometry"/></mxCell><mxCell id="h08_t19" value="降级：断开之后返回什么" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="168" width="620" height="24" as="geometry"/></mxCell><mxCell id="h08_t20" value="核心思想：有损服务——保住核心功能，牺牲边缘体验。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="206" width="620" height="20" as="geometry"/></mxCell><mxCell id="h08_p21" value="" style="rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="884" y="240" width="300" height="120" as="geometry"/></mxCell><mxCell id="h08_t22" value="读场景" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="252" width="120" height="20" as="geometry"/></mxCell><mxCell id="h08_t23" value="返回缓存 / 默认值&#10;返回简化版（前 10 条）&#10;热点兜底数据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="282" width="268" height="70" as="geometry"/></mxCell><mxCell id="h08_p24" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1204" y="240" width="300" height="120" as="geometry"/></mxCell><mxCell id="h08_t25" value="写场景" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1220" y="252" width="120" height="20" as="geometry"/></mxCell><mxCell id="h08_t26" value="异步化：写本地队列&#10;稍后同步&#10;或直接拒绝 + 提示" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1220" y="282" width="268" height="70" as="geometry"/></mxCell><mxCell id="h08_p27" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="884" y="386" width="620" height="70" as="geometry"/></mxCell><mxCell id="h08_t28" value="绝不能降级" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="398" width="590" height="20" as="geometry"/></mxCell><mxCell id="h08_t29" value="支付 / 扣款 / 库存扣减 / 订单创建——涉及资损的，必须拒绝并报错。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="424" width="590" height="24" as="geometry"/></mxCell><mxCell id="h08_t30" value="判断标准：降级后会不会产生资损或数据错误？&#10;会 → 不能降级；不会 → 可以降级。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="478" width="620" height="80" as="geometry"/></mxCell><mxCell id="h08_p31" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="1480" height="200" as="geometry"/></mxCell><mxCell id="h08_t32" value="最容易混：熔断 vs 降级" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="648" width="1400" height="24" as="geometry"/></mxCell><mxCell id="h08_t33" value="熔断 = 机制（保险丝）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="684" width="600" height="20" as="geometry"/></mxCell><mxCell id="h08_t34" value="检测到错误率 / 慢调用超阈值&#10;→ 断开调用，快速失败。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="712" width="600" height="60" as="geometry"/></mxCell><mxCell id="h08_t35" value="降级 = 策略（应急预案）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="684" width="600" height="20" as="geometry"/></mxCell><mxCell id="h08_t36" value="断开后返回什么：缓存、默认值、简化版、&#10;异步写、拒绝并提示。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="712" width="600" height="60" as="geometry"/></mxCell><mxCell id="h08_t37" value="关系：熔断触发降级；熔断是开关，降级是开关后面的预案。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="786" width="1360" height="20" as="geometry"/></mxCell><mxCell id="h08_p38" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h08_t39" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h08_t40" value="熔断不是“少发请求”，而是“快速失败、释放线程”；降级不是“降级一切”，涉及资损的核心链路必须拒绝。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h09" name="09 消息队列"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h09_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h09_title" value="消息队列：流量蓄水池，不是无限缓冲" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h09_sub" value="削峰、解耦、最终一致；但堆积会爆，必须监控 Lag、死信、幂等消费。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="h09_num" value="09 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="h09_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="1480" height="300" as="geometry"/></mxCell><mxCell id="h09_t2" value="MQ 是洪峰与处理能力之间的蓄水池" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="1400" height="24" as="geometry"/></mxCell><mxCell id="h09_b3" value="生产者&#10;拼命写" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="180" height="76" as="geometry"/></mxCell><mxCell id="h09_a4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="278" as="sourcePoint"/><mxPoint x="420" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_a5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="300" as="sourcePoint"/><mxPoint x="420" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_p6" value="" style="rounded=1;arcSize=14;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="420" y="220" width="360" height="126" as="geometry"/></mxCell><mxCell id="h09_t7" value="MQ 缓冲区" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="442" y="236" width="316" height="24" as="geometry"/></mxCell><mxCell id="h09_t8" value="消息按顺序堆积&#10;消费者按自己的能力拉取" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="442" y="266" width="316" height="60" as="geometry"/></mxCell><mxCell id="h09_b9" value="Lag 监控" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="306" width="130" height="28" as="geometry"/></mxCell><mxCell id="h09_a10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="278" as="sourcePoint"/><mxPoint x="900" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_b11" value="消费者&#10;按能力读" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="240" width="180" height="76" as="geometry"/></mxCell><mxCell id="h09_ax" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="350" as="sourcePoint"/><mxPoint x="1450" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_ay" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="350" as="sourcePoint"/><mxPoint x="1130" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_a12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="350" as="sourcePoint"/><mxPoint x="1160" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_a13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="350" as="sourcePoint"/><mxPoint x="1200" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_a14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="350" as="sourcePoint"/><mxPoint x="1240" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_a15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1290" y="350" as="sourcePoint"/><mxPoint x="1290" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_a16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="350" as="sourcePoint"/><mxPoint x="1340" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_a17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="350" as="sourcePoint"/><mxPoint x="1400" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_flat" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="300" as="sourcePoint"/><mxPoint x="1450" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h09_t18" value="洪峰" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1138" y="360" width="120" height="18" as="geometry"/></mxCell><mxCell id="h09_t19" value="平稳输出" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1320" y="282" width="120" height="18" as="geometry"/></mxCell><mxCell id="h09_t20" value="MQ 不是“无限缓冲”：它只是把瞬时压力变成持续压力；如果生产持续大于消费，堆积迟早会爆。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="380" width="1360" height="40" as="geometry"/></mxCell><mxCell id="h09_p21" value="" style="rounded=1;arcSize=14;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="460" height="160" as="geometry"/></mxCell><mxCell id="h09_t22" value="① 削峰填谷" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="486" width="410" height="24" as="geometry"/></mxCell><mxCell id="h09_t23" value="生产者先写进 MQ，消费者按能力读；&#10;峰值被摊平，下游不被瞬时打垮。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="520" width="410" height="80" as="geometry"/></mxCell><mxCell id="h09_p24" value="" style="rounded=1;arcSize=14;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="550" y="470" width="460" height="160" as="geometry"/></mxCell><mxCell id="h09_t25" value="② 异步解耦" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="486" width="410" height="24" as="geometry"/></mxCell><mxCell id="h09_t26" value="下单只写消息就返回；库存、物流异步处理；&#10;下游挂了，消息还在。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="520" width="410" height="80" as="geometry"/></mxCell><mxCell id="h09_p27" value="" style="rounded=1;arcSize=14;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="460" height="160" as="geometry"/></mxCell><mxCell id="h09_t28" value="③ 最终一致" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="486" width="410" height="24" as="geometry"/></mxCell><mxCell id="h09_t29" value="异步 + 补偿 / 事务消息；&#10;接受短暂不一致，换取吞吐与可用性。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1062" y="520" width="410" height="80" as="geometry"/></mxCell><mxCell id="h09_p30" value="" style="rounded=1;arcSize=14;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="1480" height="170" as="geometry"/></mxCell><mxCell id="h09_t31" value="MQ 三件套：缺一不可" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="666" width="300" height="22" as="geometry"/></mxCell><mxCell id="h09_t32" value="① 监控 Lag" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#F8FAFC;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="704" width="220" height="24" as="geometry"/></mxCell><mxCell id="h09_t33" value="堆积到磁盘满才发现 → 已经晚了" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#CBD5E1;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="734" width="400" height="24" as="geometry"/></mxCell><mxCell id="h09_t34" value="② 死信队列" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#F8FAFC;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="544" y="704" width="220" height="24" as="geometry"/></mxCell><mxCell id="h09_t35" value="坏消息无限重试 → 队列假死" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#CBD5E1;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="544" y="734" width="400" height="24" as="geometry"/></mxCell><mxCell id="h09_t36" value="③ 幂等消费" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#F8FAFC;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="704" width="220" height="24" as="geometry"/></mxCell><mxCell id="h09_t37" value="至少一次投递 → 重复扣款/发货" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#CBD5E1;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1004" y="734" width="400" height="24" as="geometry"/></mxCell><mxCell id="h09_p38" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h09_t39" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h09_t40" value="MQ 的价值是“缓冲 + 解耦 + 最终一致”，前提是 Lag 有人看、坏消息有 DLQ、消费端幂等。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h10" name="10 分布式锁"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h10_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h10_title" value="分布式锁：并发的交通警察" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h10_sub" value="SET NX EX + Lua 释放；TTL 兜底、看门狗续期、可重入；锁是最后手段，不是首选。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="h10_num" value="10 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="h10_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="780" height="650" as="geometry"/></mxCell><mxCell id="h10_t2" value="加锁与释放：一条命令 + 一段 Lua" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="720" height="24" as="geometry"/></mxCell><mxCell id="h10_b3" value="实例 1&#10;uuid-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.8;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="220" width="170" height="60" as="geometry"/></mxCell><mxCell id="h10_b4" value="SET lock:order uuid-1&#10;NX EX 30" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="260" height="60" as="geometry"/></mxCell><mxCell id="h10_a5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="250" as="sourcePoint"/><mxPoint x="330" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_b6" value="Redis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="160" height="60" as="geometry"/></mxCell><mxCell id="h10_a7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="250" as="sourcePoint"/><mxPoint x="650" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_t8" value="NX：不存在才设置；EX：自动过期防死锁；value 唯一：防误删别人的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="292" width="720" height="20" as="geometry"/></mxCell><mxCell id="h10_b9" value="业务执行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="170" height="54" as="geometry"/></mxCell><mxCell id="h10_a10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="280" as="sourcePoint"/><mxPoint x="175" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_b11" value="Lua：if get(key)==uuid-1 then del(key)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="300" height="54" as="geometry"/></mxCell><mxCell id="h10_a12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="357" as="sourcePoint"/><mxPoint x="330" y="357" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_t13" value="释放必须原子：先比对 value，再删除；否则可能删掉刚被实例 2 拿到的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="398" width="720" height="20" as="geometry"/></mxCell><mxCell id="h10_p14" value="" style="rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="420" width="720" height="54" as="geometry"/></mxCell><mxCell id="h10_t15" value="① 没设过期时间" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="428" width="130" height="20" as="geometry"/></mxCell><mxCell id="h10_t16" value="进程崩溃 → 死锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="428" width="240" height="20" as="geometry"/></mxCell><mxCell id="h10_t17" value="SET ... NX EX 一条命令原子完成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="450" width="520" height="18" as="geometry"/></mxCell><mxCell id="h10_p18" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="484" width="720" height="54" as="geometry"/></mxCell><mxCell id="h10_t19" value="② 过期时间不合理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="492" width="130" height="20" as="geometry"/></mxCell><mxCell id="h10_t20" value="太短提前丢锁；太长恢复慢" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="492" width="240" height="20" as="geometry"/></mxCell><mxCell id="h10_t21" value="按业务耗时评估，配合看门狗" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="514" width="520" height="18" as="geometry"/></mxCell><mxCell id="h10_p22" value="" style="rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="548" width="720" height="54" as="geometry"/></mxCell><mxCell id="h10_t23" value="③ 业务 &gt; 锁过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="556" width="130" height="20" as="geometry"/></mxCell><mxCell id="h10_t24" value="锁被释放 → 并发进入" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="556" width="240" height="20" as="geometry"/></mxCell><mxCell id="h10_t25" value="看门狗自动续期（TTL/3）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="578" width="520" height="18" as="geometry"/></mxCell><mxCell id="h10_p26" value="" style="rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="612" width="720" height="54" as="geometry"/></mxCell><mxCell id="h10_t27" value="④ 释放不校验归属" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="620" width="130" height="20" as="geometry"/></mxCell><mxCell id="h10_t28" value="删掉别人的锁 → 双持有" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="620" width="240" height="20" as="geometry"/></mxCell><mxCell id="h10_t29" value="Lua 原子校验 value 后删除" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="240" y="642" width="520" height="18" as="geometry"/></mxCell><mxCell id="h10_t30" value="面试点：锁过期但业务没执行完，是最危险的并发窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="690" width="720" height="22" as="geometry"/></mxCell><mxCell id="h10_p31" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="680" height="650" as="geometry"/></mxCell><mxCell id="h10_t32" value="三件套：TTL 兜底 + 看门狗续期 + 可重入" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="168" width="620" height="24" as="geometry"/></mxCell><mxCell id="h10_t33" value="看门狗：业务活着，锁就续期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="204" width="620" height="20" as="geometry"/></mxCell><mxCell id="h10_wl" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="260" as="sourcePoint"/><mxPoint x="1480" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_b34" value="TTL 30s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="232" width="120" height="56" as="geometry"/></mxCell><mxCell id="h10_b35" value="续期" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="232" width="120" height="56" as="geometry"/></mxCell><mxCell id="h10_b36" value="续期" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1220" y="232" width="120" height="56" as="geometry"/></mxCell><mxCell id="h10_b37" value="释放" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="232" width="100" height="56" as="geometry"/></mxCell><mxCell id="h10_a38" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="260" as="sourcePoint"/><mxPoint x="1060" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_a39" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="260" as="sourcePoint"/><mxPoint x="1220" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_a40" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="260" as="sourcePoint"/><mxPoint x="1380" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h10_t41" value="默认 TTL 30s，每 10s 续期；显式传 leaseTime 时看门狗不启动。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="300" width="620" height="20" as="geometry"/></mxCell><mxCell id="h10_p42" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="884" y="340" width="620" height="110" as="geometry"/></mxCell><mxCell id="h10_t43" value="可重入：同一线程再次加锁 → count + 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="352" width="580" height="20" as="geometry"/></mxCell><mxCell id="h10_t44" value="Hash 结构：key = 锁名，field = 线程标识，value = 重入次数。&#10;释放一次 count-1；归零才真正删除。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="380" width="580" height="60" as="geometry"/></mxCell><mxCell id="h10_p45" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="884" y="470" width="620" height="140" as="geometry"/></mxCell><mxCell id="h10_t46" value="TTL 是最后的兜底" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="482" width="580" height="20" as="geometry"/></mxCell><mxCell id="h10_t47" value="进程崩溃、看门狗也停了 → TTL 到期，锁最终释放。&#10;没有 TTL，服务挂了锁永不释放，业务永久阻塞。&#10;三者分工：TTL 兜底、看门狗保正常、可重入保易用。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="902" y="510" width="580" height="90" as="geometry"/></mxCell><mxCell id="h10_t48" value="单 Redis + Lua 够用；RedLock 提升容错但有争议；强一致/公平排队考虑 ZK / etcd。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="624" width="620" height="20" as="geometry"/></mxCell><mxCell id="h10_p49" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="h10_t50" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="h10_t51" value="锁的三件套是“TTL 兜底 + 看门狗续期 + 可重入”；能用幂等 / 唯一约束解决的，不要优先引入分布式锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="h11" name="11 Checklist"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h11_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="h11_title" value="上线 Checklist：九层 + 三大误区" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="h11_sub" value="高并发事故 80% 是“知道但忘了做”；上线前对着九层清单过一遍，至少不犯低级错误。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="h11_num" value="11 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry 