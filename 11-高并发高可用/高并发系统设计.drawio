            <mxPoint x="650" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_t8" value="NX：不存在才设置；EX：自动过期防死锁；value 唯一：防误删别人的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="292" width="720" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_b9" value="业务执行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="170" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h10_a10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="175" y="280" as="sourcePoint" />
            <mxPoint x="175" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_b11" value="Lua：if get(key)==uuid-1 then del(key)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="300" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h10_a12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="357" as="sourcePoint" />
            <mxPoint x="330" y="357" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_t13" value="释放必须原子：先比对 value，再删除；否则可能删掉刚被实例 2 拿到的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="398" width="720" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_p14" value="" style="rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="420" width="720" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h10_t15" value="① 没设过期时间" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="428" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t16" value="进程崩溃 → 死锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="428" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t17" value="SET ... NX EX 一条命令原子完成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="450" width="520" height="18" as="geometry" />
        </mxCell>
        <mxCell id="h10_p18" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="484" width="720" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h10_t19" value="② 过期时间不合理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="492" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t20" value="太短提前丢锁；太长恢复慢" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="492" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t21" value="按业务耗时评估，配合看门狗" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="514" width="520" height="18" as="geometry" />
        </mxCell>
        <mxCell id="h10_p22" value="" style="rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="548" width="720" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h10_t23" value="③ 业务 &gt; 锁过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="556" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t24" value="锁被释放 → 并发进入" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="556" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t25" value="看门狗自动续期（TTL/3）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="578" width="520" height="18" as="geometry" />
        </mxCell>
        <mxCell id="h10_p26" value="" style="rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="612" width="720" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h10_t27" value="④ 释放不校验归属" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t28" value="删掉别人的锁 → 双持有" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="620" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t29" value="Lua 原子校验 value 后删除" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="642" width="520" height="18" as="geometry" />
        </mxCell>
        <mxCell id="h10_t30" value="面试点：锁过期但业务没执行完，是最危险的并发窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="690" width="720" height="22" as="geometry" />
        </mxCell>
        <mxCell id="h10_p31" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="150" width="680" height="650" as="geometry" />
        </mxCell>
        <mxCell id="h10_t32" value="三件套：TTL 兜底 + 看门狗续期 + 可重入" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="884" y="168" width="620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h10_t33" value="看门狗：业务活着，锁就续期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="884" y="204" width="620" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_wl" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="260" as="sourcePoint" />
            <mxPoint x="1480" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_b34" value="TTL 30s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="232" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h10_b35" value="续期" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="232" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h10_b36" value="续期" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="232" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h10_b37" value="释放" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1380" y="232" width="100" height="56" as="geometry" />
        </mxCell>
        <mxCell id="h10_a38" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="260" as="sourcePoint" />
            <mxPoint x="1060" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_a39" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180" y="260" as="sourcePoint" />
            <mxPoint x="1220" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_a40" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1340" y="260" as="sourcePoint" />
            <mxPoint x="1380" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h10_t41" value="默认 TTL 30s，每 10s 续期；显式传 leaseTime 时看门狗不启动。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="884" y="300" width="620" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_p42" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="884" y="340" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h10_t43" value="可重入：同一线程再次加锁 → count + 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="902" y="352" width="580" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t44" value="Hash 结构：key = 锁名，field = 线程标识，value = 重入次数。&#xa;释放一次 count-1；归零才真正删除。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="902" y="380" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h10_p45" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="884" y="470" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="h10_t46" value="TTL 是最后的兜底" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="902" y="482" width="580" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_t47" value="进程崩溃、看门狗也停了 → TTL 到期，锁最终释放。&#xa;没有 TTL，服务挂了锁永不释放，业务永久阻塞。&#xa;三者分工：TTL 兜底、看门狗保正常、可重入保易用。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="902" y="510" width="580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h10_t48" value="单 Redis + Lua 够用；RedLock 提升容错但有争议；强一致/公平排队考虑 ZK / etcd。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="884" y="624" width="620" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h10_p49" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="h10_t50" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h10_t51" value="锁的三件套是“TTL 兜底 + 看门狗续期 + 可重入”；能用幂等 / 唯一约束解决的，不要优先引入分布式锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
