        <mxCell id="h10_b3" value="实例 1&#xa;uuid-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.8;fontColor=#1D4ED8;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="220" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h10_b4" value="SET lock:order uuid-1&#xa;NX EX 30" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="220" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h10_a5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
