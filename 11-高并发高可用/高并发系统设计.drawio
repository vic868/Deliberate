        <mxCell id="h07_t59" value="恒定输出" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="680" y="634" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_row634" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#F1F5F9;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="84" y="658" as="sourcePoint" />
            <mxPoint x="860" y="658" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h07_t60" value="令牌桶" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="664" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_t61" value="好" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="664" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_t62" value="允许" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="664" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_t63" value="中等" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="664" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_t64" value="生产最常用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="680" y="664" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_row664" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#F1F5F9;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="84" y="688" as="sourcePoint" />
            <mxPoint x="860" y="688" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h07_p65" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="490" width="540" height="330" as="geometry" />
        </mxCell>
        <mxCell id="h07_t66" value="限流要分级：把伤害限制在局部" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1024" y="508" width="480" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h07_t67" value="只做全局 1000 QPS：一个恶意用户刷满，所有人被拒。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1024" y="548" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h07_p68" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1024" y="598" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h07_t69" value="全局 1000 QPS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1042" y="610" width="184" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_t70" value="恶意用户占满" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1042" y="636" width="184" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h07_p71" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1264" y="598" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h07_t72" value="用户级 10 QPS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1282" y="610" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="h07_t73" value="恶意用户只能占 10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1282" y="636" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h07_t74" value="分级维度：接口级 → 用户级 → IP 级 → 全局级。&#xa;先保护整体，再隔离个体；限流不是无脑拒绝，而是有策略的保护。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1024" y="700" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h07_p75" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="h07_t76" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h07_t77" value="限流的目的不是“拒绝请求”，而是“保住系统”：让超出容量的部分快速失败，让系统留在可服务区间。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="h08" name="08 熔断降级">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
