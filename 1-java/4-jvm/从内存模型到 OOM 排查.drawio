        <mxCell id="AUvF3KoyZVTuGkdwbndg-18" parent="1" style="text;whiteSpace=wrap;html=1;fontStyle=0" value="&lt;span style=&quot;color: rgb(0, 0, 0); background: none left top / auto no-repeat scroll padding-box border-box rgba(0, 0, 0, 0); width: auto; height: auto; margin: 0px; padding: 0px; border-style: none; border-width: 3px; border-color: rgba(0, 0, 0, 0.4); border-radius: 0px; visibility: visible;&quot;&gt;&lt;span style=&quot;visibility: visible;&quot;&gt;凡是跟着线程走的，都是私有的；&lt;/span&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background: none left top / auto no-repeat scroll padding-box border-box rgba(0, 0, 0, 0); width: auto; height: auto; margin: 0px; padding: 0px; border-style: none; border-width: 3px; border-color: rgba(0, 0, 0, 0.4); border-radius: 0px; visibility: visible;&quot;&gt;&lt;span style=&quot;visibility: visible;&quot;&gt;凡是类信息和对象实例，都是共享的&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;visibility: visible;&quot;&gt;。&lt;/span&gt;&lt;/div&gt;" vertex="1">
