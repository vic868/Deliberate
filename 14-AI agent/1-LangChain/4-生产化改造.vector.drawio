            <mxRectangle width="740" height="26" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c73" value="&lt;b&gt;SSE 事件设计&lt;/b&gt;（给前端约定）：{type: token|node|tool|interrupt|error|done, data: {...}}；token 追加到气泡，node 显示「检索中 / 生成中」，done 时回填引用与耗时统计。" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
