          </mxGeometry>
        </mxCell>
        <mxCell id="c43" value="from langgraph.checkpoint.postgres import PostgresSaver&lt;br&gt;with PostgresSaver.from_conn_string(DSN) as cp:&lt;br&gt;    cp.setup()            # 首次建表&lt;br&gt;    graph = builder.compile(checkpointer=cp)&lt;br&gt;# 异步服务用 AsyncPostgresSaver + async with" style="rounded=1;fillColor=#fbfbf9;strokeColor=#1f3864;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="296" width="400" height="96" as="geometry">
            <mxRectangle width="400" height="96" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;改造清单&lt;/b&gt;&lt;br&gt;• 启动时初始化 checkpointer 一次，别每个请求 new&lt;br&gt;• thread_id 用「用户 + 会话」规则生成，前端传回&lt;br&gt;• thread 的标题/时间另存业务表，列表页别扫 checkpoint 表&lt;br&gt;• 敏感会话可配 EncryptedSerializer（LANGGRAPH_AES_KEY）" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="294" width="410" height="98" as="geometry">
            <mxRectangle width="410" height="98" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c45" value="&lt;b&gt;异步写法（FastAPI 必须）&lt;/b&gt;：AsyncPostgresSaver + async with … await cp.setup()；graph.ainvoke / astream 全链路 async，别在事件循环里调同步 LLM 客户端。" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="400" height="46" as="geometry">
            <mxRectangle width="400" height="46" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;长期记忆&lt;/b&gt;：跨会话的 Store（InMemoryStore → PostgresStore / 向量 Store）；checkpointer 管单次对话，Store 管跨对话的用户偏好与事实。" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="440" y="400" width="410" height="46" as="geometry">
            <mxRectangle width="410" height="46" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c47" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9aa6b2;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="128" width="620" height="300" as="geometry">
            <mxRectangle width="620" height="300" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c48" value="②  Milvus：Lite → Docker Standalone（为了 BM25 / 多租户 / 性能）" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="900" y="128" width="620" height="28" as="geometry">
            <mxRectangle width="620" height="28" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c49" value="&lt;b&gt;Milvus Lite&lt;/b&gt;&lt;br&gt;pip 安装、一个 .db 文件&lt;br&gt;只有 FLAT 索引" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="910" y="164" width="260" height="56" as="geometry">
            <mxRectangle width="260" height="56" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c50" value="&lt;b&gt;Standalone (Docker)&lt;/b&gt;&lt;br&gt;完整能力：HNSW/IVF、BM25 全文、partition&lt;br&gt;URL http://localhost:19530" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="164" width="290" height="56" as="geometry">
            <mxRectangle width="290" height="56" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c51" value="升级" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;strokeWidth=1.4;fontSize=9;fontColor=#b85450;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c50">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c52" value="curl -sfL https://raw.githubusercontent.com/milvus-io/milvus/master/&lt;br&gt;  scripts/standalone_embed.sh -o standalone_embed.sh&lt;br&gt;bash standalone_embed.sh start&lt;br&gt;# WebUI: http://127.0.0.1:9091/webui" style="rounded=1;fillColor=#fbfbf9;strokeColor=#1f3864;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="910" y="234" width="590" height="64" as="geometry">
            <mxRectangle width="590" height="64" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c53" value="&lt;b&gt;踩坑&lt;/b&gt;：&lt;br&gt;• Lite 不支持 BM25 内置函数、partition_key → 混检/多租户必须上 Standalone&lt;br&gt;• 已有 Lite 数据要迁移：重新 ingest 最快（第 2 页建库脚本可复用）&lt;br&gt;• 索引与 metric 建好后改需重建 collection" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="910" y="306" width="590" height="76" as="geometry">
            <mxRectangle width="590" height="76" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c54" value="Milvus 3.0（湖原生）：External Collection 直接检索数据湖、在线增删字段、服务端 ORDER BY / 聚合、BM25 索引体积约为 2.6 的 1/3 —— 个人项目先不用追新，但要知道方向。" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="910" y="388" width="590" height="46" as="geometry">
            <mxRectangle width="590" height="46" as="alternateBounds"/>
