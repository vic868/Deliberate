        <mxCell id="c42" value="✓" style="rounded=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
