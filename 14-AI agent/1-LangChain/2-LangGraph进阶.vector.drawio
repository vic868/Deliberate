          </mxGeometry>
        </mxCell>
        <mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;strokeWidth=1.4;fontSize=9;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c70" target="c72">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c74" value="&lt;b&gt;三个动作别混&lt;/b&gt;：Replay = invoke 旧 checkpoint 的 config 重跑之后的节点（会重新调 LLM，不是读缓存）；Fork = update_state 在旧 checkpoint 上新建分支；恢复中断 = Command(resume=…)。&lt;br&gt;&lt;b&gt;与「重试」的区别&lt;/b&gt;：重试 = 同一输入再跑一次（要幂等）；update_state = 改输入再跑；Replay = 换起点重跑。&lt;br&gt;状态查询：graph.get_state(config) 看 next / tasks / 中断；get_state_history 按 metadata.step 找快照。" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1023" width="1480" height="66" as="geometry">
            <mxRectangle width="1480" height="66" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c75" value="练习：故意让一个工具抛异常 → graph.get_state 看到失败节点 → update_state 修正参数 → invoke(None) 从失败处继续，并在 get_state_history 里找到 source=update 的新快照。" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="1093" width="1480" height="24" as="geometry">
            <mxRectangle width="1480" height="24" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
