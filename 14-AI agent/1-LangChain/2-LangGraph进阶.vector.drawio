        <mxCell id="c56" value="不通过 → 回退分派" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;strokeWidth=1.4;fontSize=9;fontColor=#b85450;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c47">
