          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c72" value="invoke(None) 继续" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="910" y="959" width="166" height="52" as="geometry">
