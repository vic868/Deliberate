        </mxCell>
        <mxCell id="c62" value="④  State 中断恢复：出错后手动修 state 再继续（Replay / Fork / update_state）" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
