        <mxCell id="c20" value="阶段一已完成：LangChain 基础(模型/Prompt/记忆) · 工具调用(bind_tools/tool_calls) · LangGraph 核心(State/Node/Edge/ConditionalEdge/MemorySaver) · FastAPI+SSE · RAG+Milvus，本页为其后的进阶准备" style="rounded=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#333333;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;" vertex="1" parent="1">
