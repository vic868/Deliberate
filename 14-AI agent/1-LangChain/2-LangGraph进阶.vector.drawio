          </mxGeometry>
        </mxCell>
        <mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1f3864;strokeWidth=1.4;fontSize=9;fontColor=#1f3864;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c28">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c30" value="执行工具 / 继续" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1034" y="164" width="196" height="62" as="geometry">
            <mxRectangle width="196" height="62" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1f3864;strokeWidth=1.4;fontSize=9;fontColor=#1f3864;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c30">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c32" value="关键：必须同一个 thread_id；节点内 interrupt() 之前的代码在恢复后会重跑，所以前面的逻辑要可重复执行（幂等）。静态断点 = 在节点前后暂停；动态中断 = 代码里任意位置、可带条件。" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="236" width="1480" height="34" as="geometry">
            <mxRectangle width="1480" height="34" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c33" value="&lt;b&gt;暂停/恢复最小代码&lt;/b&gt;&lt;br&gt;val = interrupt({&quot;question&quot;: &quot;approve?&quot;})&lt;br&gt;graph.invoke(Command(resume=True), config)&lt;br&gt;# 同一个 thread_id 才能续上" style="rounded=1;fillColor=#fbfbf9;strokeColor=#d6b656;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="278" width="211.0" height="120" as="geometry">
            <mxRectangle width="211.0" height="120" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;改 state 再继续&lt;/b&gt;&lt;br&gt;graph.update_state(cfg, {&quot;draft&quot;: 新值},&lt;br&gt;                   as_node=&quot;上一节点名&quot;)&lt;br&gt;graph.invoke(None, cfg)" style="rounded=1;fillColor=#fbfbf9;strokeColor=#d6b656;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="253.0" y="278" width="211.0" height="120" as="geometry">
            <mxRectangle width="211.0" height="120" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c35" value="&lt;b&gt;补参数 / 校验输入&lt;/b&gt;&lt;br&gt;interrupt(payload, response_schema=Decision)&lt;br&gt;resume 值不合 schema 会抛 ValidationError&lt;br&gt;再用同一 thread_id 重试" style="rounded=1;fillColor=#fbfbf9;strokeColor=#d6b656;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="476.0" y="278" width="211.0" height="120" as="geometry">
            <mxRectangle width="211.0" height="120" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;改 state ≠ 回滚&lt;/b&gt;&lt;br&gt;update_state 是「分叉」：新建 checkpoint，&lt;br&gt;原历史保留；get_state_history 里&lt;br&gt;metadata.source == &#x27;update&#x27;" style="rounded=1;fillColor=#fbfbf9;strokeColor=#d6b656;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="699.0" y="278" width="211.0" height="120" as="geometry">
            <mxRectangle width="211.0" height="120" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c37" value="&lt;b&gt;易错点&lt;/b&gt;&lt;br&gt;• 忘了 checkpointer 或 thread_id → 恢复报错 / 起新线程&lt;br&gt;• 恢复后又调用 resume 一次 → 重复执行&lt;br&gt;• 在 interrupt() 前面做写库等副作用 → 重跑会重复写" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="910" y="278" width="500" height="120" as="geometry">
            <mxRectangle width="500" height="120" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c38" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9aa6b2;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="440" width="1500" height="210" as="geometry">
            <mxRectangle width="1500" height="210" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c39" value="②  Subgraph 子图：一个大 Agent 里嵌一个小 Agent" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="20" y="440" width="1500" height="28" as="geometry">
            <mxRectangle width="1500" height="28" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;父图&lt;/b&gt;&lt;br&gt;research_node → write_node → review_node" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="486" width="300" height="66" as="geometry">
            <mxRectangle width="300" height="66" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;子图 = 编译后的 graph&lt;/b&gt;&lt;br&gt;可 add_node(&quot;sub&quot;, compiled_graph)&lt;br&gt;state 自动按 schema 映射" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="486" width="360" height="66" as="geometry">
            <mxRectangle width="360" height="66" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c42" value="作为节点塞进去" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1f3864;strokeWidth=1.4;fontSize=9;fontColor=#1f3864;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c40" target="c41">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c43" value="&lt;b&gt;两种嵌法&lt;/b&gt;&lt;br&gt;1) 当节点：state schema 相同或做转换，内部节点不外露&lt;br&gt;2) 嵌套：子图也有自己的 checkpointer 时，父子 checkpoint 各自独立&lt;br&gt;注意：只暴露父图需要的字段，别让子图污染顶层 state" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="880" y="484" width="610" height="70" as="geometry">
            <mxRectangle width="610" height="70" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;自检&lt;/b&gt;：父图 get_state_history 能看到子图调用；子图内部出错时父图 state 不半写；同一份 state 用 graph.stream(subgraphs=True) 能看到层级（配合第 4 页）" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="568" width="800" height="56" as="geometry">
            <mxRectangle width="800" height="56" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c45" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9aa6b2;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="670" width="1500" height="230" as="geometry">
            <mxRectangle width="1500" height="230" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c46" value="③  Multi-Agent 协作流水线：Researcher → Coder → Reviewer" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
