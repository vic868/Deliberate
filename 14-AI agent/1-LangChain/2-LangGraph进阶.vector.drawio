        <mxCell id="c57" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#82b366;strokeWidth=1.4;fontSize=9;fontColor=#82b366;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c51">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c58" value="&lt;b&gt;两种主流结构&lt;/b&gt;：Supervisor（中央调度，易调试、多一跳） vs Swarm（Agent 之间直接交接，省一跳、难追踪）。有多个 Agent 后先用 LangSmith 看 trace 树，再优化：谁重复调用了、哪一步最慢、哪个 Agent 输出被下游忽略。" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="858" width="1100" height="64" as="geometry">
            <mxRectangle width="1100" height="64" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c59" value="&lt;b&gt;状态设计&lt;/b&gt;&lt;br&gt;messages（共享对话）&lt;br&gt;plan / todo（任务清单）&lt;br&gt;artifacts（各 Agent 产出）&lt;br&gt;review（评审意见）&lt;br&gt;next_agent（下一步派给谁）" style="rounded=1;fillColor=#fbfbf9;strokeColor=#82b366;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="700" width="340" height="112" as="geometry">
            <mxRectangle width="340" height="112" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c60" value="&lt;b&gt;交接与容错&lt;/b&gt;&lt;br&gt;• 每个 Agent 限制最大轮数，防止互踢皮球&lt;br&gt;• Reviewer 明确「不通过要给出修改清单」&lt;br&gt;• 一个 Agent 的产物写入独立字段，避免互相覆盖&lt;br&gt;• 线上用 HITL 在关键交接点人工确认" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="810" width="340" height="84" as="geometry">
