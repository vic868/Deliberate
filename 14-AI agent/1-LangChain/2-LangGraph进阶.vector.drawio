        </mxCell>
        <mxCell id="c24" value="interrupt(payload)&#10;暂停并落 checkpoint" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="281" y="164" width="196" height="62" as="geometry">
