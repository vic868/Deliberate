        <mxCell id="c64" value="from langsmith import Client&lt;br&gt;client = Client()&lt;br&gt;results = client.evaluate(&lt;br&gt;    lambda inputs: {&quot;answer&quot;: rag(answer=my_rag(inputs[&quot;q&quot;]))},&lt;br&gt;    data=&quot;my-rag-golden-v1&quot;,   # 数据集名&lt;br&gt;    evaluators=[hit_at_5, citation_ok, llm_judge],&lt;br&gt;    experiment_prefix=&quot;v2-bge-m3+rerank&quot;)" style="rounded=1;fillColor=#fbfbf9;strokeColor=#1f3864;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="750" y="542" width="400" height="92" as="geometry">
            <mxRectangle width="400" height="92" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c65" value="&lt;b&gt;指标分层&lt;/b&gt;&lt;br&gt;检索层：Hit@5 / Recall@20 / MRR（不需要 LLM，便宜稳定）&lt;br&gt;生成层：正确性 / 忠实度（是否只依据资料）/ 引用是否支持结论&lt;br&gt;体验层：延迟 p95、Token 成本、用户点赞率" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1170" y="542" width="340" height="92" as="geometry">
            <mxRectangle width="340" height="92" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c66" value="&lt;b&gt;经验值&lt;/b&gt;：检索 20 条 → 精排 5 条喂给模型；如果 Hit@5 已经 90%+，再堆 rerank 收益很小，该去改切分或 embedder 了。先用小样本（30 条）跑通闭环，再扩到 100+。" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
