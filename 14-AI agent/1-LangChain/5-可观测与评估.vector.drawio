          </mxGeometry>
        </mxCell>
        <mxCell id="c67" value="DoD：同一个 query 集上，任意改动（切分/embedder/rerank/prompt）都能用一条命令跑出对比报告，并把「坏 case」沉淀进数据集。" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
