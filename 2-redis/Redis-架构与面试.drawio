        <mxCell id="r07_t30" value="volatile-lfu" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="858" y="372" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_t31" value="仅过期 key，最少使用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="858" y="391" width="286" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_p32" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1174" y="364" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r07_t33" value="volatile-ttl" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="372" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_t34" value="仅过期 key，TTL 最小" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="391" width="286" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_p35" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="844" y="426" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r07_t36" value="volatile-random" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#64748B;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="858" y="434" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_t37" value="仅过期 key，随机" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="858" y="453" width="286" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_p38" value="" style="rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1174" y="426" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r07_t39" value="noeviction" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="434" width="150" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_t40" value="不淘汰，满了拒写 ⚠️" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="453" width="286" height="18" as="geometry" />
        </mxCell>
        <mxCell id="r07_t41" value="缓存首选 allkeys-lru；冷热分明用 allkeys-lfu。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="506" width="660" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r07_p42" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="1480" height="260" as="geometry" />
        </mxCell>
        <mxCell id="r07_t43" value="LRU vs LFU：一个看时间，一个看次数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="608" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r07_p44" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="650" width="640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r07_t45" value="LRU（Least Recently Used）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="116" y="662" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r07_t46" value="淘汰“最久没被访问”的 key。&#xa;Redis 不是精确 LRU：随机采样 maxmemory-samples（默认 5）个 key，&#xa;挑最久未用的淘汰——用概率换内存与 CPU。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="116" y="690" width="600" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r07_p47" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="650" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r07_t48" value="LFU（Least Frequently Used）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="662" width="680" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r07_t49" value="淘汰“访问次数最少”的 key，适合有明显冷热区分的场景。&#xa;新 key 不会因为“刚访问一次”就把老热点挤掉；&#xa;代价是统计频率需要额外空间。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="690" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r07_p50" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r07_t51" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r07_t52" value="过期是“清理已经没用的”，淘汰是“内存满了必须丢一些”；两者都不负责业务正确性。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
