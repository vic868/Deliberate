          </mxGeometry>
        </mxCell>
        <mxCell id="r10_b39" value="延迟双删 / Canal 兜底" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="628" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r10_t40" value="为什么删除而不是更新？并发写时“更新缓存”可能被旧值覆盖；&#xa;删除更简单，下一次读自然回填。&#xa;延迟双删应对主从延迟；Canal 订阅 binlog 异步删更可靠。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="684" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r10_p41" value="" style="rounded=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="476" width="700" height="330" as="geometry" />
        </mxCell>
        <mxCell id="r10_t42" value="并发下会发生什么？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="838" y="490" width="660" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r10_t43" value="① 先删缓存、再更新 DB：&#xa;   删完后、DB 更新前，另一个读请求把旧值回填 → 脏数据。&#xa;② 先更新 DB、再删缓存：&#xa;   理论上仍有极小窗口，但概率最低，工程默认选它。&#xa;③ 缓存删除失败：重试 + binlog 补偿 + TTL 兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="838" y="520" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r10_t44" value="结论：接受最终一致，不要追求强一致。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="838" y="650" width="660" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r10_t45" value="最终一致不是“立刻正确”：删除缓存后仍可能读到旧值；&#xa;靠 TTL、删除重试、binlog 补偿慢慢收敛。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="756" width="680" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r10_t46" value="读多写少用 Cache Aside；写多可用 Write Behind，但要接受丢数据风险。&#xa;强一致场景：先落库，缓存只做加速，关键读穿透到 DB。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="838" y="680" width="660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r10_p47" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r10_t48" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r10_t49" value="穿透挡“不存在”，击穿挡“热点重建”，雪崩挡“同时失效”；一致性靠删除缓存 + 最终一致 + TTL 兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="r11" name="11 分布式锁">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r11_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="42" width="7" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r11_title" value="分布式锁：SET NX PX 只是起点，不是全部" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="36" width="1180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r11_sub" value="唯一 value + 过期时间 + Lua 释放；业务超时要续期；主从切换可能丢锁，RedLock 有争议。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="82" width="1330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r11_num" value="11 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1370" y="44" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r11_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="118" as="sourcePoint" />
            <mxPoint x="1540" y="118" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r11_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="760" height="690" as="geometry" />
        </mxCell>
        <mxCell id="r11_t2" value="加锁与释放：一条命令 + 一段 Lua" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="168" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r11_b3" value="Client 1&#xa;uuid-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="220" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r11_b4" value="SET lock:order uuid-1&#xa;NX PX 30000" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.8;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="220" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r11_a5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="250" as="sourcePoint" />
            <mxPoint x="330" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r11_b6" value="Redis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r11_a7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="250" as="sourcePoint" />
            <mxPoint x="640" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r11_t8" value="NX：不存在才设置；PX：自动过期防死锁；value 唯一：防误删别人的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="292" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_b9" value="业务执行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="170" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r11_a10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="175" y="280" as="sourcePoint" />
            <mxPoint x="175" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r11_b11" value="Lua：if get(key)==uuid-1 then del(key)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.2;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="300" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r11_a12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="357" as="sourcePoint" />
            <mxPoint x="330" y="357" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r11_t13" value="释放必须原子：先比对 value，再删除；否则可能删掉刚被 B 拿到的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="398" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_p14" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="440" width="690" height="74" as="geometry" />
        </mxCell>
        <mxCell id="r11_t15" value="没设过期时间" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t16" value="客户端崩溃 → 死锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="450" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t17" value="SET ... NX PX 一条命令原子完成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="474" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_p18" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="524" width="690" height="74" as="geometry" />
        </mxCell>
        <mxCell id="r11_t19" value="业务 &gt; 锁过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="534" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t20" value="锁提前释放 → 超卖" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="534" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t21" value="Redisson 看门狗：默认 30s，每 10s 续期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="558" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_p22" value="" style="rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="84" y="608" width="690" height="74" as="geometry" />
        </mxCell>
        <mxCell id="r11_t23" value="主库宕机丢锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="618" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t24" value="锁未同步到从库 → 双持有" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="618" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t25" value="RedLock 多节点多数派；或业务幂等兜底" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="642" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t26" value="RedLock 争议：提升安全性但依赖各节点时钟与 GC 停顿；&#xa;能接受幂等时，优先“唯一值 + Lua + 看门狗”，强一致要求高时考虑 ZooKeeper / etcd。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.3;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="700" width="690" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r11_p27" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="150" width="700" height="690" as="geometry" />
        </mxCell>
        <mxCell id="r11_t28" value="Pipeline / 事务 / Lua / Pub-Sub" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="864" y="168" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r11_p29" value="" style="rounded=1;arcSize=10;fillColor=#ECFEFF;strokeColor=#A5F3FC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="864" y="208" width="650" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r11_t30" value="Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="218" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t31" value="减少 RTT；不是原子，中间可被插队" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="218" width="450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r11_p32" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="864" y="290" width="650" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r11_t33" value="MULTI / EXEC" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="300" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t34" value="命令入队后连续执行；不支持回滚（弱事务）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="300" width="450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r11_p35" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="864" y="372" width="650" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r11_t36" value="Lua" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="382" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t37" value="原子执行 + 条件逻辑；分布式锁释放的标准做法" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="382" width="450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r11_t38" value="Pub/Sub vs Stream" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="864" y="462" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_p39" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="864" y="490" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r11_t40" value="Pub/Sub：推送，消息不持久，离线即丢" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="502" width="620" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t41" value="适合实时通知、聊天广播；不能当可靠队列。&#xa;没有 ACK，没有消费者组，Redis 重启消息全没。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="528" width="620" height="68" as="geometry" />
        </mxCell>
        <mxCell id="r11_p42" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="864" y="626" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r11_t43" value="Stream：拉取，持久化，消费者组 + ACK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="638" width="620" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r11_t44" value="适合可靠消息队列；支持 XREADGROUP、PENDING、消息回溯。&#xa;比 List 更适合“不能丢”的场景。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="664" width="620" height="68" as="geometry" />
        </mxCell>
        <mxCell id="r11_t45" value="面试点：Pipeline 不是原子；事务不回滚；Lua 才是“原子 + 条件”的常用解。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="864" y="770" width="650" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r11_p46" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r11_t47" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r11_t48" value="锁的三要素是“互斥、防死锁、防误删”；续期和主从切换是工程问题，不是一条 SET 命令能解决的。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="r12" name="12 面试速查">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r12_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="42" width="7" height="54" as="geometry" />
        </mxCell>
        <mxCell id="r12_title" value="面试速查：八个问题，一张图带走" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="36" width="1180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_sub" value="先给结论，再补机制，最后主动说边界；Redis 的题大多可以回到“内存 + 单线程 + 数据结构”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="82" width="1330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_num" value="12 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1370" y="44" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="118" as="sourcePoint" />
            <mxPoint x="1540" y="118" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r12_p1" value="" style="rounded=1;arcSize=14;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t2" value="Q1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="174" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t3" value="Redis 为什么快？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="128" y="172" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t4" value="纯内存 + 单线程免锁 + IO 多路复用；&#xa;6.0 网络 IO 多线程，命令执行仍单线程。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="212" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t5" value="边界：慢命令会阻塞所有人。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="266" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p6" value="" style="rounded=1;arcSize=14;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="160" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t7" value="Q2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="174" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t8" value="数据类型怎么选？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="868" y="172" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t9" value="String 缓存/计数；Hash 对象字段；List 队列；&#xa;Set 去重；ZSet 排序；特殊类型按场景。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="212" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t10" value="边界：大数据会切到通用编码。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="266" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p11" value="" style="rounded=1;arcSize=14;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t12" value="Q3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="334" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t13" value="RDB 和 AOF 怎么选？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="128" y="332" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t14" value="RDB 恢复快、可能丢一段；AOF everysec 最多丢 1s；&#xa;生产用混合持久化。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="372" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t15" value="边界：RDB 会丢窗口；AOF 重写有开销。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="426" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p16" value="" style="rounded=1;arcSize=14;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="320" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t17" value="Q4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="334" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t18" value="过期键怎么删？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="868" y="332" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t19" value="惰性 + 定期抽样；内存满了再按 maxmemory&#xa;策略淘汰；缓存首选 allkeys-lru。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="372" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t20" value="边界：LRU 是近似；noeviction 是拒写。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="426" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p21" value="" style="rounded=1;arcSize=14;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t22" value="Q5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="494" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t23" value="主从、哨兵、Cluster？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="128" y="492" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t24" value="主从给副本；哨兵给自动切换；Cluster 给分片。&#xa;异步复制决定切换有丢数据窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="532" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t25" value="边界：异步复制导致切换可能丢数据。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="586" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p26" value="" style="rounded=1;arcSize=14;fillColor=#ECFEFF;strokeColor=#A5F3FC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="480" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t27" value="Q6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="494" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t28" value="缓存三问题？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="868" y="492" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t29" value="穿透→布隆/空值；击穿→互斥/逻辑过期；&#xa;雪崩→随机 TTL + 高可用 + 降级。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="532" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t30" value="边界：布隆有误判；逻辑过期可能读旧值。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="586" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p31" value="" style="rounded=1;arcSize=14;fillColor=#FFF7ED;strokeColor=#FED7AA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t32" value="Q7" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#EA580C;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="654" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t33" value="缓存和 DB 一致性？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#EA580C;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="128" y="652" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t34" value="Cache Aside：更新 DB 后删缓存；&#xa;延迟双删 / Canal / TTL 兜底，接受最终一致。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="692" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t35" value="边界：删除后仍有短暂不一致窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="746" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p36" value="" style="rounded=1;arcSize=14;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="640" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r12_t37" value="Q8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="654" width="44" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_t38" value="分布式锁怎么写？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="868" y="652" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_t39" value="SET key uuid NX PX + Lua 释放；&#xa;超时续期；主从丢锁用 RedLock 或幂等兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="692" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t40" value="边界：主从切换可能丢锁，业务幂等兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="746" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r12_p41" value="" style="rounded=1;arcSize=10;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="806" width="1480" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t42" value="易错点：单线程≠整个服务器单线程；RDB 不是实时；LRU 是近似；noeviction 是拒写不是淘汰。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#F8FAFC;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="82" y="816" width="1440" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r12_p43" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r12_t44" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r12_t45" value="Redis 的答题主线：内存 → 单线程 → 数据结构 → 持久化 → 复制/分片 → 缓存治理。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="20tK1mfWK4Mak4eyCLYM" name="第 13 页">
    <mxGraphModel dx="1062" dy="851" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hm0ZugIW6zdflCOt5yMR-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" value="redis 数据一致性" vertex="1">
          <mxGeometry height="5029" width="4285" x="398" y="438" as="geometry" />
        </mxCell>
        <mxCell id="hm0ZugIW6zdflCOt5yMR-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="问题：&lt;div&gt;缓存与 DB 不一致&lt;/div&gt;&lt;div&gt;订单超卖 xxx单&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="390" y="764" as="geometry" />
        </mxCell>
        <mxCell id="hm0ZugIW6zdflCOt5yMR-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;" value="流程" vertex="1">
          <mxGeometry height="375" width="397" x="543" y="637" as="geometry" />
        </mxCell>
        <mxCell id="hm0ZugIW6zdflCOt5yMR-7" edge="1" parent="1" source="hm0ZugIW6zdflCOt5yMR-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="hm0ZugIW6zdflCOt5yMR-5">
