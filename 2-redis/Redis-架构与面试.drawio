        <mxCell id="r09_t34" value="Gossip：节点定期交换状态，去中心化。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1070" y="375" width="430" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r09_t35" value="• 16384 个槽：迁移以槽为单位，路由 O(1)&#xa;• 不是一致性哈希，不维护哈希环&#xa;• 集群总线端口 = 服务端口 + 10000" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1070" y="405" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r09_t36" value="至少 3 主 3 从；每个分片内部仍靠主从复制。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1070" y="500" width="430" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r09_p37" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="1480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="r09_t38" value="面试重点：分片、重定向、多 key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="628" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r09_t39" value="为什么是 16384？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="666" width="680" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r09_t40" value="槽太少 → 分片粒度粗、单节点数据不均；&#xa;槽太多 → 心跳包携带的位图太大；&#xa;16384 是“粒度”和“心跳开销”的折中。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="690" width="680" height="64" as="geometry" />
        </mxCell>
        <mxCell id="r09_b41" value="源：MIGRATING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#D97706;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="762" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r09_a42" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="777" as="sourcePoint" />
            <mxPoint x="276" y="777" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r09_b43" value="客户端：ASK" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="276" y="762" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r09_a44" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="376" y="777" as="sourcePoint" />
            <mxPoint x="402" y="777" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r09_b45" value="目标：IMPORTING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="402" y="762" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r09_a46" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="562" y="777" as="sourcePoint" />
            <mxPoint x="588" y="777" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r09_b47" value="迁完：MOVED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="588" y="762" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r09_t48" value="迁移中的槽：先 ASK，迁完 MOVED。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="730" y="768" width="360" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r09_t49" value="多 key 操作为什么失败？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="666" width="680" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r09_t50" value="MGET / SINTER 要求所有 key 在同一槽；&#xa;用 hash tag 强制同槽：{user}:1、{user}:2。&#xa;否则跨槽 → CROSSSLOT 错误。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="692" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r09_t51" value="面试口径：Cluster 解决“单机内存 + 水平扩展”，哨兵解决“高可用 + 自动切换”，两者不是替代关系。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="812" width="1400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r09_p52" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r09_t53" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r09_t54" value="Cluster 用固定槽位做分片：路由简单、迁移以槽为单位；代价是跨槽多 key 操作受限。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
