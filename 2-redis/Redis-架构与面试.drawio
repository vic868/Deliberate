        <mxCell id="r10_t4" value="缓存和 DB 都没有 → 请求全打 DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
