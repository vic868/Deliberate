"1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="283" as="sourcePoint"/><mxPoint x="1040" y="283" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r03_a17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=1.3;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="283" as="sourcePoint"/><mxPoint x="1280" y="283" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r03_loop1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#C81E1E;strokeWidth=1.1;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="316" as="sourcePoint"/><mxPoint x="890" y="398" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r03_loop2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#C81E1E;strokeWidth=1.1;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="398" as="sourcePoint"/><mxPoint x="410" y="398" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r03_a18" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#C81E1E;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="398" as="sourcePoint"/><mxPoint x="410" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r03_t19" value="处理完继续下一轮事件" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#C81E1E;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="600" y="370" width="300" height="18" as="geometry"/></mxCell><mxCell id="r03_t20" value="单线程 = 命令执行串行；网络收发在 6.0 之后可以由多个 IO 线程并行。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="414" width="700" height="20" as="geometry"/></mxCell><mxCell id="r03_p21" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="720" height="370" as="geometry"/></mxCell><mxCell id="r03_t22" value="单线程的代价：一个慢命令，所有人排队" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="488" width="660" height="24" as="geometry"/></mxCell><mxCell id="r03_b23" value="Client A&#10;KEYS *" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="160" height="44" as="geometry"/></mxCell><mxCell id="r03_b24" value="单线程被占满 2s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="180" height="44" as="geometry"/></mxCell><mxCell id="r03_a25" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="552" as="sourcePoint"/><mxPoint x="300" y="552" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r03_t26" value="B、C 的 GET / SET&#10;全部阻塞等待" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="540" width="240" height="40" as="geometry"/></mxCell><mxCell id="r03_t27" value="生产禁忌" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="600" width="660" height="22" as="geometry"/></mxCell><mxCell id="r03_t28" value="KEYS * · FLUSHALL / FLUSHDB · 大 key 的 DEL / HGETALL&#10;SORT / ZUNIONSTORE · Lua 死循环" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="628" width="660" height="80" as="geometry"/></mxCell><mxCell id="r03_t29" value="替代：SCAN / HSCAN / SSCAN 分批；大 key 用 UNLINK 异步删除；&#10;复杂操作拆小，避免在 Redis 内做重计算。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="720" width="660" height="60" as="geometry"/></mxCell><mxCell id="r03_t30" value="面试点：慢查询会阻塞所有后续请求，不是只影响一个客户端。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="792" width="660" height="24" as="geometry"/></mxCell><mxCell id="r03_p31" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="720" height="370" as="geometry"/></mxCell><mxCell id="r03_t32" value="快的三个原因 + 一个版本补丁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="488" width="660" height="24" as="geometry"/></mxCell><mxCell id="r03_t33" value="① 纯内存" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="526" width="160" height="22" as="geometry"/></mxCell><mxCell id="r03_t34" value="命令执行不碰磁盘，微秒级；持久化是后台异步。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010" y="526" width="500" height="40" as="geometry"/></mxCell><mxCell id="r03_t35" value="② 单线程免锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="588" width="160" height="22" as="geometry"/></mxCell><mxCell id="r03_t36" value="没有锁竞争、上下文切换、并发改数据结构的问题。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010" y="588" width="500" height="40" as="geometry"/></mxCell><mxCell id="r03_t37" value="③ IO 多路复用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="650" width="160" height="22" as="geometry"/></mxCell><mxCell id="r03_t38" value="一个线程管理上万连接，epoll 非阻塞，谁就绪处理谁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1010" y="650" width="500" height="40" as="geometry"/></mxCell><mxCell id="r03_p39" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="844" y="724" width="660" height="80" as="geometry"/></mxCell><mxCell id="r03_t40" value="Redis 6.0：IO 多线程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="736" width="620" height="22" as="geometry"/></mxCell><mxCell id="r03_t41" value="网络读写 / 协议解析并行；命令执行仍串行，所以原子性不变。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="762" width="620" height="32" as="geometry"/></mxCell><mxCell id="r03_p42" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r03_t43" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r03_t44" value="Redis 的快不是“多线程”，而是“内存 + 串行无锁 + 事件驱动”；代价是慢命令会卡住所有人。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r04" name="04 数据类型"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r04_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r04_title" value="五种基本类型 + 四种特殊类型：按场景选，不按名字背" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r04_sub" value="String / Hash / List / Set / ZSet；Bitmap / HyperLogLog / GEO / Stream。小数据用紧