B2;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="716" width="180" height="44" as="geometry"/></mxCell><mxCell id="r05_a79" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0891B2;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="738" as="sourcePoint"/><mxPoint x="1270" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r05_b80" value="ziplist C" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#A5F3FC;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#0891B2;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="1270" y="716" width="180" height="44" as="geometry"/></mxCell><mxCell id="r05_t81" value="listpack（7.0）逐步替代 ziplist，解决连锁更新；&#10;阈值：hash 128 个字段 / 64 字节，zset 128 个元素。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="774" width="680" height="50" as="geometry"/></mxCell><mxCell id="r05_p82" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r05_t83" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r05_t84" value="省内存的核心是“紧凑编码”，保速度的核心是“必要时切换通用结构”；阈值到了就换，不要和内存较劲。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r06" name="06 持久化"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r06_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r06_title" value="持久化：RDB 拍全景，AOF 记流水，混合持久化两手抓" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r06_sub" value="RDB 用 fork + COW 不阻塞；AOF everysec 最多丢 1 秒；混合持久化先读 RDB 再补 AOF 尾部。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r06_num" value="06 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r06_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r06_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="720" height="380" as="geometry"/></mxCell><mxCell id="r06_t2" value="RDB：定期全量快照" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="660" height="24" as="geometry"/></mxCell><mxCell id="r06_b3" value="主进程" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="212" width="150" height="54" as="geometry"/></mxCell><mxCell id="r06_a4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="239" as="sourcePoint"/><mxPoint x="300" y="239" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r06_t5" value="fork" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="190.0" y="219.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="r06_b6" value="子进程&#10;写 RDB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="212" width="180" height="54" as="geometry"/></mxCell><mxCell id="r06_a7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="239" as="sourcePoint"/><mxPoint x="540" y="239" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r06_b8" value="磁盘&#10;snapshot.rdb" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="212" width="180" height="54" as="geometry"/></mxCell><mxCell id="r06_t9" value="主进程继续服务；只有被修改的页才复制（COW）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="286" width="650" height="20" as="geometry"/></mxCell><mxCell id="r06_t10" value="SAVE 阻塞（禁用）；BGSAVE 才是生产用法。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="316" width="650" height="20" as="geometry"/></mxCell><mxCell id="r06_p11" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="90" y="356" width="630" height="62" as="geometry"/></mxCell><mxCell id="r06_t12" value="触发条件" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="106" y="366" width="600" height="20" as="geometry"/></mxCell><mxCell id="r06_t13" value="save 900 1 / save 300 10 / save 60 10000" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="106" y="392" width="600" height="20" as="geometry"/></mxCell><mxCell id="r06_t14" value="缺点：两次快照之间宕机 → 这段时间的数据丢失。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="434" width="630" height="22" as="geometry"/></mxCell><mxCell id="r06_t15" value="fork 本身会短暂阻塞；COW 期间写入多，内存可能翻倍。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="466" width="630" height="40" as="geometry"/></mxCell><mxCell id="r06_p16" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="740" height="380" as="geometry"/></mxCell><mxCell id="r06_t17" value="AOF：追加写命令" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="168" width="680" height="24" as="geometry"/></mxCell><mxCell id="r06_t18" value="每条写命令追加到 AOF 缓冲区，再按策略 fsync 到磁盘。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="204" width="680" height="20" as="geometry"/></mxCell><mxCell id="r06_b19" value="写命令" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="240" width="150" height="54" as="geometry"/></mxCell><mxCell id="r06_a20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="267" as="sourcePoint"/><mxPoint x="1020" y="267" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r06_b21" value="AOF 缓冲区" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="240" width="170" height="54" as="geometry"/></mxCell><mxCell id="r06_a22" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="267" as="sourcePoint"/><mxPoint x="1230" y="267" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r06_b23" value="AOF 文件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="240" width="260" height="54" as="geometry"/></mxCell><mxCell id="r06_p24" value="" style="rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="326" width="660" height="50" as="geometry"/></mxCell><mxCell id="r06_t25" value="always" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="846" y="338" width="110" height="22" as="geometry"/></mxCell><mxCell id="r06_t26" value="每条都 fsync；最安全最慢" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="960" y="338" width="520" height="22" as="geometry"/></mxCell><mxCell id="r06_p27" value="" style="rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="384" width="660" height="50" as="geometry"/></mxCell><mxCell id="r06_t28" value="everysec" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="846" y="396" width="110" height="22" as="geometry"/></mxCell><mxCell id="r06_t29" value="每秒一次；最多丢 1 秒 ⭐" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="960" y="396" width="520" height="22" as="geometry"/></mxCell><mxCell id="r06_p30" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="442" width="660" height="50" as="geometry"/></mxCell><mxCell id="r06_t31" value="no" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="846" y="454" width="110" height="22" as="geometry"/></mxCell><mxCell id="r06_t32" value="交给 OS；最快，可能丢更多" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="960" y="454" width="520" height="22" as="geometry"/></mxCell><mxCell id="r06_t33" value="AOF 重写：BGREWRITEAOF 合并冗余命令（十次 INCR → 一次 SET）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="500" width="680" height="42" as="geometry"/></mxCell><mxCell id="r06_p34" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1480" height="300" as="geometry"/></mxCell><mxCell id="r06_t35" value="混合持久化：RDB 做底，AOF 补尾" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="578" width="1400" height="24" as="geometry"/></mxCell><mxCell id="r06_p36" value="" style="rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="100" y="620" width="560" height="56" as="geometry"/></mxCell><mxCell id="r06_t37" value="前半：RDB 全量快照" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="634" width="260" height="26" as="geometry"/></mxCell><mxCell id="r06_p38" value="" style="rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="620" width="440" height="56" as="geometry"/></mxCell><mxCell id="r06_t39" value="后半：AOF 增量命令" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="676" y="634" width="400" height="26" as="geometry"/></mxCell><mxCell id="r06_t40" value="aof-use-rdb-preamble yes&#10;重启先读 RDB，再重放 AOF 尾部" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1120" y="632" width="380" height="40" as="geometry"/></mxCell><mxCell id="r06_t41" value="生产基线：appendonly yes + appendfsync everysec + 混合持久化 + 合理的 save 策略。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="698" width="1380" height="22" as="geometry"/></mxCell><mxCell id="r06_t42" value="最坏情况：everysec 的 1 秒窗口；RDB 负责快速恢复，AOF 负责完整性。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="726" width="1380" height="22" as="geometry"/></mxCell><mxCell id="r06_p43" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="100" y="764" width="1380" height="60" as="geometry"/></mxCell><mxCell id="r06_t44" value="面试点：fork 会阻塞吗？会短暂阻塞；COW 只复制被修改页，但写入量大时内存可能接近翻倍。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="776" width="1340" height="34" as="geometry"/></mxCell><mxCell id="r06_p45" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r06_t46" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r06_t47" value="RDB 保恢复速度，AOF 保数据完整；混合持久化把两者拼成一个文件，是生产默认答案。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r07" name="07 过期与淘汰"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r07_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r07_title" value="过期与淘汰：惰性 + 定期，最后用 maxmemory 兜底" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r07_sub" value="过期键不会到点就删；内存满了才触发淘汰。LRU 是近似 LRU，LFU 看访问次数。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r07_num" value="07 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r07_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r07_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="740" height="420" as="geometry"/></mxCell><mxCell id="r07_t2" value="过期键：惰性删除 + 定期删除" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="680" height="24" as="geometry"/></mxCell><mxCell id="r07_b3" value="key 设置了 TTL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="212" width="190" height="56" as="geometry"/></mxCell><mxCell id="r07_a4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="268" as="sourcePoint"/><mxPoint x="185" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r07_d5" value="被访问？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;fontSize=9;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="100" y="304" width="170" height="80" as="geometry"/></mxCell><mxCell id="r07_a6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="344" as="sourcePoint"/><mxPoint x="330" y="344" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r07_t7" value="是" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="220.0" y="324.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="r07_b8" value="检查过期&#10;过期则删除" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="316" width="190" height="56" as="geometry"/></mxCell><mxCell id="r07_t9" value="惰性删除：不访问不删" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="382" width="200" height="20" as="geometry"/></mxCell><mxCell id="r07_t10" value="否 → 留在内存" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="396" width="200" height="18" as="geometry"/></mxCell><mxCell id="r07_t11" value="定期删除：每 100ms 随机抽查，过期比例 &gt; 25% 就继续抽。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="640" height="20" as="geometry"/></mxCell><mxCell id="r07_t12" value="不做“到点定时删”：十万 key 同时到期会造成 CPU 尖峰。&#10;过期 key 可能残留，靠定期巡检 + 淘汰兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="640" height="40" as="geometry"/></mxCell><mxCell id="r07_t13" value="面试点：为什么不用定时删除？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="510" width="640" height="22" as="geometry"/></mxCell><mxCell id="r07_p14" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="720" height="420" as="geometry"/></mxCell><mxCell id="r07_t15" value="内存淘汰：maxmemory 满了怎么办" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="168" width="660" height="24" as="geometry"/></mxCell><mxCell id="r07_t16" value="八种策略，先分“所有 key”还是“仅过期 key”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="204" width="660" height="20" as="geometry"/></mxCell><mxCell id="r07_p17" value="" style="rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="844" y="240" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t18" value="allkeys-lru" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="248" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t19" value="所有 key，最久未用 ⭐" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="267" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_p20" value="" style="rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1174" y="240" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t21" value="allkeys-lfu" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="248" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t22" value="所有 key，最少使用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="267" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_p23" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="844" y="302" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t24" value="allkeys-random" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#64748B;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="310" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t25" value="所有 key，随机" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="329" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_p26" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1174" y="302" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t27" value="volatile-lru" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="310" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t28" value="仅过期 key，最久未用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="329" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_p29" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="844" y="364" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t30" value="volatile-lfu" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="372" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t31" value="仅过期 key，最少使用" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="391" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_p32" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1174" y="364" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t33" value="volatile-ttl" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="372" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t34" value="仅过期 key，TTL 最小" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="391" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_p35" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="844" y="426" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t36" value="volatile-random" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#64748B;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="434" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t37" value="仅过期 key，随机" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="453" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_p38" value="" style="rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1174" y="426" width="310" height="50" as="geometry"/></mxCell><mxCell id="r07_t39" value="noeviction" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="434" width="150" height="18" as="geometry"/></mxCell><mxCell id="r07_t40" value="不淘汰，满了拒写 ⚠️" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188" y="453" width="286" height="18" as="geometry"/></mxCell><mxCell id="r07_t41" value="缓存首选 allkeys-lru；冷热分明用 allkeys-lfu。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="506" width="660" height="22" as="geometry"/></mxCell><mxCell id="r07_p42" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="1480" height="260" as="geometry"/></mxCell><mxCell id="r07_t43" value="LRU vs LFU：一个看时间，一个看次数" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="608" width="1400" height="24" as="geometry"/></mxCell><mxCell id="r07_p44" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="100" y="650" width="640" height="150" as="geometry"/></mxCell><mxCell id="r07_t45" value="LRU（Least Recently Used）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="662" width="600" height="20" as="geometry"/></mxCell><mxCell id="r07_t46" value="淘汰“最久没被访问”的 key。&#10;Redis 不是精确 LRU：随机采样 maxmemory-samples（默认 5）个 key，&#10;挑最久未用的淘汰——用概率换内存与 CPU。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="690" width="600" height="90" as="geometry"/></mxCell><mxCell id="r07_p47" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="780" y="650" width="720" height="150" as="geometry"/></mxCell><mxCell id="r07_t48" value="LFU（Least Frequently Used）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="796" y="662" width="680" height="20" as="geometry"/></mxCell><mxCell id="r07_t49" value="淘汰“访问次数最少”的 key，适合有明显冷热区分的场景。&#10;新 key 不会因为“刚访问一次”就把老热点挤掉；&#10;代价是统计频率需要额外空间。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="796" y="690" width="680" height="90" as="geometry"/></mxCell><mxCell id="r07_p50" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r07_t51" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r07_t52" value="过期是“清理已经没用的”，淘汰是“内存满了必须丢一些”；两者都不负责业务正确性。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r08" name="08 主从与哨兵"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r08_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r08_title" value="主从与哨兵：先有副本，再有自动切换" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r08_sub" value="全量 RDB + 增量 repl_backlog；哨兵 SDOWN → ODOWN → 选举 → 提升从库 → 通知客户端。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r08_num" value="08 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r08_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="760" height="430" as="geometry"/></mxCell><mxCell id="r08_t2" value="主从复制：一主多从，异步同步" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="700" height="24" as="geometry"/></mxCell><mxCell id="r08_b3" value="Master&#10;读写入口" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="220" width="210" height="70" as="geometry"/></mxCell><mxCell id="r08_p4" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="100" y="370" width="210" height="170" as="geometry"/></mxCell><mxCell id="r08_t5" value="Replicas（默认只读）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="118" y="380" width="180" height="20" as="geometry"/></mxCell><mxCell id="r08_b6" value="Replica 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="118" y="410" width="174" height="50" as="geometry"/></mxCell><mxCell id="r08_b7" value="Replica 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="118" y="474" width="174" height="50" as="geometry"/></mxCell><mxCell id="r08_a8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205" y="290" as="sourcePoint"/><mxPoint x="205" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_t9" value="PSYNC / RDB + 增量" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="125.0" y="310.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="r08_b10" value="repl_backlog&#10;环形缓冲" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="450" y="220" width="250" height="60" as="geometry"/></mxCell><mxCell id="r08_a11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.3;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="250" as="sourcePoint"/><mxPoint x="450" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_t12" value="写命令" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="300.0" y="230.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="r08_bl1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#059669;strokeWidth=1.2;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="250" as="sourcePoint"/><mxPoint x="720" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_bl2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#059669;strokeWidth=1.2;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="250" as="sourcePoint"/><mxPoint x="720" y="455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_a13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="455" as="sourcePoint"/><mxPoint x="310" y="455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_t14" value="断线重连 offset" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="435.0" y="435.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="r08_t15" value="全量期间的新写先入&#10;replication buffer，随后补发" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="450" y="322" width="250" height="50" as="geometry"/></mxCell><mxCell id="r08_t16" value="全量：fork RDB → 发送 → 补发 buffer；增量：之后每条写命令实时同步。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="548" width="700" height="20" as="geometry"/></mxCell><mxCell id="r08_t17" value="从库默认只读；读写分离能分摊读，但主库仍是写瓶颈。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="574" width="700" height="20" as="geometry"/></mxCell><mxCell id="r08_p18" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="700" height="430" as="geometry"/></mxCell><mxCell id="r08_t19" value="哨兵：监控、判挂、自动切换" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="168" width="640" height="24" as="geometry"/></mxCell><mxCell id="r08_b20" value="Sentinel 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="210" width="110" height="54" as="geometry"/></mxCell><mxCell id="r08_a21" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="264" as="sourcePoint"/><mxPoint x="1060" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_b22" value="Sentinel 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="210" width="110" height="54" as="geometry"/></mxCell><mxCell id="r08_a23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="264" as="sourcePoint"/><mxPoint x="1060" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_b24" value="Sentinel 3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="210" width="110" height="54" as="geometry"/></mxCell><mxCell id="r08_a25" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="264" as="sourcePoint"/><mxPoint x="1060" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_b26" value="quorum 投票" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="292" width="160" height="30" as="geometry"/></mxCell><mxCell id="r08_a27" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="322" as="sourcePoint"/><mxPoint x="1060" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r08_p28" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="920" y="342" width="300" height="90" as="geometry"/></mxCell><mxCell id="r08_t29" value="超过 quorum → ODOWN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="938" y="354" width="264" height="22" as="geometry"/></mxCell><mxCell id="r08_t30" value="单哨兵 SDOWN 只是“我觉得”&#10;多数派确认才客观下线" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="938" y="380" width="264" height="40" as="geometry"/></mxCell><mxCell id="r08_t31" value="然后：选举 Leader 哨兵 → 选数据最新的从库 → 提升 → 通知客户端。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="452" width="640" height="20" as="geometry"/></mxCell><mxCell id="r08_t32" value="哨兵至少 3 个奇数节点，否则投票无法形成多数。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="482" width="640" height="20" as="geometry"/></mxCell><mxCell id="r08_t33" value="客户端通过哨兵拿新 master 地址；&#10;切换期间有短暂不可用窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="520" width="640" height="40" as="geometry"/></mxCell><mxCell id="r08_p34" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1480" height="240" as="geometry"/></mxCell><mxCell id="r08_t35" value="故障切换会丢数据吗？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="628" width="1400" height="24" as="geometry"/></mxCell><mxCell id="r08_t36" value="会。主从是异步复制：master 已确认、尚未同步到 replica 的写，切换后可能消失。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="666" width="680" height="22" as="geometry"/></mxCell><mxCell id="r08_t37" value="缓解：min-replicas-to-write + min-replicas-max-lag，让 master 在从库不足时拒写。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="696" width="680" height="22" as="geometry"/></mxCell><mxCell id="r08_t38" value="脑裂：网络分区时旧 master 仍在写，新 master 已被选出 → 双主，恢复后旧数据被截断。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="726" width="680" height="22" as="geometry"/></mxCell><mxCell id="r08_p39" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="680" height="150" as="geometry"/></mxCell><mxCell id="r08_t40" value="面试点：哨兵和 Cluster 的区别" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="672" width="640" height="20" as="geometry"/></mxCell><mxCell id="r08_t41" value="哨兵解决“高可用 + 自动切换”，数据仍在一份主从里；&#10;Cluster 解决“分片 + 横向扩展”，每个分片自己还有主从。&#10;两者不是替代关系，Cluster 内部也靠主从复制。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="700" width="640" height="90" as="geometry"/></mxCell><mxCell id="r08_p42" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r08_t43" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r08_t44" value="主从给副本，哨兵给自动切换；异步复制决定了切换一定有丢数据窗口，只能缩小，不能消灭。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r09" name="09 Cluster"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r09_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r09_title" value="Cluster：16384 个槽，把单机内存问题变成分片问题" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r09_sub" value="CRC16(key) mod 16384；槽分配给节点；MOVED/ASK 重定向；Gossip 去中心化。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r09_num" value="09 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r09_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="960" height="430" as="geometry"/></mxCell><mxCell id="r09_t2" value="路由：key 怎么找到节点" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="900" height="24" as="geometry"/></mxCell><mxCell id="r09_b3" value="Client" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="220" width="140" height="54" as="geometry"/></mxCell><mxCell id="r09_b4" value="key: user:1001" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="220" width="180" height="54" as="geometry"/></mxCell><mxCell id="r09_b5" value="CRC16(key)&#10;mod 16384" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.8;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="490" y="220" width="180" height="54" as="geometry"/></mxCell><mxCell id="r09_b6" value="slot = 5471" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="220" width="150" height="54" as="geometry"/></mxCell><mxCell id="r09_a7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="247" as="sourcePoint"/><mxPoint x="270" y="247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_a8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="247" as="sourcePoint"/><mxPoint x="490" y="247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_a9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="247" as="sourcePoint"/><mxPoint x="710" y="247" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_slot1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D97706;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="274" as="sourcePoint"/><mxPoint x="785" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_slot2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D97706;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="302" as="sourcePoint"/><mxPoint x="505" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_a10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="302" as="sourcePoint"/><mxPoint x="505" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_t11" value="属于 B" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="282" width="90" height="18" as="geometry"/></mxCell><mxCell id="r09_b12" value="Node A&#10;主" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="330" width="230" height="68" as="geometry"/></mxCell><mxCell id="r09_t13" value="0 – 5460" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="108" y="402" width="214" height="20" as="geometry"/></mxCell><mxCell id="r09_b14" value="Replica" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="230" height="46" as="geometry"/></mxCell><mxCell id="r09_a15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="404" as="sourcePoint"/><mxPoint x="215" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_b16" value="Node B&#10;主" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="330" width="230" height="68" as="geometry"/></mxCell><mxCell id="r09_t17" value="5461 – 10922" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="398" y="402" width="214" height="20" as="geometry"/></mxCell><mxCell id="r09_b18" value="Replica" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="450" width="230" height="46" as="geometry"/></mxCell><mxCell id="r09_a19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="404" as="sourcePoint"/><mxPoint x="505" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_b20" value="Node C&#10;主" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="330" width="230" height="68" as="geometry"/></mxCell><mxCell id="r09_t21" value="10923 – 16383" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="688" y="402" width="214" height="20" as="geometry"/></mxCell><mxCell id="r09_b22" value="Replica" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="450" width="230" height="46" as="geometry"/></mxCell><mxCell id="r09_a23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="404" as="sourcePoint"/><mxPoint x="795" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_p24" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="90" y="510" width="860" height="56" as="geometry"/></mxCell><mxCell id="r09_t25" value="MOVED：槽已经永久属于别的节点，客户端刷新路由表。  ASK：槽正在迁移，临时去目标节点取一次。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="106" y="520" width="830" height="20" as="geometry"/></mxCell><mxCell id="r09_p26" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="500" height="430" as="geometry"/></mxCell><mxCell id="r09_t27" value="Cluster 的三件事" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1064" y="168" width="440" height="24" as="geometry"/></mxCell><mxCell id="r09_b28" value="Node A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1070" y="210" width="130" height="50" as="geometry"/></mxCell><mxCell id="r09_b29" value="Node B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="210" width="130" height="50" as="geometry"/></mxCell><mxCell id="r09_b30" value="Node C" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1220" y="310" width="130" height="50" as="geometry"/></mxCell><mxCell id="r09_a31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=block;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="235" as="sourcePoint"/><mxPoint x="1370" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_a32" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=block;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="260" as="sourcePoint"/><mxPoint x="1220" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_a33" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=block;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="310" as="sourcePoint"/><mxPoint x="1435" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_t34" value="Gossip：节点定期交换状态，去中心化。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1070" y="375" width="430" height="20" as="geometry"/></mxCell><mxCell id="r09_t35" value="• 16384 个槽：迁移以槽为单位，路由 O(1)&#10;• 不是一致性哈希，不维护哈希环&#10;• 集群总线端口 = 服务端口 + 10000" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1070" y="405" width="430" height="80" as="geometry"/></mxCell><mxCell id="r09_t36" value="至少 3 主 3 从；每个分片内部仍靠主从复制。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1070" y="500" width="430" height="40" as="geometry"/></mxCell><mxCell id="r09_p37" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1480" height="240" as="geometry"/></mxCell><mxCell id="r09_t38" value="面试重点：分片、重定向、多 key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="628" width="1400" height="24" as="geometry"/></mxCell><mxCell id="r09_t39" value="为什么是 16384？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="666" width="680" height="20" as="geometry"/></mxCell><mxCell id="r09_t40" value="槽太少 → 分片粒度粗、单节点数据不均；&#10;槽太多 → 心跳包携带的位图太大；&#10;16384 是“粒度”和“心跳开销”的折中。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="690" width="680" height="64" as="geometry"/></mxCell><mxCell id="r09_b41" value="源：MIGRATING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#D97706;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="762" width="150" height="30" as="geometry"/></mxCell><mxCell id="r09_a42" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="777" as="sourcePoint"/><mxPoint x="276" y="777" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_b43" value="客户端：ASK" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="276" y="762" width="100" height="30" as="geometry"/></mxCell><mxCell id="r09_a44" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="376" y="777" as="sourcePoint"/><mxPoint x="402" y="777" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_b45" value="目标：IMPORTING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="402" y="762" width="160" height="30" as="geometry"/></mxCell><mxCell id="r09_a46" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="562" y="777" as="sourcePoint"/><mxPoint x="588" y="777" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r09_b47" value="迁完：MOVED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1"><mxGeometry x="588" y="762" width="130" height="30" as="geometry"/></mxCell><mxCell id="r09_t48" value="迁移中的槽：先 ASK，迁完 MOVED。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="730" y="768" width="360" height="24" as="geometry"/></mxCell><mxCell id="r09_t49" value="多 key 操作为什么失败？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="666" width="680" height="20" as="geometry"/></mxCell><mxCell id="r09_t50" value="MGET / SINTER 要求所有 key 在同一槽；&#10;用 hash tag 强制同槽：{user}:1、{user}:2。&#10;否则跨槽 → CROSSSLOT 错误。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="692" width="680" height="80" as="geometry"/></mxCell><mxCell id="r09_t51" value="面试口径：Cluster 解决“单机内存 + 水平扩展”，哨兵解决“高可用 + 自动切换”，两者不是替代关系。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="812" width="1400" height="22" as="geometry"/></mxCell><mxCell id="r09_p52" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r09_t53" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r09_t54" value="Cluster 用固定槽位做分片：路由简单、迁移以槽为单位；代价是跨槽多 key 操作受限。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r10" name="10 缓存治理"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r10_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r10_title" value="缓存治理：穿透、击穿、雪崩，以及和数据库的一致性" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r10_sub" value="穿透查不存在，击穿是热点过期，雪崩是大量同时失效；一致性优先 Cache Aside + 删除缓存。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r10_num" value="10 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r10_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r10_p1" value="" style="rounded=1;arcSize=16;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="460" height="230" as="geometry"/></mxCell><mxCell id="r10_t2" value="① 穿透" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="176" width="90" height="24" as="geometry"/></mxCell><mxCell id="r10_t3" value="查大量不存在的 key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="208" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t4" value="缓存和 DB 都没有 → 请求全打 DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="234" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t5" value="·  布隆过滤器：先挡“一定不存在”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t6" value="·  空值缓存：短 TTL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="294" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t7" value="·  参数校验 / 限流" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="318" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_p8" value="" style="rounded=1;arcSize=16;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="460" height="230" as="geometry"/></mxCell><mxCell id="r10_t9" value="② 击穿" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="570" y="176" width="90" height="24" as="geometry"/></mxCell><mxCell id="r10_t10" value="单个热点 key 刚过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="570" y="208" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t11" value="瞬间海量请求打到 DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="570" y="234" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t12" value="·  互斥锁：只放一个请求重建" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="570" y="270" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t13" value="·  逻辑过期：返回旧值 + 异步刷新" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="570" y="294" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t14" value="·  热点 key 永不过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="570" y="318" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_p15" value="" style="rounded=1;arcSize=16;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="460" height="230" as="geometry"/></mxCell><mxCell id="r10_t16" value="③ 雪崩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="176" width="90" height="24" as="geometry"/></mxCell><mxCell id="r10_t17" value="大量 key 同时过期 / Redis 宕机" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="208" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t18" value="DB 瞬间被压垮" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="234" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t19" value="·  过期时间加随机偏移" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="270" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t20" value="·  Redis 高可用 + 多级缓存" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="294" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_t21" value="·  熔断降级 + 限流" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1060" y="318" width="420" height="20" as="geometry"/></mxCell><mxCell id="r10_p22" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1480" height="420" as="geometry"/></mxCell><mxCell id="r10_t23" value="缓存与数据库一致性：Cache Aside + 删除缓存" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="438" width="1400" height="24" as="geometry"/></mxCell><mxCell id="r10_t24" value="读路径" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="476" width="600" height="20" as="geometry"/></mxCell><mxCell id="r10_b25" value="读缓存" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="504" width="120" height="44" as="geometry"/></mxCell><mxCell id="r10_a26" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="526" as="sourcePoint"/><mxPoint x="260" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r10_d27" value="命中？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;fontSize=8;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="260" y="496" width="130" height="60" as="geometry"/></mxCell><mxCell id="r10_a28" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="526" as="sourcePoint"/><mxPoint x="430" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r10_t29" value="否" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="330.0" y="506.0" width="160" height="20" as="geometry"/></mxCell><mxCell id="r10_b30" value="查 DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="504" width="150" height="44" as="geometry"/></mxCell><mxCell id="r10_a31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="526" as="sourcePoint"/><mxPoint x="620" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r10_b32" value="回填缓存" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="504" width="160" height="44" as="geometry"/></mxCell><mxCell id="r10_t33" value="命中直接返回；未命中查 DB 并回填，TTL 兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="560" width="680" height="20" as="geometry"/></mxCell><mxCell id="r10_t34" value="写路径" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="600" width="600" height="20" as="geometry"/></mxCell><mxCell id="r10_b35" value="更新 DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="628" width="150" height="44" as="geometry"/></mxCell><mxCell id="r10_a36" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="650" as="sourcePoint"/><mxPoint x="300" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r10_b37" value="删除缓存（不是更新）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="628" width="170" height="44" as="geometry"/></mxCell><mxCell id="r10_a38" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="650" as="sourcePoint"/><mxPoint x="510" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r10_b39" value="延迟双删 / Canal 兜底" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="628" width="180" height="44" as="geometry"/></mxCell><mxCell id="r10_t40" value="为什么删除而不是更新？并发写时“更新缓存”可能被旧值覆盖；&#10;删除更简单，下一次读自然回填。&#10;延迟双删应对主从延迟；Canal 订阅 binlog 异步删更可靠。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="684" width="680" height="70" as="geometry"/></mxCell><mxCell id="r10_p41" value="" style="rounded=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="820" y="476" width="700" height="330" as="geometry"/></mxCell><mxCell id="r10_t42" value="并发下会发生什么？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="490" width="660" height="20" as="geometry"/></mxCell><mxCell id="r10_t43" value="① 先删缓存、再更新 DB：&#10;   删完后、DB 更新前，另一个读请求把旧值回填 → 脏数据。&#10;② 先更新 DB、再删缓存：&#10;   理论上仍有极小窗口，但概率最低，工程默认选它。&#10;③ 缓存删除失败：重试 + binlog 补偿 + TTL 兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="520" width="660" height="100" as="geometry"/></mxCell><mxCell id="r10_t44" value="结论：接受最终一致，不要追求强一致。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="650" width="660" height="20" as="geometry"/></mxCell><mxCell id="r10_t45" value="最终一致不是“立刻正确”：删除缓存后仍可能读到旧值；&#10;靠 TTL、删除重试、binlog 补偿慢慢收敛。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="756" width="680" height="56" as="geometry"/></mxCell><mxCell id="r10_t46" value="读多写少用 Cache Aside；写多可用 Write Behind，但要接受丢数据风险。&#10;强一致场景：先落库，缓存只做加速，关键读穿透到 DB。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="838" y="680" width="660" height="60" as="geometry"/></mxCell><mxCell id="r10_p47" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r10_t48" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r10_t49" value="穿透挡“不存在”，击穿挡“热点重建”，雪崩挡“同时失效”；一致性靠删除缓存 + 最终一致 + TTL 兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r11" name="11 分布式锁"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r11_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r11_title" value="分布式锁：SET NX PX 只是起点，不是全部" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r11_sub" value="唯一 value + 过期时间 + Lua 释放；业务超时要续期；主从切换可能丢锁，RedLock 有争议。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r11_num" value="11 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r11_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r11_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="760" height="690" as="geometry"/></mxCell><mxCell id="r11_t2" value="加锁与释放：一条命令 + 一段 Lua" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="700" height="24" as="geometry"/></mxCell><mxCell id="r11_b3" value="Client 1&#10;uuid-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="220" width="170" height="60" as="geometry"/></mxCell><mxCell id="r11_b4" value="SET lock:order uuid-1&#10;NX PX 30000" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.8;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="250" height="60" as="geometry"/></mxCell><mxCell id="r11_a5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="250" as="sourcePoint"/><mxPoint x="330" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r11_b6" value="Redis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="150" height="60" as="geometry"/></mxCell><mxCell id="r11_a7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="250" as="sourcePoint"/><mxPoint x="640" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r11_t8" value="NX：不存在才设置；PX：自动过期防死锁；value 唯一：防误删别人的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="292" width="700" height="20" as="geometry"/></mxCell><mxCell id="r11_b9" value="业务执行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="170" height="54" as="geometry"/></mxCell><mxCell id="r11_a10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175" y="280" as="sourcePoint"/><mxPoint x="175" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r11_b11" value="Lua：if get(key)==uuid-1 then del(key)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.2;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="300" height="54" as="geometry"/></mxCell><mxCell id="r11_a12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="357" as="sourcePoint"/><mxPoint x="330" y="357" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r11_t13" value="释放必须原子：先比对 value，再删除；否则可能删掉刚被 B 拿到的锁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.4;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="398" width="700" height="20" as="geometry"/></mxCell><mxCell id="r11_p14" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="440" width="690" height="74" as="geometry"/></mxCell><mxCell id="r11_t15" value="没设过期时间" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="160" height="20" as="geometry"/></mxCell><mxCell id="r11_t16" value="客户端崩溃 → 死锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="450" width="230" height="20" as="geometry"/></mxCell><mxCell id="r11_t17" value="SET ... NX PX 一条命令原子完成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="474" width="480" height="20" as="geometry"/></mxCell><mxCell id="r11_p18" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="524" width="690" height="74" as="geometry"/></mxCell><mxCell id="r11_t19" value="业务 &gt; 锁过期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="534" width="160" height="20" as="geometry"/></mxCell><mxCell id="r11_t20" value="锁提前释放 → 超卖" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="534" width="230" height="20" as="geometry"/></mxCell><mxCell id="r11_t21" value="Redisson 看门狗：默认 30s，每 10s 续期" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="558" width="480" height="20" as="geometry"/></mxCell><mxCell id="r11_p22" value="" style="rounded=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="84" y="608" width="690" height="74" as="geometry"/></mxCell><mxCell id="r11_t23" value="主库宕机丢锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="618" width="160" height="20" as="geometry"/></mxCell><mxCell id="r11_t24" value="锁未同步到从库 → 双持有" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="618" width="230" height="20" as="geometry"/></mxCell><mxCell id="r11_t25" value="RedLock 多节点多数派；或业务幂等兜底" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="270" y="642" width="480" height="20" as="geometry"/></mxCell><mxCell id="r11_t26" value="RedLock 争议：提升安全性但依赖各节点时钟与 GC 停顿；&#10;能接受幂等时，优先“唯一值 + Lua + 看门狗”，强一致要求高时考虑 ZooKeeper / etcd。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.3;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="700" width="690" height="60" as="geometry"/></mxCell><mxCell id="r11_p27" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="700" height="690" as="geometry"/></mxCell><mxCell id="r11_t28" value="Pipeline / 事务 / Lua / Pub-Sub" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="168" width="640" height="24" as="geometry"/></mxCell><mxCell id="r11_p29" value="" style="rounded=1;arcSize=10;fillColor=#ECFEFF;strokeColor=#A5F3FC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="208" width="650" height="70" as="geometry"/></mxCell><mxCell id="r11_t30" value="Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="218" width="160" height="20" as="geometry"/></mxCell><mxCell id="r11_t31" value="减少 RTT；不是原子，中间可被插队" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1040" y="218" width="450" height="40" as="geometry"/></mxCell><mxCell id="r11_p32" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="290" width="650" height="70" as="geometry"/></mxCell><mxCell id="r11_t33" value="MULTI / EXEC" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="300" width="160" height="20" as="geometry"/></mxCell><mxCell id="r11_t34" value="命令入队后连续执行；不支持回滚（弱事务）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="450" height="40" as="geometry"/></mxCell><mxCell id="r11_p35" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="372" width="650" height="70" as="geometry"/></mxCell><mxCell id="r11_t36" value="Lua" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="382" width="160" height="20" as="geometry"/></mxCell><mxCell id="r11_t37" value="原子执行 + 条件逻辑；分布式锁释放的标准做法" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1040" y="382" width="450" height="40" as="geometry"/></mxCell><mxCell id="r11_t38" value="Pub/Sub vs Stream" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="462" width="650" height="20" as="geometry"/></mxCell><mxCell id="r11_p39" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="490" width="650" height="120" as="geometry"/></mxCell><mxCell id="r11_t40" value="Pub/Sub：推送，消息不持久，离线即丢" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="502" width="620" height="20" as="geometry"/></mxCell><mxCell id="r11_t41" value="适合实时通知、聊天广播；不能当可靠队列。&#10;没有 ACK，没有消费者组，Redis 重启消息全没。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="528" width="620" height="68" as="geometry"/></mxCell><mxCell id="r11_p42" value="" style="rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="864" y="626" width="650" height="120" as="geometry"/></mxCell><mxCell id="r11_t43" value="Stream：拉取，持久化，消费者组 + ACK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="638" width="620" height="20" as="geometry"/></mxCell><mxCell id="r11_t44" value="适合可靠消息队列；支持 XREADGROUP、PENDING、消息回溯。&#10;比 List 更适合“不能丢”的场景。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="882" y="664" width="620" height="68" as="geometry"/></mxCell><mxCell id="r11_t45" value="面试点：Pipeline 不是原子；事务不回滚；Lua 才是“原子 + 条件”的常用解。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="864" y="770" width="650" height="50" as="geometry"/></mxCell><mxCell id="r11_p46" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r11_t47" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r11_t48" value="锁的三要素是“互斥、防死锁、防误删”；续期和主从切换是工程问题，不是一条 SET 命令能解决的。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r12" name="12 面试速查"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r12_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r12_title" value="面试速查：八个问题，一张图带走" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r12_sub" value="先给结论，再补机制，最后主动说边界；Redis 的题大多可以回到“内存 + 单线程 + 数据结构”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r12_num" value="12 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r12_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r12_p1" value="" style="rounded=1;arcSize=14;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t2" value="Q1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="174" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t3" value="Redis 为什么快？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="172" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t4" value="纯内存 + 单线程免锁 + IO 多路复用；&#10;6.0 网络 IO 多线程，命令执行仍单线程。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="212" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t5" value="边界：慢命令会阻塞所有人。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="266" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p6" value="" style="rounded=1;arcSize=14;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t7" value="Q2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="174" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t8" value="数据类型怎么选？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="868" y="172" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t9" value="String 缓存/计数；Hash 对象字段；List 队列；&#10;Set 去重；ZSet 排序；特殊类型按场景。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="212" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t10" value="边界：大数据会切到通用编码。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="266" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p11" value="" style="rounded=1;arcSize=14;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t12" value="Q3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="334" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t13" value="RDB 和 AOF 怎么选？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="332" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t14" value="RDB 恢复快、可能丢一段；AOF everysec 最多丢 1s；&#10;生产用混合持久化。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="372" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t15" value="边界：RDB 会丢窗口；AOF 重写有开销。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="426" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p16" value="" style="rounded=1;arcSize=14;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="320" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t17" value="Q4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="334" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t18" value="过期键怎么删？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="868" y="332" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t19" value="惰性 + 定期抽样；内存满了再按 maxmemory&#10;策略淘汰；缓存首选 allkeys-lru。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="372" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t20" value="边界：LRU 是近似；noeviction 是拒写。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="426" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p21" value="" style="rounded=1;arcSize=14;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t22" value="Q5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="494" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t23" value="主从、哨兵、Cluster？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="492" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t24" value="主从给副本；哨兵给自动切换；Cluster 给分片。&#10;异步复制决定切换有丢数据窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="532" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t25" value="边界：异步复制导致切换可能丢数据。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="586" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p26" value="" style="rounded=1;arcSize=14;fillColor=#ECFEFF;strokeColor=#A5F3FC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t27" value="Q6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="494" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t28" value="缓存三问题？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="868" y="492" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t29" value="穿透→布隆/空值；击穿→互斥/逻辑过期；&#10;雪崩→随机 TTL + 高可用 + 降级。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="532" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t30" value="边界：布隆有误判；逻辑过期可能读旧值。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="586" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p31" value="" style="rounded=1;arcSize=14;fillColor=#FFF7ED;strokeColor=#FED7AA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t32" value="Q7" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#EA580C;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="654" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t33" value="缓存和 DB 一致性？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#EA580C;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="128" y="652" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t34" value="Cache Aside：更新 DB 后删缓存；&#10;延迟双删 / Canal / TTL 兜底，接受最终一致。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="692" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t35" value="边界：删除后仍有短暂不一致窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="746" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p36" value="" style="rounded=1;arcSize=14;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="640" width="740" height="140" as="geometry"/></mxCell><mxCell id="r12_t37" value="Q8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="654" width="44" height="22" as="geometry"/></mxCell><mxCell id="r12_t38" value="分布式锁怎么写？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="868" y="652" width="640" height="24" as="geometry"/></mxCell><mxCell id="r12_t39" value="SET key uuid NX PX + Lua 释放；&#10;超时续期；主从丢锁用 RedLock 或幂等兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="692" width="700" height="44" as="geometry"/></mxCell><mxCell id="r12_t40" value="边界：主从切换可能丢锁，业务幂等兜底。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=7.9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="746" width="700" height="22" as="geometry"/></mxCell><mxCell id="r12_p41" value="" style="rounded=1;arcSize=10;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="806" width="1480" height="44" as="geometry"/></mxCell><mxCell id="r12_t42" value="易错点：单线程≠整个服务器单线程；RDB 不是实时；LRU 是近似；noeviction 是拒写不是淘汰。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#F8FAFC;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="82" y="816" width="1440" height="24" as="geometry"/></mxCell><mxCell id="r12_p43" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r12_t44" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r12_t45" value="Redis 的答题主线：内存 → 单线程 → 数据结构 → 持久化 → 复制/分片 → 缓存治理。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>