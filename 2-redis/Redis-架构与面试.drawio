        <mxCell id="r08_t30" value="单哨兵 SDOWN 只是“我觉得”&#xa;多数派确认才客观下线" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="938" y="380" width="264" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r08_t31" value="然后：选举 Leader 哨兵 → 选数据最新的从库 → 提升 → 通知客户端。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="864" y="452" width="640" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r08_t32" value="哨兵至少 3 个奇数节点，否则投票无法形成多数。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="864" y="482" width="640" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r08_t33" value="客户端通过哨兵拿新 master 地址；&#xa;切换期间有短暂不可用窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="864" y="520" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r08_p34" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="1480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="r08_t35" value="故障切换会丢数据吗？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="628" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r08_t36" value="会。主从是异步复制：master 已确认、尚未同步到 replica 的写，切换后可能消失。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="666" width="680" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r08_t37" value="缓解：min-replicas-to-write + min-replicas-max-lag，让 master 在从库不足时拒写。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="696" width="680" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r08_t38" value="脑裂：网络分区时旧 master 仍在写，新 master 已被选出 → 双主，恢复后旧数据被截断。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="726" width="680" height="22" as="geometry" />
        </mxCell>
        <mxCell id="r08_p39" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="660" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r08_t40" value="面试点：哨兵和 Cluster 的区别" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="838" y="672" width="640" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r08_t41" value="哨兵解决“高可用 + 自动切换”，数据仍在一份主从里；&#xa;Cluster 解决“分片 + 横向扩展”，每个分片自己还有主从。&#xa;两者不是替代关系，Cluster 内部也靠主从复制。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="838" y="700" width="640" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r08_p42" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r08_t43" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r08_t44" value="主从给副本，哨兵给自动切换；异步复制决定了切换一定有丢数据窗口，只能缩小，不能消灭。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
