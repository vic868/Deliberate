<mxGeometry x="84" y="794" width="660" height="22" as="geometry"/></mxCell><mxCell id="r05_p65" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="510" width="740" height="340" as="geometry"/></mxCell><mxCell id="r05_t66" value="ziplist / listpack / quicklist：省指针" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="528" width="680" height="24" as="geometry"/></mxCell><mxCell id="r05_t67" value="ziplist：一整块连续内存，元素紧挨着放，没有指针开销。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="564" width="680" height="20" as="geometry"/></mxCell><mxCell id="r05_p68" value="" style="rounded=1;arcSize=6;fillColor=#ECFEFF;strokeColor=#A5F3FC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="824" y="596" width="680" height="44" as="geometry"/></mxCell><mxCell id="r05_t69" value="header" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8;fontColor=#0891B2;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="830" y="608" width="128" height="22" as="geometry"/></mxCell><mxCell id="r05_t70" value="entry" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8;fontColor=#0891B2;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="964" y="608" width="128" height="22" as="geometry"/></mxCell><mxCell id="r05_t71" value="entry" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8;fontColor=#0891B2;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1098" y="608" width="128" height="22" as="geometry"/></mxCell><mxCell id="r05_t72" value="entry" style=