acing=0;" vertex="1" parent="1"><mxGeometry x="980" y="330" width="240" height="18" as="geometry"/></mxCell><mxCell id="r04_t35" value="intset 仅纯整数；否则 ziplist / hashtable。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="980" y="352" width="240" height="58" as="geometry"/></mxCell><mxCell id="r04_t36" value="面试点：为什么不用一种结构打天下？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="980" y="448" width="240" height="50" as="geometry"/></mxCell><mxCell id="r04_p37" value="" style="rounded=1;arcSize=16;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1260" y="160" width="280" height="370" as="geometry"/></mxCell><mxCell id="r04_t38" value="ZSet" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1280" y="178" width="240" height="28" as="geometry"/></mxCell><mxCell id="r04_t39" value="排行榜 / 延时队列" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="1280" y="214" width="240" height="20" as="geometry"/></mxCell><mxCell id="r04_p40" value="" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1280" y="246" width="240" height="46" as="geometry"/></mxCell><mxCell id="r04_t41" value="ziplist → skiplist + dict" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="1288" y="254" width="224" height="30" as="g