动扩容 · 二进制安全" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="380" height="20" as="geometry"/></mxCell><mxCell id="r05_t11" value="空间预分配 + 惰性释放，减少 malloc/free；&#10;以 len 判断结尾，所以可以存图片、protobuf、序列化字节流。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="330" width="620" height="60" as="geometry"/></mxCell><mxCell id="r05_p12" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="740" height="330" as="geometry"/></mxCell><mxCell id="r05_t13" value="dict：渐进式 rehash，不一次性搬完" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="168" width="680" height="24" as="geometry"/></mxCell><mxCell id="r05_t14" value="扩容时同时保留 ht[0]（旧）和 ht[1]（新），用 rehashidx 游标分批搬迁。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="824" y="204" width="680" height="20" as="geometry"/></mxCell><mxCell id="r05_p15" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="250" height="110" as="geometry"/></mxCell><mxCell id="r05_t16" value="ht[0] · 旧表" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="844" y="260" width="220" height="20" as="geometry"/></mxCell><mxCell id="r05_p17" value="" style="rounded=1;arcSize=2;f