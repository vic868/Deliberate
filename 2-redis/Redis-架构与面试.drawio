" height="58" as="geometry"/></mxCell><mxCell id="r02_t49" value="面试第一问：Redis 为什么快？先答“纯内存 + 单线程免锁 + IO 多路复用”，再补“6.0 网络 IO 多线程，命令执行仍单线程”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.8;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="802" width="1420" height="34" as="geometry"/></mxCell><mxCell id="r02_p50" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="1480" height="72" as="geometry"/></mxCell><mxCell id="r02_t51" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="906" width="86" height="44" as="geometry"/></mxCell><mxCell id="r02_t52" value="Redis 的内部是一条单线程命令流水线：epoll 收请求 → 事件循环 → 查命令表 → 操作内存数据结构。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="176" y="902" width="1330" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="r03" name="03 单线程"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r03_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="7" height="54" as="geometry"/></mxCell><mxCell id="r03_title" value="单线程为什么快：一个人盯一万个 socket" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="36" width="1180" height="44" as="geometry"/></mxCell><mxCell id="r03_sub" value="纯内存 + 无锁 + IO 多路复用 + 事件驱动；命令执行仍是单线程，6.0 只是把网络读写多线程化。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="82" y="82" width="1330" height="24" as="geometry"/></mxCell><mxCell id="r03_num" value="03 / 12" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1"><mxGeometry x="1370" y="44" width="170" height="24" as="geometry"/></mxCell><mxCell id="r03_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="118" as="sourcePoint"/><mxPoint x="1540" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r03_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="1480" height="290" as="geometry"/></mxCell><mxCell id="r03_t2" value="事件循环：谁有数据就处理谁，不傻等" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#C81E1E;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="84" y="168" width="1400" height="24" as="geometry"/></mxCell><mxCell id="r03_b3" value="Client 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="210" width="120" height="44" as="geometry"/></mxCell><mxCell id="r03_a4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=1.1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y