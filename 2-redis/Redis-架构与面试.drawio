 vertex="1" parent="1"><mxGeometry x="88" y="254" width="224" height="30" as="geometry"/></mxCell><mxCell id="r04_t6" value="常用：SET / GET / INCR / SETNX" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="308" width="240" height="18" as="geometry"/></mxCell><mxCell id="r04_t7" value="场景：缓存、计数器、限流、锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="240" height="18" as="geometry"/></mxCell><mxCell id="r04_t8" value="INCR 单线程原子；值最大 512MB。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="352" width="240" height="58" as="geometry"/></mxCell><mxCell id="r04_t9" value="面试点：为什么不用一种结构打天下？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="448" width="240" height="50" as="geometry"/></mxCell><mxCell id="r04_p10" value="" style="rounded=1;arcSize=16;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="360" y="160" width="280" height="370" as="geometry"/></mxCell><mxCell id="r04_t11" value="Hash" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="380" y="178" width="240" height="28" as="geometry"/></mxCell><mxCell id="r04_t12" value="对象字段表" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1"><mxGeometry x="380" y="214" widt