<mxCell id="t313" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="license / license-files" vertex="1"><mxGeometry height="43" width="190" x="60" y="390" as="geometry" /></mxCell>
