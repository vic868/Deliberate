<mxCell id="t241" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="uv 自己的后端" vertex="1"><mxGeometry height="54" width="150" x="60" y="960" as="geometry" /></mxCell>
<mxCell id="t242" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="requires = [&quot;uv_build &gt;= 0.13, &lt;0.14&quot;]&#xa;build-backend = &quot;uv_build&quot;" vertex="1"><mxGeometry height="54" width="560" x="220" y="960" as="geometry" /></mxCell>
<mxCell id="t243" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="它支撑：包含/排除哪些文件进分发包、editable 安装行为、动态元数据、编译 C 扩展、打包共享库。具体配置看所选后端文档。" vertex="1"><mxGeometry height="26" width="720" x="60" y="1020" as="geometry" /></mxCell>
<mxCell id="t244" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · uv 的关键分支：有没有这张表，决定项目是不是「包」" vertex="1"><mxGeometry height="470" width="740" x="820" y="605" as="geometry" /></mxCell>
<mxCell id="t245" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="uv 检查 pyproject.toml 里有没有 [build-system] ?" vertex="1"><mxGeometry height="54" width="700" x="840" y="627" as="geometry" /></mxCell>
<mxCell id="t246" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="没有 → 只装依赖&#xa;不构建、不安装项目本身&#xa;src 布局与 scripts 全部失效" vertex="1"><mxGeometry height="100" width="335" x="840" y="710" as="geometry" /></mxCell>
<mxCell id="t247" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="有 → 构建并以 editable 装进 .venv&#xa;uv sync 会装项目，uv build 能出包&#xa;[tool.uv] package = true/false 可覆盖" vertex="1"><mxGeometry height="100" width="335" x="1205" y="710" as="geometry" /></mxCell>
<mxCell id="t248" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D06060;strokeWidth=1;" value="否" edge="1" source="t245" target="t246"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="t249" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" value="是" edge="1" source="t245" target="t247"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="t250" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="uv init --package（默认用 uv_build 后端） / --no-package（扁平非包项目） / --build-backend &lt;name&gt; 控制初始形态。" vertex="1"><mxGeometry height="28" width="700" x="840" y="822" as="geometry" /></mxCell>
<mxCell id="t251" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="⚠ 02-阶段二 §五 的样板从 [project] 开始，没有 [build-system]。&#xa;那是一份「配置清单」，还不是「可发布的包定义」。本篇专题 §八已给出补全版。" vertex="1"><mxGeometry height="100" width="700" x="840" y="858" as="geometry" /></mxCell>
<mxCell id="t252" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="第三方依赖包可以不写这张表（历史兼容，回退 setuptools.build_meta:__legacy__）；但自己的项目必须写。" vertex="1"><mxGeometry height="30" width="700" x="840" y="970" as="geometry" /></mxCell>
<mxCell id="t253" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;" value="官方原话：The [build-system] table should always be present, regardless of which build backend you use —— 因为它定义了构建工具。" vertex="1"><mxGeometry height="30" width="700" x="840" y="1005" as="geometry" /></mxCell>
</root>
