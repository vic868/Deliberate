<mxCell id="t227" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="要保留注释/格式地改写 → tomlkit" vertex="1"><mxGeometry height="50" width="340" x="1200" y="378" as="geometry" /></mxCell>
<mxCell id="t228" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="日常改配置：手工编辑，或让 uv add 帮你改" vertex="1"><mxGeometry height="50" width="700" x="840" y="440" as="geometry" /></mxCell>
<mxCell id="t229" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="PyPA 的 Dependency Groups 参考实现就是用 tomllib 解析 pyproject 再展开 include-group。" vertex="1"><mxGeometry height="50" width="700" x="840" y="505" as="geometry" /></mxCell>
<mxCell id="t230" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="Java 对照：TOML 本身 ≈ properties / YAML，但 pyproject.toml 承担的职责更像 pom.xml（坐标+依赖+插件配置）。" vertex="1"><mxGeometry height="24" width="700" x="840" y="558" as="geometry" /></mxCell>
<mxCell id="t231" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · [build-system]：两个字段 + 五种后端" vertex="1"><mxGeometry height="470" width="760" x="40" y="605" as="geometry" /></mxCell>
<mxCell id="t232" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#D06060;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="[build-system]&#xa;requires = [&quot;hatchling &gt;= 1.26&quot;]     # 构建时要装的包&#xa;build-backend = &quot;hatchling.build&quot;    # 后端的可导入路径" vertex="1"><mxGeometry height="80" width="720" x="60" y="627" as="geometry" /></mxCell>
<mxCell id="t233" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="Hatchling" vertex="1"><mxGeometry height="54" width="150" x="60" y="720" as="geometry" /></mxCell>
<mxCell id="t234" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="requires = [&quot;hatchling &gt;= 1.26&quot;]&#xa;build-backend = &quot;hatchling.build&quot;" vertex="1"><mxGeometry height="54" width="560" x="220" y="720" as="geometry" /></mxCell>
<mxCell id="t235" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="setuptools" vertex="1"><mxGeometry height="54" width="150" x="60" y="780" as="geometry" /></mxCell>
<mxCell id="t236" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="requires = [&quot;setuptools &gt;= 77.0.3&quot;]&#xa;build-backend = &quot;setuptools.build_meta&quot;" vertex="1"><mxGeometry height="54" width="560" x="220" y="780" as="geometry" /></mxCell>
<mxCell id="t237" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="Flit" vertex="1"><mxGeometry height="54" width="150" x="60" y="840" as="geometry" /></mxCell>
<mxCell id="t238" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="requires = [&quot;flit_core &gt;= 3.12.0, &lt;5&quot;]&#xa;build-backend = &quot;flit_core.buildapi&quot;" vertex="1"><mxGeometry height="54" width="560" x="220" y="840" as="geometry" /></mxCell>
