<mxCell id="t323" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="dependencies" vertex="1"><mxGeometry height="58" width="190" x="840" y="202" as="geometry" /></mxCell>
<mxCell id="t324" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="运行时必需依赖数组 → 进 wheel 的 METADATA（详见 ④）" vertex="1"><mxGeometry height="58" width="502" x="1038" y="202" as="geometry" /></mxCell>
<mxCell id="t325" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="optional-dependencies" vertex="1"><mxGeometry height="58" width="190" x="840" y="265" as="geometry" /></mxCell>
<mxCell id="t326" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="extras：pip install pkg[gui] / uv sync --extra gui；也进元数据" vertex="1"><mxGeometry height="58" width="502" x="1038" y="265" as="geometry" /></mxCell>
<mxCell id="t327" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="scripts / gui-scripts" vertex="1"><mxGeometry height="58" width="190" x="840" y="328" as="geometry" /></mxCell>
<mxCell id="t328" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="mycmd = &quot;pkg.cli:main&quot;；两者差别只在 Windows（gui 不弹终端）" vertex="1"><mxGeometry height="58" width="502" x="1038" y="328" as="geometry" /></mxCell>
<mxCell id="t329" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="entry-points" vertex="1"><mxGeometry height="58" width="190" x="840" y="391" as="geometry" /></mxCell>
<mxCell id="t330" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="插件机制，例 [project.entry-points.&quot;spam.magical&quot;]" vertex="1"><mxGeometry height="58" width="502" x="1038" y="391" as="geometry" /></mxCell>
<mxCell id="t331" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="dynamic" vertex="1"><mxGeometry height="58" width="190" x="840" y="454" as="geometry" /></mxCell>
<mxCell id="t332" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="[&quot;version&quot;] 等；name 永远不能 dynamic" vertex="1"><mxGeometry height="58" width="502" x="1038" y="454" as="geometry" /></mxCell>
<mxCell id="t333" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="Poetry 历史例外" vertex="1"><mxGeometry height="58" width="190" x="840" y="517" as="geometry" /></mxCell>
<mxCell id="t334" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="&lt; 2.0（2025-01-05 前）不读 [project]，只用 [tool.poetry]；2.0 起两者都支持" vertex="1"><mxGeometry height="58" width="502" x="1038" y="517" as="geometry" /></mxCell>
<mxCell id="t335" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=8;fontColor=#555555;" value="setuptools 同时兼容 [project] 与老的 setup.cfg / setup.py；新项目一律用 [project]。" vertex="1"><mxGeometry height="18" width="700" x="840" y="578" as="geometry" /></mxCell>
<mxCell id="t336" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 依赖字符串与入口的精确写法" vertex="1"><mxGeometry height="440" width="1020" x="40" y="615" as="geometry" /></mxCell>
<mxCell id="t337" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF7FD;strokeColor=#9B6BC7;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="# 依赖字符串的三种写法（PyPA 官方示例）&#xa;dependencies = [&#xa;  &quot;httpx&quot;,                              # 无约束&#xa;  &quot;gidgethub[httpx]&gt;4.0.0&quot;,            # extras + 版本约束&#xa;  &quot;django&gt;2.1; os_name != &#x27;nt&#x27;&quot;,       # 环境标记 marker&#xa;]" vertex="1"><mxGeometry height="120" width="980" x="60" y="657" as="geometry" /></mxCell>
<mxCell id="t338" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF7;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="# 命令行入口：装完直接敲 myapp&#xa;[project.scripts]&#xa;myapp = &quot;myapp.cli:main&quot;&#xa;&#xa;# 等价于：import sys; from myapp.cli import main; sys.exit(main())" vertex="1"><mxGeometry height="120" width="980" x="60" y="790" as="geometry" /></mxCell>
<mxCell id="t339" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#4A90D9;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="# static vs dynamic + urls 标签&#xa;[project]&#xa;name = &quot;myapp&quot;&#xa;dynamic = [&quot;version&quot;]&#xa;&#xa;[project.urls]&#xa;Homepage = &quot;https://example.com&quot;&#xa;&quot;Bug Tracker&quot; = &quot;https://example.com/issues&quot;" vertex="1"><mxGeometry height="118" width="980" x="60" y="923" as="geometry" /></mxCell>
<mxCell id="t340" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 三句话记住" vertex="1"><mxGeometry height="440" width="480" x="1080" y="615" as="geometry" /></mxCell>
<mxCell id="t341" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="① 谁读它？&#xa;构建后端读 [project]，&#xa;构建前端（pip/uv）读 [build-system]。" vertex="1"><mxGeometry height="100" width="440" x="1100" y="657" as="geometry" /></mxCell>
<mxCell id="t342" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="② 什么会进 wheel？&#xa;[project] 的字段会变成 METADATA；&#xa;dependency-groups 规范禁止进。" vertex="1"><mxGeometry height="100" width="440" x="1100" y="772" as="geometry" /></mxCell>
<mxCell id="t343" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="③ scripts 是什么？&#xa;把 python -m pkg.cli 变成系统命令 mycmd，&#xa;Java 对照就是 jar 清单的 Main-Class。" vertex="1"><mxGeometry height="100" width="440" x="1100" y="887" as="geometry" /></mxCell>
<mxCell id="t344" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[06-专题-__name__ 与程序入口]] §四 · [[02-阶段二-数据模型与工程化]] §五" vertex="1"><mxGeometry height="30" width="440" x="1100" y="1005" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="t4" name="④ 三种依赖声明辨析 ★">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="t41" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="pyproject.toml 全景（四）· 三种「依赖」到底放哪（补齐 05 面试题 13）" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="t42" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="PEP 621 dependencies / optional-dependencies  vs  PEP 735 dependency-groups · uv sync 文档" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="t43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="一句话判别：给「装你这个包的人」用 → dependencies；给「按功能可选的用户」用 → optional-dependencies（extras）；给「只在自己仓库开发」用 → dependency-groups。" vertex="1"><mxGeometry height="58" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="t44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 三列对照（最关键的一列：是否进包元数据）" vertex="1"><mxGeometry height="300" width="1520" x="40" y="170" as="geometry" /></mxCell>
<mxCell id="t45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="① project.dependencies" vertex="1"><mxGeometry height="46" width="480" x="60" y="212" as="geometry" /></mxCell>
<mxCell id="t46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="规范：PEP 621 / PEP 508&#xa;&#xa;✅ 会写进 wheel 的 METADATA&#xa;✅ 任何 pip install 你的包 都会装&#xa;✅ uv 默认同步&#xa;&#xa;内容：fastapi / httpx / pydantic&#xa;安装：自动" vertex="1"><mxGeometry height="180" width="480" x="60" y="266" as="geometry" /></mxCell>
<mxCell id="t47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="② project.optional-dependencies" vertex="1"><mxGeometry height="46" width="480" x="560" y="212" as="geometry" /></mxCell>
<mxCell id="t48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="规范：PEP 621（extras）&#xa;&#xa;✅ 进 METADATA（Provides-Extra）&#xa;✅ 用户显式勾选才装&#xa;❌ uv 默认不同步&#xa;&#xa;内容：gui = [&quot;PyQt5&quot;] / cli / all&#xa;安装：pip install pkg[gui]&#xa;        uv sync --extra gui" vertex="1"><mxGeometry height="180" width="480" x="560" y="266" as="geometry" /></mxCell>
<mxCell id="t49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="③ dependency-groups" vertex="1"><mxGeometry height="46" width="480" x="1060" y="212" as="geometry" /></mxCell>
<mxCell id="t410" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="规范：PEP 735（2024-10 通过）&#xa;&#xa;❌ 构建后端 MUST NOT 写进元数据&#xa;✅ 只有本仓库开发者用&#xa;✅ 仅 dev 组默认同步&#xa;&#xa;内容：pytest / ruff / mypy / sphinx&#xa;安装：uv sync · --no-dev · --group docs" vertex="1"><mxGeometry height="180" width="480" x="1060" y="266" as="geometry" /></mxCell>
<mxCell id="t411" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="为什么要有 ③：开发依赖不该污染发布包。PEP 735 把它定位成「requirements.txt 能力的标准化子集」，且明确禁止构建后端写进 sdist PKG-INFO / wheel METADATA。" vertex="1"><mxGeometry height="16" width="1480" x="60" y="452" as="geometry" /></mxCell>
<mxCell id="t412" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 一份文件里三者长这样" vertex="1"><mxGeometry height="285" width="760" x="40" y="485" as="geometry" /></mxCell>
<mxCell id="t413" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#4A90D9;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="[project]&#xa;dependencies = [&quot;fastapi&gt;=0.115&quot;, &quot;httpx&gt;=0.27&quot;]   # 运行时必需&#xa;&#xa;[project.optional-dependencies]        # 发布给用户的可选功能&#xa;cli = [&quot;rich&quot;, &quot;click&quot;]&#xa;all = [&quot;myapp[cli]&quot;]                    # 组合 extra，不用手抄一遍&#xa;&#xa;[dependency-groups]                    # 开发期，不进包元数据&#xa;dev = [&quot;pytest&gt;=8&quot;, &quot;ruff&quot;, &quot;mypy&quot;]&#xa;docs = [&quot;sphinx&quot;]&#xa;test = [&quot;pytest&gt;7&quot;, {include-group = &quot;dev&quot;}]" vertex="1"><mxGeometry height="225" width="720" x="60" y="527" as="geometry" /></mxCell>
<mxCell id="t414" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · PEP 735 细节 + uv 开关" vertex="1"><mxGeometry height="285" width="740" x="820" y="485" as="geometry" /></mxCell>
<mxCell id="t415" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="{include-group = &quot;dev&quot;} 是就地展开（等价把被引用组插到该位置），可嵌套但禁止成环，展开后不去重；组名会标准化比较（[-_.]+ → -，转小写），dev-group 与 dev_group 会被判重复；规范没定义安装语法，由工具提供；别让 group 名和 extra 名撞车。" vertex="1"><mxGeometry height="92" width="700" x="840" y="527" as="geometry" /></mxCell>
<mxCell id="t416" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF7;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="uv sync --no-dev                 # 生产镜像排除 dev 组&#xa;uv sync --only-dev               # 只装 dev，不装项目&#xa;uv sync --group docs --all-groups&#xa;uv sync --extra gui --all-extras&#xa;uv add --dev pytest               # 写进 dependency-groups 的 dev" vertex="1"><mxGeometry height="115" width="700" x="840" y="632" as="geometry" /></mxCell>
<mxCell id="t417" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=8;fontColor=#555555;" value="排除优先于包含：uv sync --no-group foo --group foo 的结果是不装 foo。extra 默认不同步，要 --extra / --all-extras。" vertex="1"><mxGeometry height="18" width="700" x="840" y="750" as="geometry" /></mxCell>
<mxCell id="t418" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 判别决策图：拿到一个包，先问三句" vertex="1"><mxGeometry height="275" width="1520" x="40" y="785" as="geometry" /></mxCell>
<mxCell id="t419" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="这个包，最终用户运行程序时必需吗？" vertex="1"><mxGeometry height="62" width="480" x="60" y="827" as="geometry" /></mxCell>
<mxCell id="t420" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="是 → project.dependencies&#xa;（fastapi / httpx / pydantic）" vertex="1"><mxGeometry height="80" width="480" x="60" y="915" as="geometry" /></mxCell>
<mxCell id="t421" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="是用户可选的功能才需要吗？" vertex="1"><mxGeometry height="62" width="480" x="560" y="827" as="geometry" /></mxCell>
<mxCell id="t422" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" value="是 → project.optional-dependencies&#xa;（gui / cli / all extras）" vertex="1"><mxGeometry height="80" width="480" x="560" y="915" as="geometry" /></mxCell>
<mxCell id="t423" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="只有我们开发、测试、构建时才用？" vertex="1"><mxGeometry height="62" width="480" x="1060" y="827" as="geometry" /></mxCell>
<mxCell id="t424" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="是 → dependency-groups&#xa;（pytest / ruff / mypy / sphinx）" vertex="1"><mxGeometry height="80" width="480" x="1060" y="915" as="geometry" /></mxCell>
<mxCell id="t425" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" value="命中" edge="1" source="t419" target="t420"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="t426" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" value="命中" edge="1" source="t421" target="t422"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="t427" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" value="命中" edge="1" source="t423" target="t424"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="t428" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="面试题 13 标准答案：dependencies 是运行时必需、会进 wheel METADATA、所有安装者都会被装；dependency-groups（PEP 735）是开发期依赖、规范禁止写进分发元数据、只服务本仓库。还有第三个位置 optional-dependencies 是给用户勾选的 extras，也会进元数据但 uv 默认不同步。" vertex="1"><mxGeometry height="44" width="1480" x="60" y="1005" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="t5" name="⑤ uv 全流程 · 踩坑 · 面试速答">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="t51" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="pyproject.toml 全景（五）· uv 全流程 / 三份产物 / src 布局 / 踩坑与面试速答" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="t52" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="uv docs：Project structure · Configuring projects · Locking and syncing · Building distributions" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="t53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 三份产物，别搞混（范围 → 精确版本 → 环境）" vertex="1"><mxGeometry height="210" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="t54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="pyproject.toml&#xa;你手写 / uv add 修改&#xa;声明范围（宽泛约束）&#xa;✅ 进 Git" vertex="1"><mxGeometry height="120" width="480" x="60" y="140" as="geometry" /></mxCell>
<mxCell id="t55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="uv.lock&#xa;uv 自动生成&#xa;精确解析结果；跨平台 universal&#xa;覆盖所有 OS/架构/Python marker&#xa;✅ 进 Git · ❌ 不要手改" vertex="1"><mxGeometry height="120" width="480" x="560" y="140" as="geometry" /></mxCell>
<mxCell id="t56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value=".venv/&#xa;uv 自动创建&#xa;项目环境，自带内部 .gitignore&#xa;❌ 不进 Git" vertex="1"><mxGeometry height="120" width="480" x="1060" y="140" as="geometry" /></mxCell>
<mxCell id="t57" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" value="uv lock / uv run 自动解析" edge="1" source="t54" target="t55"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="t58" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" value="uv sync 按锁安装" edge="1" source="t55" target="t56"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="t59" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="uv.lock 是人类可读的 TOML，但格式是 uv 私有、由 uv 管理（官方：should not be edited manually）；要标准化用 uv export -o pylock.toml（PEP 751）。" vertex="1"><mxGeometry height="26" width="1480" x="60" y="272" as="geometry" /></mxCell>
<mxCell id="t510" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 命令地图" vertex="1"><mxGeometry height="440" width="760" x="40" y="323" as="geometry" /></mxCell>
<mxCell id="t511" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv init myapp --package" vertex="1"><mxGeometry height="33" width="330" x="60" y="363" as="geometry" /></mxCell>
<mxCell id="t512" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="建项目；--no-package 建扁平非包项目，--build-backend 选后端" vertex="1"><mxGeometry height="33" width="382" x="398" y="363" as="geometry" /></mxCell>
<mxCell id="t513" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv add fastapi httpx" vertex="1"><mxGeometry height="33" width="330" x="60" y="399" as="geometry" /></mxCell>
<mxCell id="t514" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="加运行依赖，同时写 pyproject 并更新 lock" vertex="1"><mxGeometry height="33" width="382" x="398" y="399" as="geometry" /></mxCell>
<mxCell id="t515" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv add --dev pytest ruff" vertex="1"><mxGeometry height="33" width="330" x="60" y="435" as="geometry" /></mxCell>
<mxCell id="t516" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="加进 dependency-groups 的 dev 组" vertex="1"><mxGeometry height="33" width="382" x="398" y="435" as="geometry" /></mxCell>
<mxCell id="t517" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv run pytest" vertex="1"><mxGeometry height="33" width="330" x="60" y="471" as="geometry" /></mxCell>
<mxCell id="t518" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="隔离环境里跑；执行前自动 lock + sync（inexact）" vertex="1"><mxGeometry height="33" width="382" x="398" y="471" as="geometry" /></mxCell>
<mxCell id="t519" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv sync" vertex="1"><mxGeometry height="33" width="330" x="60" y="507" as="geometry" /></mxCell>
<mxCell id="t520" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="显式同步；默认 exact（删多余包），--inexact 保留" vertex="1"><mxGeometry height="33" width="382" x="398" y="507" as="geometry" /></mxCell>
<mxCell id="t521" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv lock / uv lock --check" vertex="1"><mxGeometry height="33" width="330" x="60" y="543" as="geometry" /></mxCell>
<mxCell id="t522" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="生成锁 / 只检查是否过期（CI 卡口）" vertex="1"><mxGeometry height="33" width="382" x="398" y="543" as="geometry" /></mxCell>
<mxCell id="t523" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="--locked / --frozen / --no-sync" vertex="1"><mxGeometry height="33" width="330" x="60" y="579" as="geometry" /></mxCell>
<mxCell id="t524" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="锁过期报错 / 不检查直接用锁 / 不检查环境" vertex="1"><mxGeometry height="33" width="382" x="398" y="579" as="geometry" /></mxCell>
<mxCell id="t525" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv lock --upgrade" vertex="1"><mxGeometry height="33" width="330" x="60" y="615" as="geometry" /></mxCell>
<mxCell id="t526" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="显式升级；有新版本发布不会让锁自动过期" vertex="1"><mxGeometry height="33" width="382" x="398" y="615" as="geometry" /></mxCell>
<mxCell id="t527" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv build / uv publish" vertex="1"><mxGeometry height="33" width="330" x="60" y="651" as="geometry" /></mxCell>
<mxCell id="t528" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="出 dist/*.whl + *.tar.gz / 上传索引" vertex="1"><mxGeometry height="33" width="382" x="398" y="651" as="geometry" /></mxCell>
<mxCell id="t529" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="uv export --format requirements.txt" vertex="1"><mxGeometry height="33" width="330" x="60" y="687" as="geometry" /></mxCell>
<mxCell id="t530" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="导出给非 uv 工具链（也支持 pylock.toml / CycloneDX）" vertex="1"><mxGeometry height="33" width="382" x="398" y="687" as="geometry" /></mxCell>
<mxCell id="t531" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="uv build 只是 build frontend（PEP 517）：决定用哪个 Python 并调用后端；包含哪些文件、产物命名由 [build-system] 指定的后端决定。先 sdist 再从它构建 wheel。" vertex="1"><mxGeometry height="30" width="720" x="60" y="726" as="geometry" /></mxCell>
<mxCell id="t532" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · src 布局（面试题 14）+ 打包发布" vertex="1"><mxGeometry height="440" width="740" x="820" y="323" as="geometry" /></mxCell>
<mxCell id="t533" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF7FD;strokeColor=#9B6BC7;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="myapp/&#xa;├── pyproject.toml&#xa;├── src/myapp/          ← 包代码藏一层&#xa;│   ├── __init__.py&#xa;│   └── cli.py&#xa;└── tests/" vertex="1"><mxGeometry height="135" width="700" x="840" y="365" as="geometry" /></mxCell>
<mxCell id="t534" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="三条理由：① 逼你先 editable install 再测试，避免「本地能跑、装完就崩」；② 避免同名模块遮蔽（json.py 盖掉标准库，见 06 专题坑 6）；③ 包代码 / tests / 脚本干净分层。" vertex="1"><mxGeometry height="88" width="700" x="840" y="512" as="geometry" /></mxCell>
<mxCell id="t535" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="前提：[build-system] 必须存在，否则 uv 根本不会安装项目，src 布局就白做了。" vertex="1"><mxGeometry height="52" width="700" x="840" y="612" as="geometry" /></mxCell>
<mxCell id="t536" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF7;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="uv build&#xa;  → dist/example-0.1.0-py3-none-any.whl&#xa;  → dist/example-0.1.0.tar.gz&#xa;uv publish                    # 上传 PyPI 等索引" vertex="1"><mxGeometry height="78" width="700" x="840" y="676" as="geometry" /></mxCell>
<mxCell id="t537" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 踩坑清单 + 面试速答" vertex="1"><mxGeometry height="340" width="1520" x="40" y="778" as="geometry" /></mxCell>
<mxCell id="t538" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=9;align=center;verticalAlign=middle;" value="① 漏 [build-system] → uv 只装依赖不装项目，scripts / src 全失效（02 样板即如此）" vertex="1"><mxGeometry height="39" width="900" x="60" y="820" as="geometry" /></mxCell>
<mxCell id="t539" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=9;align=center;verticalAlign=middle;" value="② 双真源：17-FastAPI 真实事故 —— uv sync 装 fastapi-limiter 0.2.x，pip -r requirements.txt 冻结 0.1.6，在 FastAPI ≥0.141 启动失败" vertex="1"><mxGeometry height="39" width="900" x="60" y="863" as="geometry" /></mxCell>
<mxCell id="t540" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="③ 把 pytest/ruff 写进 dependencies → 被装进生产镜像且污染 wheel 元数据" vertex="1"><mxGeometry height="39" width="900" x="60" y="906" as="geometry" /></mxCell>
<mxCell id="t541" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="④ group 名与 extra 名撞车 → PEP 735 建议避免，部分工具报错" vertex="1"><mxGeometry height="39" width="900" x="60" y="949" as="geometry" /></mxCell>
<mxCell id="t542" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="⑤ 改了 pyproject 配置不生效 → 可能有 .ruff.toml / mypy.ini 优先级更高，或忘了 uv sync" vertex="1"><mxGeometry height="39" width="900" x="60" y="992" as="geometry" /></mxCell>
<mxCell id="t543" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="⑥ 手改 uv.lock / 用 {file=...} 旧 license 格式 / requires-python 写上界 / 混淆 .python-version" vertex="1"><mxGeometry height="39" width="900" x="60" y="1035" as="geometry" /></mxCell>
<mxCell id="t544" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="Q13 dependencies vs dependency-groups？&#xa;A：前者运行时必需、进 wheel METADATA、所有安装者都装；后者 PEP 735 开发期依赖、规范禁止写进分发元数据。另有第三个位置 optional-dependencies = 给用户勾选的 extras，也进元数据但 uv 默认不同步。" vertex="1"><mxGeometry height="120" width="560" x="980" y="820" as="geometry" /></mxCell>
<mxCell id="t545" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="Q14 为什么推荐 src 布局？&#xa;A：扁平布局下项目根就在 sys.path，测试直接 import 源码，掩盖打包遗漏与相对导入错误；src 把包藏一层，必须先 editable install 才能 import，测试跑的是真实安装结果。附带避免同名模块遮蔽、分层干净。" vertex="1"><mxGeometry height="120" width="560" x="980" y="952" as="geometry" /></mxCell>
<mxCell id="t546" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[17-专题-pyproject.toml 全景]]（本篇 md 版）· [[02-阶段二-数据模型与工程化]] · [[05-阶段五-项目实战与验收]] · [[06-专题-__name__ 与程序入口]] · [[00-FastApiAdmin-项目总览]]" vertex="1"><mxGeometry height="26" width="1480" x="60" y="1090" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
