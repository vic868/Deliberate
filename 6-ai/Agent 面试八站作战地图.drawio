  <diagram name="04-推理范式与选型" id="04-推理范式与选型">
    <mxGraphModel dx="1644" dy="1195" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#111827;" value="第 5 站：三种推理范式与选型决策" vertex="1">
          <mxGeometry height="42" width="1200" x="60" y="22" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" value="&lt;b&gt;ReAct&lt;/b&gt;" vertex="1">
          <mxGeometry height="56" width="400" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=top;dashed=0;fontColor=#1f2937;arcSize=8;" value="&lt;b&gt;边走边看&lt;/b&gt;：走一步看一步&lt;br/&gt;· Thought / Action / Observation 交替&lt;br/&gt;· 适应未知环境，纠错快&lt;br/&gt;· 弱点：局部贪心，每步只看眼前最优&lt;br/&gt;· 三道保险：步数上限 / 循环检测 / 超时熔断" vertex="1">
          <mxGeometry height="214" width="400" x="60" y="166" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" value="&lt;b&gt;Plan-and-Execute&lt;/b&gt;" vertex="1">
          <mxGeometry height="56" width="400" x="500" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=top;dashed=0;fontColor=#1f2937;arcSize=8;" value="&lt;b&gt;先画地图&lt;/b&gt;：再出发&lt;br/&gt;· 强模型规划 + 轻模型执行，成本更低&lt;br/&gt;· 核心配套：动态重规划（回灌规划器）&lt;br/&gt;· ReWOO：一次排完所有调用，worker 并行&lt;br/&gt;· 前提：工具无依赖且都能确定成功" vertex="1">
          <mxGeometry height="214" width="400" x="500" y="166" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" value="&lt;b&gt;Reflexion&lt;/b&gt;" vertex="1">
          <mxGeometry height="56" width="400" x="940" y="110" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=top;dashed=0;fontColor=#1f2937;arcSize=8;" value="&lt;b&gt;自审 + 错题本&lt;/b&gt;：挂在循环外的 Buff&lt;br/&gt;· 不是另一种循环，是循环外的一层&lt;br/&gt;· 每轮多 1~3 次调用，必须封顶&lt;br/&gt;· retry 是原样再来，reflection 是改了打法&lt;br/&gt;· 与多 Agent critic 的区别：自己审 vs 别人审" vertex="1">
