        <mxCell id="c18" value="工程底线：模型只决定「调什么工具、传什么参数」，&lt;b&gt;真正执行的是你的代码&lt;/b&gt;。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#b91c1c;" vertex="1" parent="1"><mxGeometry x="780" y="520" width="760" height="60" as="geometry"/></mxCell>
