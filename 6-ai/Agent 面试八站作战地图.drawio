        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#ca8a04;endArrow=block;endFill=1;dashed=1;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c5" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c11" value="循环上的三种变体" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;CoT 思维链&lt;/b&gt;&lt;br/&gt;只在脑子里想，容易想歪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="190" width="380" height="80" as="geometry"/></mxCell>
