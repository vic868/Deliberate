        <mxCell id="c2" value="&lt;b&gt;LLM 模型&lt;/b&gt;&lt;br/&gt;推理 / 决策 / 生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="190" y="120" width="300" height="100" as="geometry"/></mxCell>
