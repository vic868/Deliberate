  <diagram name="01-八站全景" id="01-八站全景">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="Agent 面试八站作战地图" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="900" height="46" as="geometry"/></mxCell>
        <mxCell id="c2" value="一条主线：从「它是什么」一路推到「30 秒讲清我的项目」" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="62" y="74" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;第 1 站  概念与边界&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Agent = 会调用工具的循环系统&lt;br/&gt;三判句定生死" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;第 2 站  架构五件套&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;模型是大脑，Harness 是脊椎&lt;br/&gt;上线就崩多半是脊椎塌了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;第 3 站  核心循环&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Thought → Action → Observation&lt;br/&gt;上下文在循环里累积" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="920" y="140" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;第 4 站  工具与协议&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;FC 是模型层能力，MCP 是生态层标准&lt;br/&gt;M×N 变 M+N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1340" y="140" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;第 5 站  推理范式&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;ReAct 地基 / P&amp;E 全局 / Reflexion 自审&lt;br/&gt;选型看能否预判步骤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1340" y="470" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;第 6 站  记忆与上下文&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;三层记忆 + 四招压缩&lt;br/&gt;上下文越少越准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="920" y="470" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;第 7 站  多智能体与 RAG&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;三种编排 · 15 倍成本&lt;br/&gt;能不用就不用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;第 8 站  生产化与实战&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;四种死法 · 兜底四层 · 评测闭环&lt;br/&gt;简单 可衡量 可持续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="300" height="130" as="geometry"/></mxCell>
