        <mxCell id="c5" value="&lt;b&gt;上下文墙&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;每轮 Observation 都追加&lt;br/&gt;下一轮看到的是整面墙&lt;br/&gt;不只是最新一张" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="230" height="364" as="geometry"/></mxCell>
