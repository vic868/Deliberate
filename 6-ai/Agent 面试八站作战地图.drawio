  <diagram name="04-推理范式与选型" id="04-推理范式与选型">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="第 5 站：三种推理范式与选型决策" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="22" width="1200" height="42" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;ReAct&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;边走边看&lt;/b&gt;：走一步看一步&lt;br/&gt;· Thought / Action / Observation 交替&lt;br/&gt;· 适应未知环境，纠错快&lt;br/&gt;· 弱点：局部贪心，每步只看眼前最优&lt;br/&gt;· 三道保险：步数上限 / 循环检测 / 超时熔断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=top;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="166" width="400" height="214" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Plan-and-Execute&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;先画地图&lt;/b&gt;：再出发&lt;br/&gt;· 强模型规划 + 轻模型执行，成本更低&lt;br/&gt;· 核心配套：动态重规划（回灌规划器）&lt;br/&gt;· ReWOO：一次排完所有调用，worker 并行&lt;br/&gt;· 前提：工具无依赖且都能确定成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=top;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="166" width="400" height="214" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Reflexion&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;自审 + 错题本&lt;/b&gt;：挂在循环外的 Buff&lt;br/&gt;· 不是另一种循环，是循环外的一层&lt;br/&gt;· 每轮多 1~3 次调用，必须封顶&lt;br/&gt;· retry 是原样再来，reflection 是改了打法&lt;br/&gt;· 与多 Agent critic 的区别：自己审 vs 别人审" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=top;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="166" width="400" height="214" as="geometry"/></mxCell>
        <mxCell id="c8" value="选型决策树（可以直接背）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="c9" value="步骤能不能&lt;br/&gt;提前预判？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;Plan-and-Execute&lt;/b&gt;&lt;br/&gt;先规划后执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;ReAct&lt;/b&gt;&lt;br/&gt;边查边定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c14" value="错了&lt;br/&gt;代价大不大？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;叠加 Reflexion&lt;/b&gt;&lt;br/&gt;自审 + 错题本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="440" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="c18" value="就到这里" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="570" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c21" value="能" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="344" y="484" width="30" height="22" as="geometry"/></mxCell>
        <mxCell id="c22" value="不能" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="338" y="546" width="40" height="22" as="geometry"/></mxCell>
        <mxCell id="c23" value="大" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="962" y="484" width="24" height="22" as="geometry"/></mxCell>
        <mxCell id="c24" value="不大" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="958" y="546" width="34" height="22" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;例外：简单任务&lt;/b&gt;&lt;br/&gt;查个股价就别拆五步&lt;br/&gt;纯浪费时间和 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1030" y="700" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;工业界真实做法&lt;/b&gt;&lt;br/&gt;先用 ReAct 跑通业务 → 看步数 / 延迟 / 出错率的数据 → 按需升级到 P&amp;amp;E 或叠加 Reflexion。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="900" height="90" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b&gt;一句话切开 ReAct 与 CoT&lt;/b&gt;&lt;br/&gt;CoT 只在脑子里想；ReAct 每做一步就收回一条真实观察。&lt;br/&gt;区别在于&lt;b&gt;是否引入外部环境反馈&lt;/b&gt;。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="900" height="90" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;代价必须主动说&lt;/b&gt;&lt;br/&gt;Reflexion 每轮多 1~3 次调用&lt;br/&gt;无限反思 = 无限烧钱，计数器必须封顶" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1360" y="690" width="300" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="05-生产化兜底与安全" id="05-生产化兜底与安全">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="第 8 站：生产化 —— 兜底四层与安全四护栏" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="60" y="22" width="1200" height="42" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;④ 消费层&lt;/b&gt;　下游不认输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c3" value="兜底：适配层 / 告警 / 转人工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;③ 模型层&lt;/b&gt;　幻觉、格式错、校验失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c5" value="兜底：改 prompt / 回退备用模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;② 推理层&lt;/b&gt;　工具出错" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="370" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c7" value="兜底：换工具 / 跳过 / 返回默认值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="370" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;① 调用层&lt;/b&gt;　网络超时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="c9" value="兜底：重试 / 熔断 / 降级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="500" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="e10" value="向上传导" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#94a3b8;endArrow=block;endFill=1;dashed=1;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#94a3b8;endArrow=block;endFill=1;dashed=1;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#94a3b8;endArrow=block;endFill=1;dashed=1;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c13" value="四道护栏（防提示词注入）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;① 不可信数据隔离&lt;/b&gt;&lt;br/&gt;独立 Guard 检测层，与主模型不同上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;② 最小权限&lt;/b&gt;&lt;br/&gt;按任务给权限；只读订单就别给改价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;③ 沙箱执行&lt;/b&gt;&lt;br/&gt;高风险动作隔离运行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="350" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;④ 高风险操作人工确认&lt;/b&gt;&lt;br/&gt;大额退款必须人点头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c21" value="12 字真经：&lt;b&gt;权限最小 · 输入消毒 · 输出审计&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#b91c1c;" vertex="1" parent="1"><mxGeometry x="900" y="550" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="c22" value="提示词不负责安全，系统才负责安全。OWASP：83% 的 Agent 系统存在注入漏洞。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="900" y="600" width="720" height="60" as="geometry"/></mxCell>
        <mxCell id="c23" value="上线翻车四种死法" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="700" height="34" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;死循环&lt;/b&gt;：同一失败动作反复重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c25" value="步数上限 + 循环检测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="680" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;幻觉参数&lt;/b&gt;：工具入参全是编的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="746" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c27" value="入参强校验 schema，不认识直接拒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="746" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;越权&lt;/b&gt;：该只读的能改价转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="812" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c29" value="权限白名单 + 最小权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="812" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b&gt;级联失败&lt;/b&gt;：一个环节错全链路错" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="878" width="400" height="56" as="geometry"/></mxCell>
        <mxCell id="c31" value="交接处设错误边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="878" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;评测三件套&lt;/b&gt;&lt;br/&gt;真实日志数据集 → 分层指标（错误按严重级别分桶）→ golden set 回归&lt;br/&gt;改动即跑，掉阈值就回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="720" height="90" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;上线不是终点&lt;/b&gt;&lt;br/&gt;bad case → 分析 → 定位 → 优化 → 回归验证&lt;br/&gt;稳定是迭代出来的，不是一次设计出来的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="770" width="720" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
