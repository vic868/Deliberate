        <mxCell id="c18" value="&lt;b&gt;Offer&lt;/b&gt;&lt;br/&gt;原理能推导 · 组件能画图&lt;br/&gt;系统能落地 · 坏 case 能复盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#15803d;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="690" y="730" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#15803d;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c20" value="答题总纲：&lt;b&gt;简单、可衡量、可持续&lt;/b&gt; —— 用能可靠解决问题的最简单架构，把效果变成数字，让系统可被持续迭代。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="82" y="872" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="c21" value="配套阅读：笔记《Agent 面试八站图文精编》 / 逐字稿原文" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="82" y="915" width="900" height="30" as="geometry"/></mxCell>
