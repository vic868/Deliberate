        <mxCell id="c4" value="&lt;b&gt;Tools 工具&lt;/b&gt;&lt;br/&gt;与真实世界交互" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="950" y="120" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Memory 记忆&lt;/b&gt;&lt;br/&gt;短期上下文 / 长期资产" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1290" y="120" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="c6" value="大脑层：决定「想什么」" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="190" y="228" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="c7" value="能力层：决定「能和什么交互」" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1130" y="228" width="520" height="26" as="geometry"/></mxCell>
        <mxCell id="c8" value="脊椎：Harness 运行时 —— 最容易被漏掉，也是「demo 能跑、上线就崩」的主因" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#b91c1c;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="1300" height="32" as="geometry"/></mxCell>
        <mxCell id="c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="306" width="1520" height="214" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;循环调度&lt;/b&gt;&lt;br/&gt;决定下一轮做什么" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="100" y="372" width="330" height="112" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;上下文管理&lt;/b&gt;&lt;br/&gt;压缩 / 外置 / 隔离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="475" y="372" width="330" height="112" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;工具执行&lt;/b&gt;&lt;br/&gt;真正调用 · 参数校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="850" y="372" width="330" height="112" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;错误恢复&lt;/b&gt;&lt;br/&gt;重试 / 熔断 / 降级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1225" y="372" width="330" height="112" as="geometry"/></mxCell>
        <mxCell id="e14" value="决策" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="拆解" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=0;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c12" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="再来一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;endArrow=block;endFill=1;dashed=1;fontSize=12;fontColor=#475569;horizontal=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c18" value="讲架构的话术：按「大脑 / 脊椎」的层级讲，比干巴巴报组件清单高一个段位。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="62" y="560" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="c19" value="常见坑｜&lt;b&gt;只换更强模型，不修脊椎&lt;/b&gt;：没有步数上限、没有循环检测、没有超时熔断、没有结构化错误回传。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#f87171;strokeWidth=2;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontColor=#1f2937;arcSize=8;" vertex="1" parent="1"><mxGeometry x="62" y="610" width="1000" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
