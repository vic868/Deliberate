  </diagram>
  <diagram id="b3" name="③ 构建篇 · 第 2–6 章">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b31" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="深入理解 AI Agent · 全书知识地图（三）· 构建篇 第 2–6 章" vertex="1">
          <mxGeometry height="40" width="1520" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="b32" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 02~06 章节笔记｜PDF p38–191 / 印刷 p30–183" vertex="1">
          <mxGeometry height="26" width="1520" x="40" y="62" as="geometry" />
        </mxCell>
        <mxCell id="b33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" value="五章都在改「模型之外」：先管好单次调用送进去什么（2），再持久化到跨会话（3），然后设计能力形态（4）、组装成通用 Agent（5），最后打破回合制（6）。贯穿线索：上下文是眼睛、工具是手脚，扩展它们比换模型更有效。" vertex="1">
          <mxGeometry height="58" width="1520" x="40" y="98" as="geometry" />
        </mxCell>
        <mxCell id="b34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 五章地图：每章回答一个问题" vertex="1">
          <mxGeometry height="390" width="1520" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="b35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="第 2 章 上下文工程&#xa;p38–80&#xa;Q：每次 API 调用实际送进去什么？&#xa;&#xa;四种角色：system / user / assistant / tool。&#xa;关键性质：每次调用无状态，所有信息必须在 messages 里完整提供。&#xa;&#xa;静态前缀 → KV Cache（模型内部）vs Prompt Cache（API 层）。&#xa;Skills 元数据常驻 + 正文按需；状态栏把隐式状态显式化。&#xa;压缩：分层压缩、保留决策/约束/失败/来源；§2.7.6 隔离优于压缩。" vertex="1">
          <mxGeometry height="250" width="280" x="60" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="第 3 章 记忆与知识库&#xa;p81–110&#xa;Q：怎么跨会话留住知识？&#xa;&#xa;双层记忆：Advanced JSON Cards 常驻概览 + 上下文感知检索取细节。&#xa;记忆不存每句对话，用额外 LLM 调用提取、压缩、审查。&#xa;&#xa;三维度：放哪里（层次）/ 怎么存（格式）/ 存什么（内容类型）。&#xa;RAG 流水线：分块 → 稠密/稀疏嵌入 → 融合 → Rerank → 生成。&#xa;本章小结：跳过来源、时间、冲突、隐私检查就不能写入。" vertex="1">
          <mxGeometry height="250" width="280" x="358" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="第 4 章 工具&#xa;p111–129&#xa;Q：能力做成什么形式、一次让模型看多少？&#xa;&#xa;ACI：工具对应 Agent 的目标，而非底层 API 端点（对标 HCI）。&#xa;能力表达是一条谱系：专用工具 / 细粒度工具 / 代码 / Skill。&#xa;&#xa;两条分发渠道（MCP、Skill Hub）都扩大信任边界：审描述与版本、隔离凭证、参数一致。&#xa;工具爆炸：&gt;100 个易选错；5 个 MCP 服务器可能吃掉数万 token。" vertex="1">
          <mxGeometry height="250" width="280" x="656" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=9;align=center;verticalAlign=middle;" value="第 5 章 Coding Agent&#xa;p130–161&#xa;Q：通用 Agent 怎么组装？&#xa;&#xa;答案 = Coding Agent（自主写/改/执行代码）+ 文件系统（工作空间）。&#xa;代码是形式化思考与精确表达的语言，是能创造其他能力的元能力。&#xa;&#xa;代码任务可验证性最强 → 最能受益于 Harness 五要素。&#xa;故障恢复三问：有哪些故障 / 怎么检测恢复 / 何时必须终止。&#xa;致命三要素 + 第四个：持久记忆。" vertex="1">
          <mxGeometry height="250" width="280" x="954" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="第 6 章 交互扩展&#xa;p162–191&#xa;Q：世界在 Agent 思考时是静止的吗？&#xa;&#xa;关键判断：回合制是交互约定，不是环境的性质。&#xa;两根轴：模态（文本 / 语音 / 视觉 / 物理）× 时机（同步 / 异步）。&#xa;&#xa;骨架是事件循环：每轮取若干事件追加轨迹再调一次 LLM。&#xa;语音三范式 + 认知时序（前台快模型 / 后台慢模型）。&#xa;Computer Use：SoM / DOM 索引把开放坐标转成封闭 ID；VLA 进物理世界。" vertex="1">
          <mxGeometry height="250" width="280" x="1252" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b310" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="b35" target="b36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b311" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="b36" target="b37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b312" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="b37" target="b38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b313" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="b38" target="b39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b314" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;" value="⚠ 结构提醒（第 1 章 1.2.6）：第 6 章不属于 Harness 五要素。五要素管「怎么组织已有的上下文与工具」，第 6 章扩展的是观察 / 动作空间本身的模态与触发时机 —— 它依赖异步运行时，是另一条正交的轴。" vertex="1">
          <mxGeometry height="56" width="1480" x="60" y="470" as="geometry" />
        </mxCell>
        <mxCell id="b315" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 上下文链路（第 2 章的四块地基）" vertex="1">
          <mxGeometry height="290" width="760" x="40" y="575" as="geometry" />
        </mxCell>
        <mxCell id="b316" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="无状态调用 + 四种角色&#xa;system 最高优先级、通常一条、放最前；assistant 可含 reasoning / content / tool_calls。&#xa;Chat Template 把 JSON 消息序列化成带特殊标记的 token 流，决定多轮工具调用能否正确工作。" vertex="1">
          <mxGeometry height="103" width="330" x="60" y="617" as="geometry" />
        </mxCell>
        <mxCell id="b317" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="静态前缀 = 架构约束&#xa;KV Cache 在模型内部复用注意力状态；Prompt Cache 在 API 层按前缀计费。&#xa;历史思考保留策略各家不同（Qwen3 / DeepSeek R1 / V4），顺序一变缓存全废。" vertex="1">
          <mxGeometry height="103" width="330" x="430" y="617" as="geometry" />
        </mxCell>
        <mxCell id="b318" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=9;align=center;verticalAlign=middle;" value="渐进式披露：Skills&#xa;领域能力的可组合单元：SKILL.md 元数据常驻、正文按需加载。&#xa;第 4 章 4.4.3 换个角度，把 Skills 视作一种工具发现范式。" vertex="1">
          <mxGeometry height="103" width="330" x="60" y="730" as="geometry" />
        </mxCell>
        <mxCell id="b319" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=9;align=center;verticalAlign=middle;" value="状态栏与压缩&#xa;cwd / git 分支 / 未暂存变更 / 工具计数器写进上下文；动态状态放错位置会持续破坏前缀。&#xa;§2.7.2 强论断：上下文学习的内部机制是检索而非推理。" vertex="1">
          <mxGeometry height="103" width="330" x="430" y="730" as="geometry" />
        </mxCell>
        <mxCell id="b320" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 能力形态与工具治理（第 4–5 章）" vertex="1">
          <mxGeometry height="290" width="740" x="820" y="575" as="geometry" />
        </mxCell>
        <mxCell id="b321" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="ACI 谱系：deploy_app 专用工具 ↔ 拆成构建/打包/部署细工具 ↔ 让 Agent 写代码完成" vertex="1">
          <mxGeometry height="52" width="700" x="840" y="617" as="geometry" />
        </mxCell>
        <mxCell id="b322" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="两条分发渠道：MCP（工具协议）/ Skill Hub（能力包）；都需审查描述与版本、隔离凭证" vertex="1">
          <mxGeometry height="52" width="700" x="840" y="675" as="geometry" />
        </mxCell>
        <mxCell id="b323" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="工具爆炸四级递进：层次化组织 + 按需加载 → 检索式预筛选 → 主动发现 → 动态加载" vertex="1">
          <mxGeometry height="52" width="700" x="840" y="733" as="geometry" />
        </mxCell>
        <mxCell id="b324" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=9;align=center;verticalAlign=middle;" value="Coding Agent 元能力六个方向；反复用「提议者—审核者」，风险是 Reviewer 审美偏离目标用户" vertex="1">
          <mxGeometry height="52" width="700" x="840" y="791" as="geometry" />
        </mxCell>
        <mxCell id="b325" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 第 6 章：模态 × 时机的四种展开" vertex="1">
          <mxGeometry height="170" width="1520" x="40" y="880" as="geometry" />
        </mxCell>
        <mxCell id="b326" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="异步 / 事件驱动&#xa;长期运行的 event loop；Open Claw 用 Gateway 控制平面 + Hooks 路由多渠道消息" vertex="1">
          <mxGeometry height="80" width="350" x="60" y="922" as="geometry" />
        </mxCell>
        <mxCell id="b327" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="语音三范式&#xa;说话约为打字 4 倍且不占双手视线；认知时序把「交互表现」与「智能上限」拆成两个维度" vertex="1">
          <mxGeometry height="80" width="350" x="430" y="922" as="geometry" />
        </mxCell>
        <mxCell id="b328" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="屏幕 / Computer Use&#xa;视觉定位 Grounding：SoM / DOM 索引把坐标预测转成封闭 ID；动作后仍需新观察判定完成" vertex="1">
          <mxGeometry height="80" width="350" x="800" y="922" as="geometry" />
        </mxCell>
        <mxCell id="b329" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="物理世界 / VLA&#xa;硬件与算法分工 → 控制结构 → 长程规划 → 视觉-语言-动作模型" vertex="1">
          <mxGeometry height="80" width="350" x="1170" y="922" as="geometry" />
        </mxCell>
        <mxCell id="b330" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="四节共享同一条控制骨架：观察进入轨迹 → 决策 → 动作 → 环境变化；而最终是否完成，仍必须由新的观察来判定。" vertex="1">
          <mxGeometry height="26" width="1480" x="60" y="1008" as="geometry" />
        </mxCell>
        <mxCell id="b331" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[02-第2章 上下文工程]] · [[03-第3章 用户记忆和知识库]] · [[04-第4章 工具]] · [[05-第5章 Coding Agent 与通用 Agent]] · [[06-第6章 交互与动作空间扩展]]" vertex="1">
          <mxGeometry height="24" width="1480" x="60" y="1050" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
