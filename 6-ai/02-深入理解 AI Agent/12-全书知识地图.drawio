        <mxCell id="b43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" value="能力悖论：Agent 能零样本解决复杂任务，却可能处理一万次相似任务后第二天仍犯第一天的错误。「保存经历不等于从经历中学习」—— 需要把证据、提案、验证、载体接成可验证闭环。" vertex="1">
          <mxGeometry height="58" width="1520" x="40" y="98" as="geometry" />
        </mxCell>
        <mxCell id="b44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 发现循环（把散落各章的伏笔接起来）" vertex="1">
          <mxGeometry height="260" width="1520" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="b45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="① 证据段 · 第 7 章&#xa;Pass^k / 失败归因&#xa;trajectory prefix 边界集&#xa;从整条轨迹定位首个错误" vertex="1">
          <mxGeometry height="110" width="350" x="60" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="② 提案段 · 第 3 章&#xa;把一条证据变成最小、可审查、可回滚的修改&#xa;待验证 diff 经独立审核才发布" vertex="1">
          <mxGeometry height="110" width="350" x="430" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="③ 验证与发布 · 第 9 章&#xa;离线进化循环 + 验证门槛&#xa;版本化经验库 / 评估集&#xa;在线循环只追加不可变证据" vertex="1">
          <mxGeometry height="110" width="350" x="800" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="④ 载体 · 第 9 章 / 第 8 章&#xa;知识 / 指令 / 程序 / 参数&#xa;参数部分 = 第 8 章唯一一次改模型之内" vertex="1">
          <mxGeometry height="110" width="350" x="1170" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b49" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="b45" target="b46">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b410" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="b46" target="b47">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b411" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="b47" target="b48">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b412" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;dashed=1;" value="新版本再评估" edge="1" source="b48" target="b45">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b413" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="第 8 章把第 7 章的问题案例直接转成训练数据：截出「准备宣称完成」的轨迹前缀，过早宣称作 rejected、「先跑测试逐条核对验收条件」作 chosen —— 适合做 DPO 或决策边界示范，而不是直接当正确的 SFT 轨迹。" vertex="1">
          <mxGeometry height="64" width="1480" x="60" y="340" as="geometry" />
        </mxCell>
        <mxCell id="b414" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 第 7 章 评估：对象是「模型 + Harness」" vertex="1">
          <mxGeometry height="310" width="760" x="40" y="445" as="geometry" />
        </mxCell>
        <mxCell id="b415" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="同一个模型在不同 Harness 中表现可差很多 → 对比实验（改一个变量）/ 消融实验（关组件看贡献）" vertex="1">
          <mxGeometry height="46" width="720" x="60" y="487" as="geometry" />
        </mxCell>
        <mxCell id="b416" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="两个指标两种世界观：Pass@k（k 次里有一次成功，技术奇观 / 通用性）vs Pass^k（k 次全成功，真实业务）" vertex="1">
          <mxGeometry height="46" width="720" x="60" y="539" as="geometry" />
        </mxCell>
        <mxCell id="b417" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="τ²-bench：一条记录 = 一个用例（初始状态 + 工单 + 模拟器规范 + 验收标准）；双控 Dual-Control：工具调用由用户发出" vertex="1">
          <mxGeometry height="46" width="720" x="60" y="591" as="geometry" />
        </mxCell>
        <mxCell id="b418" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="验证器核实机器可独立复核的事实，而非 Agent 自述：FAIL_TO_PASS（修好）+ PASS_TO_PASS（不退化）" vertex="1">
          <mxGeometry height="46" width="720" x="60" y="643" as="geometry" />
        </mxCell>
        <mxCell id="b419" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="自动化链路：确定性验证器 → 检查项清单 → Rubric + LLM-as-a-Judge → 配对比较（Bradley-Terry）；Judge 防同源偏见" vertex="1">
          <mxGeometry height="46" width="720" x="60" y="695" as="geometry" />
        </mxCell>
        <mxCell id="b420" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 第 8 章 后训练：四阶段 + 三条选择规则" vertex="1">
          <mxGeometry height="310" width="740" x="820" y="445" as="geometry" />
        </mxCell>
        <mxCell id="b421" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="四阶段：Pre-training → Mid-training（补底座）→ SFT（稳协议）→ RL（塑策略）" vertex="1">
          <mxGeometry height="46" width="700" x="840" y="487" as="geometry" />
        </mxCell>
        <mxCell id="b422" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="两个认知：SFT 数学上 ≡ 预训练（都是预测下一个词），差别在数据与目标范围；RL 需①输出可验证 ②当前策略偶尔能探索到好行为" vertex="1">
          <mxGeometry height="46" width="700" x="840" y="539" as="geometry" />
        </mxCell>
        <mxCell id="b423" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="GRPO：16 次 rollout → 一次参数更新，用组内相对优势替代价值网络；Online ≠ On-policy（行为策略须 = 待优化策略）" vertex="1">
          <mxGeometry height="46" width="700" x="840" y="591" as="geometry" />
        </mxCell>
        <mxCell id="b424" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="RL 环境：可让模型扮演环境，但模拟器偏差就是训练天花板；环境 / 任务分布 / 评估三者要隔离" vertex="1">
          <mxGeometry height="46" width="700" x="840" y="643" as="geometry" />
        </mxCell>
        <mxCell id="b425" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="多轮信用分配：工具调用让单轮变多轮，成功信号又晚又稀疏；奖励设计三问：从哪来 / 何时给 / 是否可钻空子" vertex="1">
          <mxGeometry height="46" width="700" x="840" y="695" as="geometry" />
        </mxCell>
        <mxCell id="b426" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 第 9 章 双循环：全书汇合点" vertex="1">
          <mxGeometry height="270" width="1520" x="40" y="770" as="geometry" />
        </mxCell>
        <mxCell id="b427" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="在线执行循环&#xa;完成任务 + 追加不可变证据&#xa;（不直接改写正式 Agent）&#xa;↓ 聚合轨迹" vertex="1">
          <mxGeometry height="110" width="720" x="60" y="812" as="geometry" />
        </mxCell>
        <mxCell id="b428" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="离线进化循环&#xa;诊断根因 → 生成更新提案 → 验证门槛 → 发布新版本&#xa;↑ 版本化的经验库 / 评估集&#xa;（与 Hermes Agent 的 Persistent Memory / Skills / Curator 对照）" vertex="1">
          <mxGeometry height="110" width="720" x="800" y="812" as="geometry" />
        </mxCell>
        <mxCell id="b429" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="知识载体&#xa;文档 / 记忆 / 知识库更新；能被外部符号完整表达" vertex="1">
          <mxGeometry height="70" width="350" x="60" y="932" as="geometry" />
        </mxCell>
        <mxCell id="b430" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="指令载体&#xa;Prompt / Skill / 规则；改动小、可回滚、可审查" vertex="1">
          <mxGeometry height="70" width="350" x="430" y="932" as="geometry" />
        </mxCell>
        <mxCell id="b431" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=9;align=center;verticalAlign=middle;" value="程序载体&#xa;工具与 Harness 代码；★ Agent 根据轨迹修改未来版本的自己" vertex="1">
          <mxGeometry height="70" width="350" x="800" y="932" as="geometry" />
        </mxCell>
        <mxCell id="b432" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="参数载体&#xa;第 8 章：Mid / SFT / RL；跨任务的识别习惯才适合写入参数" vertex="1">
          <mxGeometry height="70" width="350" x="1170" y="932" as="geometry" />
        </mxCell>
        <mxCell id="b433" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;" value="判定标准只有一条：目标能力能否被外部符号较完整地表达。可验证闭环在 Coding / 工具调用 / 业务状态变更最易成立；开放式科研、战略规划评价信号慢、答案不唯一，此时 Harness 要先补验证能力。" vertex="1">
          <mxGeometry height="26" width="1480" x="60" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="b434" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[07-第7章 Agent 的评估]] · [[08-第8章 模型后训练]] · [[09-第9章 Agent 的持续进化]] · [[03-第3章 用户记忆和知识库]] · 6-ai/2.3-Hermes Agent/" vertex="1">
          <mxGeometry height="24" width="1480" x="60" y="1050" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
