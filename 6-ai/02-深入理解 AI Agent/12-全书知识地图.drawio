        <mxCell id="b519" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="只增不改&#xa;2 章 KV Cache 前缀 / 事件式记忆 · 7 章轨迹 append-only · 9 章不可变证据" vertex="1">
          <mxGeometry height="120" width="280" x="656" y="697" as="geometry" />
        </mxCell>
        <mxCell id="b520" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="边界集 + 保留集&#xa;7 章 PASS_TO_PASS / trajectory prefix · 9 章验证门槛" vertex="1">
          <mxGeometry height="120" width="280" x="954" y="697" as="geometry" />
        </mxCell>
        <mxCell id="b521" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=9;align=center;verticalAlign=middle;" value="最小 diff + 可回滚&#xa;3 章知识更新 diff · 5 章 Coding Agent · 9 章版本化发布" vertex="1">
          <mxGeometry height="120" width="280" x="1252" y="697" as="geometry" />
        </mxCell>
        <mxCell id="b522" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;" value="⚠ 第 1 章「边界集 + 保留集」与第 7 章 `PASS_TO_PASS` 是同一个思想在不同尺度的两次出现：每次修改都要同时在「应改变」和「不应影响」两批样本上验证。另注意第 10 章与第 9 章的区分（p305）：生成式社交涌现 ≠ 可验证的持续进化。" vertex="1">
          <mxGeometry height="60" width="1480" x="60" y="830" as="geometry" />
