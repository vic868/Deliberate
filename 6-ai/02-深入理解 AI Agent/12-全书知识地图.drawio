          <mxGeometry height="470" width="900" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="b55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="两个维度&#xa;共享上下文 vs 隔离上下文；三种通信拓扑。共享保留细节但易上下文膨胀与「角色惯性」；隔离利于并发、模块化、权限控制，代价是要显式传参。" vertex="1">
          <mxGeometry height="120" width="420" x="60" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="虚拟文件系统 ≈ IPC&#xa;来源 / 生命周期 / 权限各异的存储 mount 到同一目录树，统一 read_file / write_file / list_dir 访问；三种通信机制类比操作系统进程间通信。" vertex="1">
          <mxGeometry height="120" width="420" x="510" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="不共享上下文 = 真多 Agent&#xa;§10.4 核心：只有当评判方看不到产出方的上下文，才构成第 1 章「提议者—审核者」的信息增量；第 4 章已有 spawn_subagent / send_message 生命周期原语。" vertex="1">
          <mxGeometry height="120" width="420" x="60" y="350" as="geometry" />
        </mxCell>
        <mxCell id="b58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="A2A 与协议&#xa;Agent 间发现、任务委派与结果回传的协议层；与 MCP（Agent↔工具）分层，不互相替代。" vertex="1">
          <mxGeometry height="120" width="420" x="510" y="350" as="geometry" />
        </mxCell>
        <mxCell id="b59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="六种失败模式&#xa;协作的代价：信息重复、角色漂移、错误级联、上下文膨胀、责任不清、合谋；§10.5 逐条给检测与缓解。" vertex="1">
          <mxGeometry height="120" width="420" x="60" y="488" as="geometry" />
        </mxCell>
        <mxCell id="b510" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="Agent 社会 / 经济涌现&#xa;从 25 个 Agent 到 150 万规模的社交涌现；Vending-Bench 里出现价格战与「主动发邮件提议统一定价」，且显式通信并非合谋的必要条件。" vertex="1">
          <mxGeometry height="120" width="420" x="510" y="488" as="geometry" />
        </mxCell>
        <mxCell id="b511" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 后记：三个问题、两朵乌云、一个飞轮" vertex="1">
          <mxGeometry height="470" width="600" x="960" y="170" as="geometry" />
        </mxCell>
        <mxCell id="b512" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="用开篇公式收束十章&#xa;看到什么 → 上下文（2/3/6 章）&#xa;能做什么 → 工具（4/5/6 章）&#xa;如何验证对不对 → 评估（7/8/9 章）&#xa;第 10 章是「谁来一起做」" vertex="1">
          <mxGeometry height="120" width="560" x="980" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b513" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="两朵乌云&#xa;① Agent 如何流式地、实时地与环境交互（第 6 章未竟）&#xa;② 如何像人一样从交互成败中持续积累经验（第 9 章未竟）&#xa;今天的模型更像「记性极好、却学不会新东西的天才」" vertex="1">
          <mxGeometry height="120" width="560" x="980" y="344" as="geometry" />
        </mxCell>
        <mxCell id="b514" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="Harness 飞轮 / 共同演进&#xa;模型变强 → Harness 可简化；Harness 补上验证与反馈 → 模型能力被真正兑现。&#xa;小世界假设（封闭可验证）与大世界假设（开放持续变化）决定闭环边界。&#xa;结论：方法与判断框架，比具体 API 与榜单更值得记。" vertex="1">
          <mxGeometry height="120" width="560" x="980" y="476" as="geometry" />
        </mxCell>
        <mxCell id="b515" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="书中模型与产品名（GPT-6 Astra / DeepSeek V4 / Qwen3 / Open Claw 等）是 2026-09 时点表述，迭代很快。" vertex="1">
          <mxGeometry height="26" width="560" x="980" y="606" as="geometry" />
        </mxCell>
        <mxCell id="b516" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 五个设计模式：从概念到各章的落点（第 1 章 §1.3 → 全书）" vertex="1">
          <mxGeometry height="250" width="1520" x="40" y="655" as="geometry" />
        </mxCell>
        <mxCell id="b517" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=9;align=center;verticalAlign=middle;" value="提议者—审核者&#xa;3 章知识审核 / 4 章工具复核 / 5 章 PPT·视频 / 7 章 Judge / 9 章提案审核 / 10 章隔离上下文" vertex="1">
          <mxGeometry height="120" width="280" x="60" y="697" as="geometry" />
        </mxCell>
        <mxCell id="b518" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="渐进式披露&#xa;2 章 Skills（元数据常驻）· 3 章分层检索 · 4 章主动工具发现" vertex="1">
          <mxGeometry height="120" width="280" x="358" y="697" as="geometry" />
