        <mxCell id="b14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 作者的三段式（第 1 章 1.2.6 明确：第 6 章不属于 Harness 五要素）" vertex="1">
          <mxGeometry height="170" width="1520" x="40" y="170" as="geometry" />
