        <mxCell id="b220" edge="1" parent="1" source="b210" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;dashed=1;" target="b214" value="无 tool_calls">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b221" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="ReAct = Reasoning + Acting。第 1 章消融实验：仅缺失「工具结果反馈」一条，就足以让 Agent 反复重试直到耗尽迭代预算。&#xa;循环轮数 = 模型调用次数 = 主要成本来源；每轮重发完整历史，前缀一变缓存失效（与 DeepSeek 账单复盘同源）。" vertex="1">
          <mxGeometry height="90" width="700" x="840" y="386" as="geometry" />
        </mxCell>
        <mxCell id="b222" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 上下文的五部分（p21）：前两项构成静态前缀" vertex="1">
          <mxGeometry height="300" width="760" x="40" y="515" as="geometry" />
        </mxCell>
        <mxCell id="b223" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="1 系统提示词｜开发者编写、全程不变；含跨会话用户记忆与环境状态" vertex="1">
          <mxGeometry height="40" width="720" x="60" y="557" as="geometry" />
        </mxCell>
        <mxCell id="b224" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="2 工具定义｜名称 / 描述 / 参数格式（JSON Schema）" vertex="1">
          <mxGeometry height="40" width="720" x="60" y="603" as="geometry" />
        </mxCell>
        <mxCell id="b225" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="3 用户消息｜可能含 RAG 动态注入的外部知识" vertex="1">
          <mxGeometry height="40" width="720" x="60" y="649" as="geometry" />
        </mxCell>
        <mxCell id="b226" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="4 模型回复｜reasoning + content + tool_calls，三者不一定同时出现" vertex="1">
          <mxGeometry height="40" width="720" x="60" y="695" as="geometry" />
        </mxCell>
        <mxCell id="b227" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="5 工具执行结果｜下一步思考的直接依据" vertex="1">
          <mxGeometry height="40" width="720" x="60" y="741" as="geometry" />
        </mxCell>
        <mxCell id="b228" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="静态前缀是第 2 章 KV Cache / Prompt Cache 设计的基础；2026 年以来生产框架也可把完整 schema 动态追加到上下文末尾而不破坏前缀。" vertex="1">
          <mxGeometry height="20" width="720" x="60" y="790" as="geometry" />
        </mxCell>
        <mxCell id="b229" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 三原则与五个贯穿全书的设计模式（p29 / p36）" vertex="1">
          <mxGeometry height="300" width="740" x="820" y="515" as="geometry" />
        </mxCell>
        <mxCell id="b230" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="Anthropic 三条核心原则&#xa;① 保持简单：直接 API 调用优于复杂框架，每多一层抽象都是调试盲区&#xa;② 保持透明：显式展示规划 / 日志 / 决策轨迹&#xa;③ 设计好 ACI：从 Agent 视角设计接口，用防呆（Poka-yoke）让误用无法发生&#xa;编排顺序：先优化提示词 → 再工作流 → 最后自主 Agent；护栏三层：上下文 / 执行 / 数据" vertex="1">
          <mxGeometry height="90" width="700" x="840" y="557" as="geometry" />
        </mxCell>
        <mxCell id="b231" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="提议者—审核者｜产出与评判不共享上下文，前提是自审不可靠（3/4/5/7/9/10 章）" vertex="1">
          <mxGeometry height="27" width="700" x="840" y="657" as="geometry" />
        </mxCell>
        <mxCell id="b232" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="渐进式披露｜先给可检索目录、按需加载，同时优化预算与选择精度" vertex="1">
          <mxGeometry height="27" width="700" x="840" y="687" as="geometry" />
        </mxCell>
        <mxCell id="b233" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="只增不改｜状态只追加 → 可缓存、可重放、可审计（KV Cache 前缀 / 事件式记忆）" vertex="1">
          <mxGeometry height="27" width="700" x="840" y="717" as="geometry" />
        </mxCell>
        <mxCell id="b234" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="边界集 + 保留集｜同时在「应改变」与「不应影响」两批样本上验证" vertex="1">
          <mxGeometry height="27" width="700" x="840" y="747" as="geometry" />
        </mxCell>
        <mxCell id="b235" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="最小 diff + 可回滚｜改动尽量小且可撤销（知识更新 / Coding Agent）" vertex="1">
          <mxGeometry height="27" width="700" x="840" y="777" as="geometry" />
        </mxCell>
        <mxCell id="b236" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="E · 五类工具（p18）：第 4 章展开前三类，第 6 章展开后两类" vertex="1">
          <mxGeometry height="210" width="1520" x="40" y="830" as="geometry" />
        </mxCell>
        <mxCell id="b237" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="感知｜环境 → Agent&#xa;搜索、文件读取、API / 数据库" vertex="1">
          <mxGeometry height="90" width="280" x="60" y="872" as="geometry" />
        </mxCell>
        <mxCell id="b238" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="执行｜Agent → 环境&#xa;代码执行、文件操作、系统命令" vertex="1">
          <mxGeometry height="90" width="280" x="358" y="872" as="geometry" />
        </mxCell>
        <mxCell id="b239" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="协作｜Agent ↔ Agent / 人&#xa;子 Agent 委托、人工确认" vertex="1">
          <mxGeometry height="90" width="280" x="656" y="872" as="geometry" />
        </mxCell>
        <mxCell id="b240" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="事件触发｜外部输入驱动&#xa;新邮件、定时器、Webhook（非 Agent 主动调用）" vertex="1">
          <mxGeometry height="90" width="280" x="954" y="872" as="geometry" />
        </mxCell>
        <mxCell id="b241" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="用户沟通｜Agent → 用户&#xa;文字、语音、邮件等跨渠道触达" vertex="1">
          <mxGeometry height="90" width="280" x="1252" y="872" as="geometry" />
        </mxCell>
        <mxCell id="b242" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="工程范式演进：提示工程 → 上下文工程 → Loop 工程（Harness 工程）。动机是 Demo 与可靠产品之间的鸿沟：幻觉、选错工具、遇错无法自恢复。" vertex="1">
          <mxGeometry height="24" width="1480" x="60" y="972" as="geometry" />
        </mxCell>
        <mxCell id="b243" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#C0392B;" value="金句：「扩展眼睛和手脚是最主要的能力杠杆」「安全问题从第一行代码就要考虑，而不是上线前打补丁」。" vertex="1">
          <mxGeometry height="24" width="1480" x="60" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="b244" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[01-第1章 AI Agent 入门]] · [[02-第2章 上下文工程]] · [[04-第4章 工具]] · 6-ai/0.1-langchain/4-AI Agent 组成与执行步骤全景.drawio 第 ① 页" vertex="1">
          <mxGeometry height="24" width="1480" x="60" y="1050" as="geometry" />
        </mxCell>
