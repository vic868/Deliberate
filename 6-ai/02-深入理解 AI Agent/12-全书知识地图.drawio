        <mxCell id="b15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="① 第 1 章 · 概念地图&#xa;两个公式 · 观察/动作空间&#xa;ReAct 循环 · 三原则&#xa;五个设计模式&#xa;PDF p15–37" vertex="1">
          <mxGeometry height="96" width="350" x="60" y="210" as="geometry" />
        </mxCell>
        <mxCell id="b16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="② 构建 · 第 2–6 章&#xa;上下文工程 · 记忆与知识库&#xa;工具 · Coding Agent&#xa;交互与动作空间扩展&#xa;PDF p38–191" vertex="1">
          <mxGeometry height="96" width="350" x="430" y="210" as="geometry" />
