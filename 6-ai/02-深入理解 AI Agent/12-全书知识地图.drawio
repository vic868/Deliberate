        <mxCell id="b111" edge="1" parent="1" source="b17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" target="b18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b112" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="两段伏笔：第 3 章是发现循环的「提案段」，第 7 章是「证据段」，第 9 章把两者接成可验证闭环；第 1 章的「边界集 + 保留集」在第 7 章具体化为 PASS_TO_PASS 与 trajectory prefix。" vertex="1">
          <mxGeometry height="24" width="1480" x="60" y="310" as="geometry" />
        </mxCell>
        <mxCell id="b113" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 十章 + 后记速查（每格：一句话定位 / 必记概念 / PDF 页）" vertex="1">
          <mxGeometry height="520" width="1520" x="40" y="355" as="geometry" />
        </mxCell>
        <mxCell id="b114" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="第 1 章 AI Agent 入门｜p15–37&#xa;全书概念地图。两个公式不是两套骨架；组件划分 vs 职责划分。&#xa;必记：观察/动作空间 · 五类工具 · 上下文五部分 · ReAct · ACI 三原则 · 五个设计模式" vertex="1">
          <mxGeometry height="70" width="720" x="60" y="397" as="geometry" />
        </mxCell>
        <mxCell id="b115" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="第 2 章 上下文工程｜p38–80&#xa;Harness 最核心组件：每次调用送进去什么、怎么组织。&#xa;必记：四种角色 · 无状态调用 · 静态前缀 · KV Cache vs Prompt Cache · Skills · 状态栏 · 分层压缩" vertex="1">
          <mxGeometry height="70" width="720" x="60" y="477" as="geometry" />
        </mxCell>
        <mxCell id="b116" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="第 3 章 用户记忆和知识库｜p81–110&#xa;把单次会话管理扩展成跨会话持久化知识体系。&#xa;必记：双层记忆 · 三个维度 · RAG 主流水线 · 稠密/ sparse 混合检索 · Rerank · RAPTOR / GraphRAG" vertex="1">
          <mxGeometry height="70" width="720" x="60" y="557" as="geometry" />
        </mxCell>
        <mxCell id="b117" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="第 4 章 工具｜p111–129&#xa;五类工具中 Agent 主动调用的三类；两个彼此独立的决策。&#xa;必记：ACI 谱系 · MCP / Skill Hub · 工具爆炸（&gt;100 个选错）· 四级递进按需加载" vertex="1">
          <mxGeometry height="70" width="720" x="60" y="637" as="geometry" />
        </mxCell>
        <mxCell id="b118" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="第 5 章 Coding Agent 与通用 Agent｜p130–161&#xa;通用 Agent = Coding Agent + 文件系统；代码是元能力。&#xa;必记：五步流程 · 故障恢复三问 · 致命三要素 + 持久记忆 · 六个应用方向" vertex="1">
          <mxGeometry height="70" width="720" x="60" y="717" as="geometry" />
        </mxCell>
        <mxCell id="b119" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=9;align=center;verticalAlign=middle;" value="第 6 章 交互与动作空间扩展｜p162–191&#xa;打破回合制；沿模态 × 触发时机两根轴扩展。&#xa;必记：事件循环 · Gateway / Hooks · 语音三范式 · Computer Use / SoM · VLA" vertex="1">
          <mxGeometry height="70" width="720" x="60" y="797" as="geometry" />
        </mxCell>
        <mxCell id="b120" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="第 7 章 Agent 的评估｜p192–223&#xa;构建完成 ≠ 构建正确；评估对象是「模型 + Harness」。&#xa;必记：Pass@k vs Pass^k · 确定性验证器 · LLM-as-a-Judge · 失败归因 · 边界集 / 保留集" vertex="1">
          <mxGeometry height="70" width="720" x="800" y="397" as="geometry" />
        </mxCell>
        <mxCell id="b121" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="第 8 章 模型后训练｜p224–263&#xa;全书唯一一次改「模型之内」，把能力沉淀进参数。&#xa;必记：四阶段 · SFT ≡ 预训练 · RL 两前提 · GRPO · On-Policy · 模拟器偏差 · 信用分配" vertex="1">
          <mxGeometry height="70" width="720" x="800" y="477" as="geometry" />
        </mxCell>
        <mxCell id="b122" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" value="第 9 章 Agent 的持续进化｜p264–279&#xa;★ 全书汇合点：从「怎么构建」转向「怎么长期变好」。&#xa;必记：能力悖论 · 四种载体（知识/指令/程序/参数）· 双循环 · 可验证闭环边界 · 睡眠学习" vertex="1">
          <mxGeometry height="70" width="720" x="800" y="557" as="geometry" />
        </mxCell>
        <mxCell id="b123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="第 10 章 多 Agent 协作｜p280–310&#xa;第一判据：协作是否引入单 Agent 生成时无法获得的新信息。&#xa;必记：共享/隔离 × 三种拓扑 · 三种通信机制 ≈ IPC · A2A · 六种失败模式 · Agent 社会" vertex="1">
          <mxGeometry height="70" width="720" x="800" y="637" as="geometry" />
        </mxCell>
        <mxCell id="b124" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="后记｜p311–313&#xa;用开篇公式收束十章，抛出两朵乌云。&#xa;必记：实时流式交互 · 从成败中积累经验 · 小世界/大世界假设 · 模型与 Harness 共同演进" vertex="1">
          <mxGeometry height="70" width="720" x="800" y="717" as="geometry" />
        </mxCell>
        <mxCell id="b125" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 两条主线与四条阅读路径" vertex="1">
          <mxGeometry height="170" width="1520" x="40" y="890" as="geometry" />
        </mxCell>
        <mxCell id="b126" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="主线 A · 后记的三个问题&#xa;看到什么 → 上下文（2/3/6 章）&#xa;能做什么 → 工具（4/5/6 章）&#xa;如何验证对不对 → 评估（7/8/9 章）" vertex="1">
          <mxGeometry height="110" width="470" x="60" y="932" as="geometry" />
        </mxCell>
        <mxCell id="b127" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="主线 B · 发现循环的四个角色&#xa;证据：第 7 章（Pass^k / 失败归因 / 边界集）&#xa;提案：第 3 章（最小、可审查、可回滚修改）&#xa;验证发布：第 9 章（双循环 + 门槛 + 经验库）&#xa;载体：知识 / 指令 / 程序 / 参数" vertex="1">
          <mxGeometry height="110" width="470" x="550" y="932" as="geometry" />
        </mxCell>
        <mxCell id="b128" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="时间紧：1 → 2§2.3 → 7§7.2 → 9 → 后记&#xa;RAG：2 → 3 → 7（recall@k / 验证器）&#xa;Agent 工程：1 → 4 → 5 → 10&#xa;评估迭代：7 → 8 → 9（别跳）" vertex="1">
          <mxGeometry height="110" width="500" x="1040" y="932" as="geometry" />
        </mxCell>
        <mxCell id="b129" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="本目录结构：00 索引 + 01~10 章节笔记 + 11 后记 + _原文/（12 份按页切分全文，保留 &lt;!-- PDF pN --&gt; 回溯标记）。图表仍需回看原 PDF。" vertex="1">
