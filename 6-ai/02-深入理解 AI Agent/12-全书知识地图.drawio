        <mxCell id="b21" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="深入理解 AI Agent · 全书知识地图（二）· 第 1 章概念地基" vertex="1">
          <mxGeometry height="40" width="1520" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="b22" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 01-第1章 AI Agent 入门.md｜PDF p15–37 / 印刷 p7–29" vertex="1">
          <mxGeometry height="26" width="1520" x="40" y="62" as="geometry" />
        </mxCell>
        <mxCell id="b23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" value="「Agent = 大脑 + 眼睛 + 手脚」：LLM 是大脑，上下文是眼睛，工具是手脚，三者缺一不可。由此得到全书的能力杠杆 —— 模型固定时，重新定义或扩展观察空间与动作空间，往往比换模型更有效。" vertex="1">
          <mxGeometry height="58" width="1520" x="40" y="98" as="geometry" />
        </mxCell>
        <mxCell id="b24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 两个公式与 Harness 的精确边界（p15 / p26 / p35）" vertex="1">
          <mxGeometry height="330" width="760" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="b25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="Agent = LLM + 上下文 + 工具&#xa;← 组件划分，描述 Agent 边界之内&#xa;环境不在公式里，是被交互的对象" vertex="1">
          <mxGeometry height="60" width="720" x="60" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="Agent = Model + Harness&#xa;Harness = 上下文管理 + 工具接口 + 约束 + 验证 + 纠正&#xa;← 职责划分：把「上下文 + 工具」细分为五要素，再加三层保障&#xa;原文明确：不是与前者并列的另一套划分" vertex="1">
          <mxGeometry height="80" width="720" x="60" y="282" as="geometry" />
        </mxCell>
        <mxCell id="b27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=9;align=center;verticalAlign=middle;" value="观察空间 / 动作空间（p16）&#xa;Harness 把环境返回的观察转成上下文，把模型选的行动转成工具调用。&#xa;① 没进入观察通道的信息，对模型就像不存在；&#xa;② 没被动作接口允许的操作，模型只能停留在文字建议。&#xa;⚠ 第 6 章扩展的是这两者本身的模态与时机，不属于五要素。" vertex="1">
          <mxGeometry height="110" width="720" x="60" y="372" as="geometry" />
        </mxCell>
        <mxCell id="b28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · ReAct 循环（p22）：骨架就是一个 while 循环" vertex="1">
          <mxGeometry height="330" width="740" x="820" y="170" as="geometry" />
        </mxCell>
        <mxCell id="b29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=center;verticalAlign=middle;" value="① 模型看轨迹" vertex="1">
