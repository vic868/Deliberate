<mxfile host="embed.diagrams.net" agent="codebuddy">
  <diagram id="lc-model-tool" name="模型接入与工具调用链路">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="模型接入四参数 与 工具调用完整链路" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="40" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="① 统一模型接入：init_chat_model(model, model_provider, base_url, api_key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1080" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="model&#10;模型名&#10;qwen-plus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="115" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="model_provider&#10;提供商/协议&#10;openai · deepseek · anthropic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="115" width="190" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="base_url&#10;服务地址&#10;官方内置时可省略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="115" width="190" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="api_key&#10;密钥&#10;load_key() / 环境变量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="115" width="190" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="ChatModel 对象&#10;（统一抽象）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="115" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="swap" value="切换模型 = 只改参数，不改代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="185" width="500" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="百炼&#10;qwen-plus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="185" width="150" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="OpenAI&#10;gpt-4o" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="185" width="150" height="38" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="DeepSeek&#10;deepseek-chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="185" width="160" height="38" as="geometry" />
        </mxCell>

        <mxCell id="laneB" value="② 工具调用链路（手写 invoke 视角）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E8A33D;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1080" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="HumanMessage&#10;'今天几月几号？'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8A33D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="模型推理&#10;发现工具可解决" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8A33D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="320" width="170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="AIMessage #1&#10;content = 空&#10;tool_calls = [get_current_date]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="320" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="执行工具函数&#10;@tool get_current_date()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8A33D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="320" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="ToolMessage&#10;content = '2026-10-26'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8A33D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="400" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="AIMessage #2&#10;content = '今天是 2026-10-26'&#10;最终答案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="400" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="注意：第一次 AIMessage 的 content 为空不是模型坏了 —— 它把直接回答换成了请求调用工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#D9534F;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="Agent 封装：create_agent(model, tools=[...], checkpointer=InMemorySaver()) —— 上述 2→6 步由框架自动完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9B6BC7;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="468" width="840" height="26" as="geometry" />
        </mxCell>

        <mxCell id="laneC" value="③ 可观测：LangSmith 三个环境变量 → 零开发接入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1080" height="120" as="geometry" />
