        <mxCell id="v3" value="LANGSMITH_API_KEY=xxx&#10;平台密钥（收费）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=12;" vertex="1" parent="1">
