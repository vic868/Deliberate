        <mxCell id="v1" value="LANGSMITH_TRACING=true&#10;开关" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="565" width="220" height="50" as="geometry" />
