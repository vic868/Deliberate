        <mxCell id="v2" value="LANGSMITH_PROJECT=xxx&#10;监控工程名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="565" width="220" height="50" as="geometry" />
