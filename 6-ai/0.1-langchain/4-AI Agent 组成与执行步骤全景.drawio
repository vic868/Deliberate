<mxCell id="a11" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="AI Agent（一）· 总纲：有哪些组成、按什么步骤执行" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="a12" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="官方 Agents docs「Agent = Model + Harness」· 18-LangChain/05 · 09-API 速查 §五§六 · 6-ai 八站作战地图" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="a13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" value="官方定义：An agent is a model calling tools in a loop until a given task is complete. Harness 是循环外面的一切（prompt / tools / middleware）。一句话记：Agent = 会调用工具的循环系统。" vertex="1"><mxGeometry height="58" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="a14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 执行步骤：一次 invoke 走完的 7 步（Thought → Action → Observation 循环）" vertex="1"><mxGeometry height="165" width="1520" x="40" y="170" as="geometry" /></mxCell>
<mxCell id="a15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="① 接收输入&#xa;{&quot;messages&quot;: [...]} + thread_id" vertex="1"><mxGeometry height="78" width="195" x="58" y="212" as="geometry" /></mxCell>
<mxCell id="a16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="② 组装上下文&#xa;system_prompt + 历史 + tools schema" vertex="1"><mxGeometry height="78" width="195" x="273" y="212" as="geometry" /></mxCell>
<mxCell id="a17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="③ 模型推理&#xa;判断要不要调工具" vertex="1"><mxGeometry height="78" width="195" x="488" y="212" as="geometry" /></mxCell>
<mxCell id="a18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="④ 条件路由&#xa;有 tool_calls ?" vertex="1"><mxGeometry height="78" width="195" x="703" y="212" as="geometry" /></mxCell>
<mxCell id="a19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="⑤ 执行工具&#xa;宿主代码真正执行" vertex="1"><mxGeometry height="78" width="195" x="918" y="212" as="geometry" /></mxCell>
