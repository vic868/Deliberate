<mxCell id="a118" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=1;dashed=1;" value="回灌后再决策 → 形成环" edge="1" source="a110" target="a17"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a119" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="④ 若「无 tool_calls」直接跳 ⑦；⑥ 之后回到 ③，循环轮数 = 模型调用次数 = 主要成本来源。" vertex="1"><mxGeometry height="24" width="1480" x="60" y="300" as="geometry" /></mxCell>
<mxCell id="a120" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 五大组成模块（五件套：大脑层 / 能力层 / 脊椎）" vertex="1"><mxGeometry height="405" width="1000" x="40" y="350" as="geometry" /></mxCell>
<mxCell id="a121" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="🧠 ① 模型 Model（大脑）&#xa;推理 / 决策 / 生成；ChatModel + system_prompt + bind_tools；必须支持 function calling" vertex="1"><mxGeometry height="64" width="960" x="60" y="392" as="geometry" /></mxCell>
<mxCell id="a122" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="📋 ② 规划 Planning（大脑）&#xa;任务拆解 / 路径选择 / 动态重规划；ReAct · Plan&amp;Execute · Reflection" vertex="1"><mxGeometry height="64" width="960" x="60" y="463" as="geometry" /></mxCell>
<mxCell id="a123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="🔧 ③ 工具 Tools（手脚）&#xa;与真实世界交互；@tool + docstring + JSON Schema → tool_calls → ToolMessage" vertex="1"><mxGeometry height="64" width="960" x="60" y="534" as="geometry" /></mxCell>
<mxCell id="a124" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="💾 ④ 记忆 Memory（仓库）&#xa;短期 checkpointer + thread_id；长期 Store / 向量库；上下文工程四招" vertex="1"><mxGeometry height="64" width="960" x="60" y="605" as="geometry" /></mxCell>
<mxCell id="a125" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="🦴 ⑤ Harness 运行时（脊椎）★&#xa;循环调度 · 上下文组装 · 超时重试 · 容错降级 · 算账审计；最常被漏掉的一层" vertex="1"><mxGeometry height="64" width="960" x="60" y="676" as="geometry" /></mxCell>
<mxCell id="a126" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="横切层：Middleware 贯穿 ②～⑦（脱敏 / 限流 / 审批 / 压缩），不属于某个模块但钩在每一步上。" vertex="1"><mxGeometry height="24" width="960" x="60" y="722" as="geometry" /></mxCell>
<mxCell id="a127" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 边界：它凭什么叫 Agent（三判句）" vertex="1"><mxGeometry height="405" width="500" x="1060" y="350" as="geometry" /></mxCell>
<mxCell id="a128" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="① 谁决定下一步？  ② 能否感知环境变化？  ③ 出错能否自我调整？" vertex="1"><mxGeometry height="58" width="460" x="1080" y="392" as="geometry" /></mxCell>
<mxCell id="a129" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="Chatbot：用户决定 · 一问一答 · 失忆" vertex="1"><mxGeometry height="44" width="460" x="1080" y="464" as="geometry" /></mxCell>
