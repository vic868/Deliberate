<mxCell id="a131" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="LCEL 链：人定义每一步（确定性 DAG）" vertex="1"><mxGeometry height="44" width="460" x="1080" y="564" as="geometry" /></mxCell>
<mxCell id="a132" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="AI Agent：模型自主决策 + 闭环反馈（带环图）" vertex="1"><mxGeometry height="44" width="460" x="1080" y="614" as="geometry" /></mxCell>
<mxCell id="a133" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="金句：Demo 能跑、上线就崩，崩的往往不是大脑（模型），而是脊椎（Harness）。" vertex="1"><mxGeometry height="58" width="460" x="1080" y="680" as="geometry" /></mxCell>
<mxCell id="a134" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 本册 7 页分工与系列导航" vertex="1"><mxGeometry height="190" width="1520" x="40" y="770" as="geometry" /></mxCell>
