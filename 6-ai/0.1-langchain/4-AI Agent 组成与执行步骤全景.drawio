<mxCell id="a139" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="⑤ 模块 D&#xa;规划与编排 / Harness" vertex="1"><mxGeometry height="72" width="195" x="912" y="815" as="geometry" /></mxCell>
<mxCell id="a140" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="⑥ 模块 E&#xa;中间件与护栏" vertex="1"><mxGeometry height="72" width="195" x="1125" y="815" as="geometry" /></mxCell>
<mxCell id="a141" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="⑦ 逐帧推演&#xa;落地 + 排错" vertex="1"><mxGeometry height="72" width="195" x="1338" y="815" as="geometry" /></mxCell>
<mxCell id="a142" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="本系列：0- V1.0 体系 · 1- Embedding · 2- Retriever · 3- LangGraph · 4- AI Agent（本册）。分工：3- 管图运行时 API（StateGraph / checkpoint / 流式），4- 管 Agent 组成与执行循环；两册都画 tools→model 回边，视角不同。6-ai/Agent 面试八站作战地图.drawio 是面试概念视角，本册是 LangChain 1.0 工程实现视角。" vertex="1"><mxGeometry height="46" width="1480" x="60" y="896" as="geometry" /></mxCell>
