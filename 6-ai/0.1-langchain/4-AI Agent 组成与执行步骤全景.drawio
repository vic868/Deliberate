<diagram id="a2" name="② 模块 A · 模型与提示（大脑）">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="a21" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="AI Agent（二）· 模块 A：模型与提示词 —— 大脑做什么、不做什么" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="a22" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 05-Agent §一/§二 · 09-API 速查 §一/§5.2/§5.4 · 官方 Agents docs Core components" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="a23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="from langchain.agents import create_agent&#xa;# model 可传 &#x27;provider:model&#x27; 字符串或 ChatModel 实例；provider 名取决于已装集成包&#xa;agent = create_agent(model=&#x27;deepseek:deepseek-chat&#x27;, tools=tools, system_prompt=&#x27;你是数据库助手…&#x27;)" vertex="1"><mxGeometry height="60" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="a24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 模型的三件事与能力门槛" vertex="1"><mxGeometry height="300" width="760" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="a25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="① 推理：理解意图与当前状态&#xa;② 决策：要不要调工具、调哪个、传什么参数&#xa;③ 生成：产出最终答案 / 结构化结果" vertex="1"><mxGeometry height="92" width="720" x="60" y="215" as="geometry" /></mxCell>
<mxCell id="a26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="传参两种：模型名字符串 &#x27;provider:model&#x27;，或已初始化的 ChatModel 实例&#xa;（DashScope / DeepSeek 走 OpenAI 兼容 base_url；用户笔记用 ChatOpenAI(...)）" vertex="1"><mxGeometry height="68" width="720" x="60" y="318" as="geometry" /></mxCell>
<mxCell id="a27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="⚠ 硬门槛：模型必须支持 function / tool calling。不支持的模型不会产出合法 tool_calls，Agent 循环直接退化成纯聊天。" vertex="1"><mxGeometry height="66" width="720" x="60" y="396" as="geometry" /></mxCell>
<mxCell id="a28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · system_prompt：行为约束比换模型更有效" vertex="1"><mxGeometry height="300" width="740" x="820" y="175" as="geometry" /></mxCell>
<mxCell id="a29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="system_prompt 接受 str 或 SystemMessage；复杂场景把规则写清楚，比调模型更有效。&#xa;05 §3.4 的 SQL Agent 四条硬规则：不猜表名 → 不猜字段 → 确认后才写 SQL → 报错看信息重试。" vertex="1"><mxGeometry height="90" width="700" x="840" y="215" as="geometry" /></mxCell>
<mxCell id="a210" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="官方补充：传 SystemMessage 对象可做 cache control；运行时动态改 prompt 走中间件 （ModelRequest.system_message / request.override(system_message=...)），不要每次重建 agent。" vertex="1"><mxGeometry height="82" width="700" x="840" y="315" as="geometry" /></mxCell>
<mxCell id="a211" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="对齐 ruoyi-chat：SSE 服务端的 system 指令 + 对话历史拼装，就是这一层的活（概念对照，非实现断言）。" vertex="1"><mxGeometry height="58" width="700" x="840" y="407" as="geometry" /></mxCell>
<mxCell id="a212" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · bind_tools：模型看到的是 schema，不是实现" vertex="1"><mxGeometry height="265" width="760" x="40" y="490" as="geometry" /></mxCell>
<mxCell id="a213" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="llm = model.bind_tools([get_current_time])&#xa;resp = llm.invoke(messages)&#xa;resp.tool_calls   # [{&#x27;name&#x27;: ..., &#x27;args&#x27;: {...}, &#x27;id&#x27;: ...}]" vertex="1"><mxGeometry height="88" width="720" x="60" y="530" as="geometry" /></mxCell>
<mxCell id="a214" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="bind_tools 只把工具描述挂到请求上；模型返回的是「调用请求」，不是答案。&#xa;第一次 AIMessage 的 content 为空是正常现象——它把「怎么答」换成了「调哪个工具」。" vertex="1"><mxGeometry height="72" width="720" x="60" y="630" as="geometry" /></mxCell>
<mxCell id="a215" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="V1.0 用 content_blocks 观察 tool_call 块；create_agent 内部走的就是 bind_tools，所以不用手写这一步。" vertex="1"><mxGeometry height="38" width="720" x="60" y="710" as="geometry" /></mxCell>
<mxCell id="a216" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 结构化输出 response_format" vertex="1"><mxGeometry height="265" width="740" x="820" y="490" as="geometry" /></mxCell>
<mxCell id="a217" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="class Answer(BaseModel):&#xa;    summary: str;  score: int&#xa;agent = create_agent(model=..., tools=[], response_format=Answer)&#xa;result[&#x27;structured_response&#x27;]   # 校验后的 Pydantic 对象" vertex="1"><mxGeometry height="100" width="700" x="840" y="530" as="geometry" /></mxCell>
<mxCell id="a218" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="结构化输出进主循环，不再额外多一次 LLM 调用；校验失败的 refusal 由中间件或重试链路处理。" vertex="1"><mxGeometry height="60" width="700" x="840" y="640" as="geometry" /></mxCell>
<mxCell id="a219" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="⚠ 讲义只给了机制描述，未给完整代码；09 §5.4 的代码是按机制补的对照写法，落地前核对当前版本。" vertex="1"><mxGeometry height="42" width="700" x="840" y="708" as="geometry" /></mxCell>
<mxCell id="a220" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="E · 成本口径（与 DeepSeek 账单复盘呼应）" vertex="1"><mxGeometry height="190" width="1520" x="40" y="770" as="geometry" /></mxCell>
<mxCell id="a221" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="每循环一轮 = 一次模型调用 = 一次计费；Agent 循环、失败重试、@Tool 往返会把「一次用户请求」放大成多次计费请求。" vertex="1"><mxGeometry height="60" width="730" x="60" y="810" as="geometry" /></mxCell>
<mxCell id="a222" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="每轮都重发完整历史 + 工具结果 → token 滚雪球；前缀一变缓存失效，命中 0.02 元/百万 vs 未命中 1 元/百万，差 50 倍。" vertex="1"><mxGeometry height="60" width="730" x="810" y="810" as="geometry" /></mxCell>
<mxCell id="a223" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="思考模式默认开启时 reasoning tokens 计入 completion_tokens（按输出价）；简单任务可关思考模式。" vertex="1"><mxGeometry height="60" width="730" x="60" y="878" as="geometry" /></mxCell>
<mxCell id="a224" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="固定 system_prompt / 文档放最前面且顺序不变，变化的历史放后面；长工具结果做摘要或外置，别整篇塞进 prompt。" vertex="1"><mxGeometry height="60" width="730" x="810" y="878" as="geometry" /></mxCell>
<mxCell id="a225" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[02-Model I-O 模型提示词与输出解析]] · [[05-Agent 工具调用与中间件]] · [[09-LangChain 1.0 API 速查菜单]] · 1-Embedding 图 / 2-Retriever 图" vertex="1"><mxGeometry height="22" width="1480" x="60" y="950" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="a3" name="③ 模块 B · 工具与函数调用">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="a31" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="AI Agent（三）· 模块 B：工具与函数调用 —— 谁决定、谁执行、消息怎么走" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="a32" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 05-Agent §一/§三 · 09-API 速查 §5.1 · 04-工具调用与 Agent（图灵教程）· 八站地图第 3/4 站" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="a33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" value="工程底线：模型只决定「调哪个工具、传什么参数」，真正发起网络请求 / 执行代码的是宿主应用。MCP、Skill、A2A 底层都绕不开这一层。" vertex="1"><mxGeometry height="56" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="a34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 工具五要素（V0.3 讲义口径）" vertex="1"><mxGeometry height="265" width="760" x="40" y="170" as="geometry" /></mxCell>
<mxCell id="a35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="① 名称：模型据此选择工具（动宾结构，如 get_order_detail）" vertex="1"><mxGeometry height="40" width="720" x="60" y="210" as="geometry" /></mxCell>
<mxCell id="a36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="② 描述：docstring 就是给模型看的说明书，含糊会选错工具" vertex="1"><mxGeometry height="40" width="720" x="60" y="254" as="geometry" /></mxCell>
<mxCell id="a37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="③ 输入 JSON Schema：由函数类型标注自动生成" vertex="1"><mxGeometry height="40" width="720" x="60" y="298" as="geometry" /></mxCell>
<mxCell id="a38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="④ 要调用的函数：真正执行的业务逻辑" vertex="1"><mxGeometry height="40" width="720" x="60" y="342" as="geometry" /></mxCell>
<mxCell id="a39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="⑤ 结果是否直接返回用户：V1.0 由 create_agent 内置循环接管回灌，此项不再需要手配" vertex="1"><mxGeometry height="40" width="720" x="60" y="386" as="geometry" /></mxCell>
<mxCell id="a310" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 定义与绑定（最小代码）" vertex="1"><mxGeometry height="265" width="740" x="820" y="170" as="geometry" /></mxCell>
<mxCell id="a311" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="from langchain.tools import tool&#xa;&#xa;@tool&#xa;def get_current_time(input: str = &#x27;&#x27;) -&gt; str:&#xa;    &quot;&quot;&quot;获取当前时间&quot;&quot;&quot;&#xa;    return datetime.now().strftime(&#x27;%Y-%m-%d %H:%M&#x27;)&#xa;&#xa;llm = model.bind_tools([get_current_time])" vertex="1"><mxGeometry height="180" width="700" x="840" y="210" as="geometry" /></mxCell>
<mxCell id="a312" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="预定义工具（Arxiv / Tavily…）与自定义工具本质相同；Toolkit = 为特定目标打包的一组工具，如 SQLDatabaseToolkit。" vertex="1"><mxGeometry height="30" width="700" x="840" y="398" as="geometry" /></mxCell>
<mxCell id="a313" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 完整消息时序：一次工具调用的 6 帧" vertex="1"><mxGeometry height="230" width="1520" x="40" y="450" as="geometry" /></mxCell>
<mxCell id="a314" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="① HumanMessage&#xa;用户问题" vertex="1"><mxGeometry height="92" width="225" x="58" y="495" as="geometry" /></mxCell>
<mxCell id="a315" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="② 模型第 1 次&#xa;AIMessage content=&#x27;&#x27;&#xa;tool_calls=[…]" vertex="1"><mxGeometry height="92" width="225" x="308" y="495" as="geometry" /></mxCell>
<mxCell id="a316" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="③ 宿主执行工具&#xa;真正跑函数" vertex="1"><mxGeometry height="92" width="225" x="558" y="495" as="geometry" /></mxCell>
<mxCell id="a317" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="④ ToolMessage&#xa;content + tool_call_id" vertex="1"><mxGeometry height="92" width="225" x="808" y="495" as="geometry" /></mxCell>
<mxCell id="a318" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="⑤ 模型第 2 次&#xa;带着结果再推理" vertex="1"><mxGeometry height="92" width="225" x="1058" y="495" as="geometry" /></mxCell>
<mxCell id="a319" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="⑥ AIMessage #2&#xa;最终答案" vertex="1"><mxGeometry height="92" width="225" x="1308" y="495" as="geometry" /></mxCell>
<mxCell id="a320" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="a314" target="a315"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a321" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="a315" target="a316"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a322" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="a316" target="a317"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a323" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="a317" target="a318"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a324" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="a318" target="a319"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a325" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="三类消息 Human / AI / Tool 构成闭环；tool_call_id 必须对应，否则模型无法把结果挂回调用请求。手写 invoke 时 ③～⑤ 全要自己写；create_agent 把整段封装掉。" vertex="1"><mxGeometry height="30" width="1480" x="60" y="608" as="geometry" /></mxCell>
<mxCell id="a326" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="Spring AI 对照：@Tool ↔ @tool；AssistantMessage.toolCalls ↔ tool_calls；ToolResponseMessage ↔ ToolMessage（语义一致，编排位置不同）。" vertex="1"><mxGeometry height="26" width="1480" x="60" y="642" as="geometry" /></mxCell>
<mxCell id="a327" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 四种调用拓扑 + 工具设计原则" vertex="1"><mxGeometry height="265" width="760" x="40" y="695" as="geometry" /></mxCell>
<mxCell id="a328" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="并行（无依赖）· 链式（有依赖，结果传递）· 条件（上一步返回值决定分支）· 嵌套（工具内部再调底层工具）" vertex="1"><mxGeometry height="56" width="720" x="60" y="735" as="geometry" /></mxCell>
<mxCell id="a329" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="职责单一：一个工具一件事，别做万能工具；数量先给 3～5 个核心工具" vertex="1"><mxGeometry height="34" width="720" x="60" y="800" as="geometry" /></mxCell>
<mxCell id="a330" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="描述写清「什么时候用 / 什么时候不用」，参数标枚举与必填" vertex="1"><mxGeometry height="34" width="720" x="60" y="838" as="geometry" /></mxCell>
<mxCell id="a331" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="返回结构化 JSON + 机器可读错误码，严禁大段自然语言；异常别抛栈给模型" vertex="1"><mxGeometry height="34" width="720" x="60" y="876" as="geometry" /></mxCell>
<mxCell id="a332" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=9;align=center;verticalAlign=middle;" value="写操作（删数据 / 付款 / 改价）必须加确认或人工审批" vertex="1"><mxGeometry height="34" width="720" x="60" y="914" as="geometry" /></mxCell>
<mxCell id="a333" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="E · Toolkit / 协议：FC vs MCP vs A2A" vertex="1"><mxGeometry height="265" width="740" x="820" y="695" as="geometry" /></mxCell>
<mxCell id="a334" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="Function Calling = 模型底层能力（决定调什么）&#xa;MCP = 生态层标准接口（向下连工具 / 数据源，USB-C 式，M×N → M+N）&#xa;A2A = 横向协议（Agent 之间握手、状态同步、任务委派）" vertex="1"><mxGeometry height="92" width="700" x="840" y="735" as="geometry" /></mxCell>
<mxCell id="a335" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="V0.3 手写 SQL 链要 5 步 + SQLCleaner；V1.0 create_agent + SQLDatabaseToolkit 把工具选择、执行、错误重试、消息历史全部内置。" vertex="1"><mxGeometry height="62" width="700" x="840" y="838" as="geometry" /></mxCell>
<mxCell id="a336" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;" value="踩坑：DeepSeek 等严格实现不能用 model.invoke(msgs, tools=[...])，会报 422 missing field &#x27;type&#x27;；必须用 bind_tools 生成标准 schema。" vertex="1"><mxGeometry height="40" width="700" x="840" y="908" as="geometry" /></mxCell>
<mxCell id="a337" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[05-Agent 工具调用与中间件]] · [[08-Day03 课堂复盘 RAG 实战与工具中间件]] · 04-工具调用与 Agent.md · 6-ai/Agent 面试八站作战地图.drawio" vertex="1"><mxGeometry height="22" width="1520" x="40" y="970" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="a4" name="④ 模块 C · 记忆与状态">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="a41" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="AI Agent（四）· 模块 C：记忆与状态 —— 会话不放在模型里" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="a42" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐官方 Agents docs AgentState · 05-Agent §2.1 · 07-Day02 §五 · 09-API 速查 §5.2 · 八站地图第 6 站" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="a43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="agent = create_agent(model=..., tools=..., checkpointer=InMemorySaver())&#xa;result = agent.invoke({&#x27;messages&#x27;: [{&#x27;role&#x27;: &#x27;user&#x27;, &#x27;content&#x27;: &#x27;…&#x27;}]},&#xa;                     config={&#x27;configurable&#x27;: {&#x27;thread_id&#x27;: &#x27;user_1&#x27;}})" vertex="1"><mxGeometry height="74" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="a44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · AgentState（官方当前口径）" vertex="1"><mxGeometry height="300" width="760" x="40" y="188" as="geometry" /></mxCell>
<mxCell id="a45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="内置字段只有 messages: list[BaseMessage]，append-only —— 新消息追加，从不替换。&#xa;节点式中间件钩子签名就是 (state: AgentState, runtime: Runtime) -&gt; dict | None，返回 dict 由 reducer 合并回状态。" vertex="1"><mxGeometry height="78" width="720" x="60" y="228" as="geometry" /></mxCell>
<mxCell id="a46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="加自定义字段：class MyState(AgentState): user_id / call_count → 传给 create_agent(state_schema=MyState)" vertex="1"><mxGeometry height="54" width="720" x="60" y="316" as="geometry" /></mxCell>
<mxCell id="a47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="每次运行的非会话数据：context_schema + invoke(context=Context(user_id=...))，工具里用 runtime.context 读。&#xa;thread_id 管「会话」（历史 / checkpoint），context 管「这次运行」（身份 / 开关 / 密钥）。" vertex="1"><mxGeometry height="82" width="720" x="60" y="380" as="geometry" /></mxCell>
<mxCell id="a48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 三层记忆金字塔" vertex="1"><mxGeometry height="300" width="740" x="820" y="188" as="geometry" /></mxCell>
<mxCell id="a49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="工作记忆 Scratchpad&#xa;当前轮推理的草稿纸；中间思考、临时工具结果" vertex="1"><mxGeometry height="74" width="700" x="840" y="228" as="geometry" /></mxCell>
<mxCell id="a410" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="短期记忆（thread 级）&#xa;checkpoint + thread_id；会话上下文，Redis + TTL 高频读写" vertex="1"><mxGeometry height="74" width="700" x="840" y="310" as="geometry" /></mxCell>
<mxCell id="a411" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="长期记忆（跨 thread）&#xa;Store / 向量库 / MySQL；画像、订单号等强结构化数据老实存关系库" vertex="1"><mxGeometry height="74" width="700" x="840" y="392" as="geometry" /></mxCell>
<mxCell id="a412" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="跨会话提炼要后台异步做并去重，避免把垃圾写进长期记忆。" vertex="1"><mxGeometry height="22" width="700" x="840" y="470" as="geometry" /></mxCell>
<mxCell id="a413" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 版本坐标（别学错 API）" vertex="1"><mxGeometry height="265" width="760" x="40" y="505" as="geometry" /></mxCell>
<mxCell id="a414" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="V0.3 / 教学路径：ConversationBufferMemory（已废弃）→ ChatMessageHistory + RunnableWithMessageHistory + session_id" vertex="1"><mxGeometry height="62" width="720" x="60" y="545" as="geometry" /></mxCell>
<mxCell id="a415" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="V1.0 生产路径：create_agent + checkpointer + thread_id；thread_id 就是 session_id 换个名字" vertex="1"><mxGeometry height="62" width="720" x="60" y="615" as="geometry" /></mxCell>
<mxCell id="a416" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="Saver 选型：InMemorySaver（开发）/ SqliteSaver（单机）/ PostgresSaver（生产）；MemorySaver 是旧别名" vertex="1"><mxGeometry height="62" width="720" x="60" y="685" as="geometry" /></mxCell>
<mxCell id="a417" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="07-Day02 §五：MessagesPlaceholder + session_id 是教学机制，看懂它 thread_id 就只是换名；写新代码入口只有 create_agent。" vertex="1"><mxGeometry height="20" width="720" x="60" y="752" as="geometry" /></mxCell>
<mxCell id="a418" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 上下文工程四招（治上下文腐烂 / Lost in the Middle）" vertex="1"><mxGeometry height="265" width="740" x="820" y="505" as="geometry" /></mxCell>
<mxCell id="a419" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="压缩：SummarizationMiddleware 汇总旧历史；长工具返回先做语义摘要" vertex="1"><mxGeometry height="42" width="700" x="840" y="545" as="geometry" /></mxCell>
<mxCell id="a420" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="外置：大体积结果写外部文件，prompt 只留路径引用（官方 FilesystemMiddleware）" vertex="1"><mxGeometry height="42" width="700" x="840" y="591" as="geometry" /></mxCell>
<mxCell id="a421" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="窗口隔离：多 Agent 各用独立小上下文，只传必要信息" vertex="1"><mxGeometry height="42" width="700" x="840" y="637" as="geometry" /></mxCell>
<mxCell id="a422" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="黄金余量：永远预留 30% 以上上下文空间应对未知工具回包" vertex="1"><mxGeometry height="42" width="700" x="840" y="683" as="geometry" /></mxCell>
<mxCell id="a423" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;" value="⚠ 版本差异：课程 V1.0 P21 说 Summarization 按会话次数上限触发；官方当前用 trigger（fraction / tokens / messages）配置，落地前核对版本参数。" vertex="1"><mxGeometry height="36" width="700" x="840" y="728" as="geometry" /></mxCell>
<mxCell id="a424" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="E · ruoyi-chat 对照 + 踩坑" vertex="1"><mxGeometry height="175" width="1520" x="40" y="785" as="geometry" /></mxCell>
<mxCell id="a425" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="ai_conversation / ai_message（MySQL）↔ checkpointer + thread_id 的会话状态" vertex="1"><mxGeometry height="54" width="730" x="60" y="825" as="geometry" /></mxCell>
<mxCell id="a426" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="不传 checkpointer 就没有 thread_id 记忆；HITL 与 thread_limit 都依赖它" vertex="1"><mxGeometry height="54" width="730" x="810" y="825" as="geometry" /></mxCell>
<mxCell id="a427" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="checkpointer 启动时初始化一次，别每个请求 new；生产配 TTL / 归档" vertex="1"><mxGeometry height="54" width="730" x="60" y="887" as="geometry" /></mxCell>
<mxCell id="a428" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="多用户串会话 = thread_id 没带上或用同一个值；SSE 断线重连也要复用同一 thread_id" vertex="1"><mxGeometry height="54" width="730" x="810" y="887" as="geometry" /></mxCell>
<mxCell id="a429" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="以上为概念对照，非实现断言。关联：[[07-Day02 课堂复盘 LCEL 与会话记忆]] · [[03.5-RunnableWithMessageHistory多轮记忆]] · 3-LangGraph 图第 ④ 页" vertex="1"><mxGeometry height="22" width="1480" x="60" y="945" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="a5" name="⑤ 模块 D · 规划与编排（Harness）">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="a51" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="AI Agent（五）· 模块 D：规划与编排 —— 循环怎么转、什么时候停" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="a52" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="官方 Agents docs「Agent = Model + Harness」· 3-LangGraph 图第 ③ 页 · 05-Agent §2.1 · 八站地图第 2/3/5 站" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="a53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="Harness = 循环外面的一切：prompt + tools + middleware。职责是「在正确的时间把正确的上下文给模型」。课程口径里它是五件套的「脊椎」：循环调度 / 上下文组装 / 超时重试 / 容错降级 / 算账审计。" vertex="1"><mxGeometry height="58" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="a54" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · LangGraph 内置循环图（create_agent 底层）" vertex="1"><mxGeometry height="320" width="900" x="40" y="170" as="geometry" /></mxCell>
<mxCell id="a55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="START" vertex="1"><mxGeometry height="82" width="195" x="60" y="220" as="geometry" /></mxCell>
<mxCell id="a56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="① model&#xa;绑定工具后调用" vertex="1"><mxGeometry height="82" width="195" x="275" y="220" as="geometry" /></mxCell>
<mxCell id="a57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="② should_continue&#xa;最后一条有 tool_calls ?" vertex="1"><mxGeometry height="82" width="195" x="490" y="220" as="geometry" /></mxCell>
<mxCell id="a58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="③ tools（ToolNode）&#xa;执行 → ToolMessage" vertex="1"><mxGeometry height="82" width="195" x="705" y="220" as="geometry" /></mxCell>
<mxCell id="a59" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="a55" target="a56"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a510" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" edge="1" source="a56" target="a57"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a511" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" value="有" edge="1" source="a57" target="a58"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a512" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=1;dashed=1;" value="结果回灌 → 再来一轮" edge="1" source="a58" target="a56"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a513" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="④ END&#xa;输出最终答案" vertex="1"><mxGeometry height="62" width="195" x="705" y="340" as="geometry" /></mxCell>
<mxCell id="a514" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7F8C8D;strokeWidth=1;" value="无 tool_calls" edge="1" source="a57" target="a513"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="a515" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="builder.add_edge(START, &#x27;model&#x27;)&#xa;builder.add_conditional_edges(&#x27;model&#x27;, should_continue)&#xa;builder.add_edge(&#x27;tools&#x27;, &#x27;model&#x27;)     # ← 这条回边就是「图」与「链」的本质差别" vertex="1"><mxGeometry height="70" width="860" x="60" y="410" as="geometry" /></mxCell>
<mxCell id="a516" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 终止条件（防止失控）" vertex="1"><mxGeometry height="320" width="600" x="960" y="170" as="geometry" /></mxCell>
<mxCell id="a517" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="自然终止：模型不再产出 tool_calls → END" vertex="1"><mxGeometry height="48" width="560" x="980" y="210" as="geometry" /></mxCell>
<mxCell id="a518" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="步数闸门：recursion_limit / ModelCallLimitMiddleware（run_limit / thread_limit）" vertex="1"><mxGeometry height="48" width="560" x="980" y="264" as="geometry" /></mxCell>
<mxCell id="a519" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="工具闸门：ToolCallLimitMiddleware（全局或按工具，exit_behavior=&#x27;end&#x27;/&#x27;error&#x27;）" vertex="1"><mxGeometry height="48" width="560" x="980" y="318" as="geometry" /></mxCell>
<mxCell id="a520" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="人工闸门：interrupt + HumanInTheLoopMiddleware（需 checkpointer）" vertex="1"><mxGeometry height="48" width="560" x="980" y="372" as="geometry" /></mxCell>
<mxCell id="a521" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="循环死锁检测 + 超时熔断（Harness 层，不是 prompt 层）" vertex="1"><mxGeometry height="48" width="560" x="980" y="426" as="geometry" /></mxCell>
<mxCell id="a522" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 三种推理范式与选型决策树" vertex="1"><mxGeometry height="265" width="900" x="40" y="505" as="geometry" /></mxCell>
<mxCell id="a523" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="步骤能否提前预判？→ 能：Plan &amp; Execute（强模型规划 + 轻模型执行 + 动态重规划）；不能：ReAct（边想边做边修正）&#xa;执行失败代价大？→ 叠加 Reflection（自审 + 错题本，每轮多 1～3 次调用，必须封顶）；简单轻量任务直接单步执行。" vertex="1"><mxGeometry height="76" width="860" x="60" y="545" as="geometry" /></mxCell>
<mxCell id="a524" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="ReAct：Thought → Action → Observation；地基范式，灵活但易局部贪心" vertex="1"><mxGeometry height="40" width="860" x="60" y="632" as="geometry" /></mxCell>
<mxCell id="a525" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="Plan &amp; Execute：先画地图再出发；全局观好、成本更低，必须配动态重规划" vertex="1"><mxGeometry height="40" width="860" x="60" y="676" as="geometry" /></mxCell>
<mxCell id="a526" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="Reflection：挂在循环外的 Buff，不是另一种循环；retry 是原样再来，reflection 是改了打法" vertex="1"><mxGeometry height="40" width="860" x="60" y="720" as="geometry" /></mxCell>
<mxCell id="a527" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="辨析：CoT 只在脑子里想，ReAct 每做一步收回一条真实观察 —— 区别在于是否引入外部环境反馈。" vertex="1"><mxGeometry height="20" width="860" x="60" y="765" as="geometry" /></mxCell>
<mxCell id="a528" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · Agentic RAG 与多 Agent 的边界" vertex="1"><mxGeometry height="265" width="600" x="960" y="505" as="geometry" /></mxCell>
<mxCell id="a529" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="传统 RAG：固定检索 → 生成（一问一答）&#xa;Agentic RAG：把检索当工具，循环判断「信息够不够」→ 改写 query / 换数据源 / 混合召回 + Rerank → 再决策" vertex="1"><mxGeometry height="88" width="560" x="980" y="545" as="geometry" /></mxCell>
<mxCell id="a530" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="多 Agent 真实代价：Token 可达单 Agent 的 15 倍、误差级联放大、严格顺序推理场景反而下降。&#xa;工程原则：先单 Agent 跑通业务，确有上下文隔离 / 强分工诉求再拆。" vertex="1"><mxGeometry height="88" width="560" x="980" y="643" as="geometry" /></mxCell>
<mxCell id="a531" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="检索细节见 2-Retriever 检索器全景；图与 checkpoint 细节见 3-LangGraph。" vertex="1"><mxGeometry height="24" width="560" x="980" y="740" as="geometry" /></mxCell>
<mxCell id="a532" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="E · 与 LCEL 链的分工" vertex="1"><mxGeometry height="175" width="1520" x="40" y="785" as="geometry" /></mxCell>
<mxCell id="a533" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="LCEL 链：人定义好每一步的确定性 DAG，适合 RAG 顺序流水线、单轮检索问答。" vertex="1"><mxGeometry height="60" width="730" x="60" y="830" as="geometry" /></mxCell>
<mxCell id="a534" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="Agent：模型决定走哪几步的动态带环图，适合步数不固定、需要重试 / 反思 / 审批的场景。" vertex="1"><mxGeometry height="60" width="730" x="810" y="830" as="geometry" /></mxCell>
<mxCell id="a535" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="V1.0 把主推方向从前者切到后者，但 RAG 检索、数据准备这类固定步骤仍大量用 Runnable 组合；二者不是替代关系。 关联：[[03-链与 LCEL]] · [[05-Agent 工具调用与中间件]] · 3-LangGraph 状态机与 Graph API 全景" vertex="1"><mxGeometry height="40" width="1480" x="60" y="905" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="a6" name="⑥ 模块 E · 中间件与护栏">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="a61" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="AI Agent（六）· 模块 E：中间件与护栏 —— 横切在循环每一步" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="a62" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 05-Agent §四 · 09-API 速查 §六 · 08-Day03 §4.3/§4.4 · 官方 middleware/built-in + custom 文档" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="a63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="定义：在 Agent 执行过程中拦截、修改或增强请求与响应，无需改核心 Agent 或工具代码。挂法：create_agent(..., middleware=[...])；V1.0 最大亮点，V0.3 课件完全没有这一章。" vertex="1"><mxGeometry height="56" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="a64" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 六个钩子（课程 V1.0 P22 / 官方 custom middleware 一致）" vertex="1"><mxGeometry height="300" width="900" x="40" y="170" as="geometry" /></mxCell>
<mxCell id="a65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="before_agent  ｜ 前后型 · Node-style&#xa;Agent 启动前 · 整次 invoke 一次" vertex="1"><mxGeometry height="72" width="415" x="60" y="210" as="geometry" /></mxCell>
<mxCell id="a66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="after_agent  ｜ 前后型 · Node-style&#xa;Agent 完成后 · 整次 invoke 一次" vertex="1"><mxGeometry height="72" width="415" x="495" y="210" as="geometry" /></mxCell>
<mxCell id="a67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="before_model  ｜ 前后型 · Node-style&#xa;每次模型调用前 · 循环里多次" vertex="1"><mxGeometry height="72" width="415" x="60" y="292" as="geometry" /></mxCell>
<mxCell id="a68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="after_model  ｜ 前后型 · Node-style&#xa;每次模型响应后 · 循环里多次" vertex="1"><mxGeometry height="72" width="415" x="495" y="292" as="geometry" /></mxCell>
<mxCell id="a69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="wrap_model_call  ｜ 环绕型 · Wrap-style&#xa;包住模型调用，可控 handler 调 0/1/N 次" vertex="1"><mxGeometry height="72" width="415" x="60" y="374" as="geometry" /></mxCell>
<mxCell id="a610" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="wrap_tool_call  ｜ 环绕型 · Wrap-style&#xa;包住工具调用，可做重试 / 缓存 / 转换" vertex="1"><mxGeometry height="72" width="415" x="495" y="374" as="geometry" /></mxCell>
<mxCell id="a611" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;" value="⚠ before_agent / after_agent 每次 invoke 一次，其余四个在循环里可能触发多次 —— 限流、计费、审计放错钩子会差好几倍。" vertex="1"><mxGeometry height="20" width="860" x="60" y="450" as="geometry" /></mxCell>
<mxCell id="a612" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 执行顺序（官方 custom middleware）" vertex="1"><mxGeometry height="300" width="600" x="960" y="170" as="geometry" /></mxCell>
<mxCell id="a613" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="middleware=[m1, m2, m3]&#xa;&#xa;before_* 正序：m1 → m2 → m3&#xa;wrap_* 嵌套：m1( m2( m3( model ) ) )&#xa;after_* 逆序：m3 → m2 → m1" vertex="1"><mxGeometry height="130" width="560" x="980" y="210" as="geometry" /></mxCell>
<mxCell id="a614" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="Node-style 返回 dict 由 reducer 合并进 state；Wrap-style 用 ModelRequest / handler 返回 ModelResponse，要改 state 用 ExtendedModelResponse + Command。" vertex="1"><mxGeometry height="68" width="560" x="980" y="352" as="geometry" /></mxCell>
<mxCell id="a615" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="补充：@dynamic_prompt 动态改 system prompt；@before_model(can_jump_to=[&#x27;end&#x27;]) / jump_to 可提前跳到 end / tools / model。" vertex="1"><mxGeometry height="36" width="560" x="980" y="428" as="geometry" /></mxCell>
<mxCell id="a616" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 课程 V1.0 的五个内置中间件（讲义口径）" vertex="1"><mxGeometry height="265" width="900" x="40" y="485" as="geometry" /></mxCell>
<mxCell id="a617" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="PIIMiddleware：发往模型前屏蔽 / 遮掩敏感信息（策略 redact / block / mask / hash）" vertex="1"><mxGeometry height="40" width="860" x="60" y="525" as="geometry" /></mxCell>
<mxCell id="a618" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="SummarizationMiddleware：对话历史接近上限时自动压缩（课件：按会话次数阈值）" vertex="1"><mxGeometry height="40" width="860" x="60" y="569" as="geometry" /></mxCell>
<mxCell id="a619" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="HumanInTheLoopMiddleware：工具执行前暂停，等待人工批准 / 编辑 / 拒绝（必须配 checkpointer）" vertex="1"><mxGeometry height="40" width="860" x="60" y="613" as="geometry" /></mxCell>
<mxCell id="a620" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="ModelCallLimitMiddleware：限制模型调用次数，防无限循环与成本失控" vertex="1"><mxGeometry height="40" width="860" x="60" y="657" as="geometry" /></mxCell>
<mxCell id="a621" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="ToolCallLimitMiddleware：限制工具调用次数，可全局或按工具" vertex="1"><mxGeometry height="40" width="860" x="60" y="701" as="geometry" /></mxCell>
<mxCell id="a622" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 官方当前新增（版本差异，别与讲义混写）" vertex="1"><mxGeometry height="265" width="600" x="960" y="485" as="geometry" /></mxCell>
<mxCell id="a623" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="官方 built-in 页现在列 22 个 provider-agnostic 中间件，课程只覆盖其中 5 个。新增代表：&#xa;&#xa;ToolErrorMiddleware / ToolRetryMiddleware / ModelRetryMiddleware / ModelFallbackMiddleware&#xa;LLMToolSelectorMiddleware（10+ 工具时先筛）/ TodoListMiddleware（规划）&#xa;ContextEditingMiddleware（清理旧工具输出）/ FilesystemMiddleware / SubAgentMiddleware" vertex="1"><mxGeometry height="150" width="560" x="980" y="525" as="geometry" /></mxCell>
<mxCell id="a624" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#C0392B;" value="版本要求示例：ToolError ≥1.3.14、ModelRefusal ≥1.4.9、ModelRouter / AutoMode（beta）≥1.5.0；Deep Agents 的中间件来自 deepagents 包，不是 langchain.agents.middleware。" vertex="1"><mxGeometry height="56" width="560" x="980" y="685" as="geometry" /></mxCell>
<mxCell id="a625" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="E · 安全四护栏与成本护栏" vertex="1"><mxGeometry height="195" width="1520" x="40" y="765" as="geometry" /></mxCell>
<mxCell id="a626" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="权限最小 · 输入消毒 · 输出审计（12 字真经）" vertex="1"><mxGeometry height="58" width="730" x="60" y="805" as="geometry" /></mxCell>
<mxCell id="a627" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="不可信数据隔离：独立 Guard 检测层，与主模型不同上下文" vertex="1"><mxGeometry height="58" width="730" x="810" y="805" as="geometry" /></mxCell>
<mxCell id="a628" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="高风险动作沙箱执行 + 人工审批卡点（提示词不负责安全）" vertex="1"><mxGeometry height="58" width="730" x="60" y="871" as="geometry" /></mxCell>
<mxCell id="a629" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="成本护栏：调用次数上限 + 前缀缓存 + 关思考模式 + 历史截断" vertex="1"><mxGeometry height="58" width="730" x="810" y="871" as="geometry" /></mxCell>
<mxCell id="a630" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="关联：[[05-Agent 工具调用与中间件]] · [[08-Day03 课堂复盘 RAG 实战与工具中间件]] · [[09-LangChain 1.0 API 速查菜单]] · docs.langchain.com/oss/python/langchain/middleware/" vertex="1"><mxGeometry height="22" width="1480" x="60" y="945" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="a7" name="⑦ 逐帧推演 · 落地与排错">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="a71" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="AI Agent（七）· 逐帧推演：一次 invoke 里到底发生了什么" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="a72" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="把前六页串成一条时间线 · 对齐 05-Agent §二/§五 · 09-API 速查 §5.2/§5.3 · 04-工具调用与 Agent §3" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="a73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="agent.invoke({&#x27;messages&#x27;: [{&#x27;role&#x27;: &#x27;user&#x27;, &#x27;content&#x27;: &#x27;现在几点了？&#x27;}]},&#xa;             config={&#x27;configurable&#x27;: {&#x27;thread_id&#x27;: &#x27;user_1&#x27;}})" vertex="1"><mxGeometry height="60" width="1520" x="40" y="98" as="geometry" /></mxCell>
<mxCell id="a74" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 逐帧推演（消息栈只追加，不重建）" vertex="1"><mxGeometry height="490" width="1000" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="a75" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="t0  输入&#xa;messages=[HumanMessage(&#x27;现在几点了？&#x27;)]；thread_id 定位历史" vertex="1"><mxGeometry height="45" width="960" x="60" y="215" as="geometry" /></mxCell>
<mxCell id="a76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="t1  Harness 组装&#xa;SystemMessage + checkpoint 里的历史 + tools 的 JSON Schema；before_agent / before_model 触发" vertex="1"><mxGeometry height="45" width="960" x="60" y="264" as="geometry" /></mxCell>
<mxCell id="a77" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="t2  模型第 1 次 ★计费&#xa;AIMessage(content=&#x27;&#x27;, tool_calls=[{name:&#x27;get_current_time&#x27;, args:{}, id:&#x27;call_1&#x27;}])" vertex="1"><mxGeometry height="45" width="960" x="60" y="313" as="geometry" /></mxCell>
<mxCell id="a78" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="t3  条件路由&#xa;should_continue 读到 tool_calls → 走 tools 节点（否则直接 END）" vertex="1"><mxGeometry height="45" width="960" x="60" y="362" as="geometry" /></mxCell>
<mxCell id="a79" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="t4  宿主执行&#xa;应用真正调用 get_current_time()，返回 &#x27;2026-11-14 21:49&#x27;" vertex="1"><mxGeometry height="45" width="960" x="60" y="411" as="geometry" /></mxCell>
<mxCell id="a710" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="t5  结果回灌&#xa;ToolMessage(content=&#x27;…&#x27;, tool_call_id=&#x27;call_1&#x27;) 追加到 messages（append-only）" vertex="1"><mxGeometry height="45" width="960" x="60" y="460" as="geometry" /></mxCell>
<mxCell id="a711" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;fontStyle=1;" value="t6  模型第 2 次 ★计费&#xa;带着完整历史再推理；前缀不变才命中缓存，这是成本分水岭" vertex="1"><mxGeometry height="45" width="960" x="60" y="509" as="geometry" /></mxCell>
<mxCell id="a712" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="t7  终止&#xa;AIMessage(&#x27;现在是 2026-11-14 21:49&#x27;)，无 tool_calls → END" vertex="1"><mxGeometry height="45" width="960" x="60" y="558" as="geometry" /></mxCell>
<mxCell id="a713" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="t8  取结果&#xa;result[&#x27;messages&#x27;][-1].content；checkpoint 在 super-step 边界落盘" vertex="1"><mxGeometry height="45" width="960" x="60" y="607" as="geometry" /></mxCell>
<mxCell id="a714" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · create_agent 参数与输入输出" vertex="1"><mxGeometry height="490" width="500" x="1060" y="175" as="geometry" /></mxCell>
<mxCell id="a715" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="model / tools / system_prompt&#xa;checkpointer（多轮记忆）&#xa;middleware（横切拦截）&#xa;response_format（结构化输出）&#xa;&#xa;官方当前另有：state_schema（自定义 state）&#xa;context_schema（per-run 数据）&#xa;name（作为子图时标识）" vertex="1"><mxGeometry height="148" width="460" x="1080" y="215" as="geometry" /></mxCell>
<mxCell id="a716" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="输入：{&#x27;messages&#x27;: [...]}&#xa;输出：含完整执行状态的 dict&#xa;最终答案：result[&#x27;messages&#x27;][-1].content&#xa;结构化：result[&#x27;structured_response&#x27;]" vertex="1"><mxGeometry height="100" width="460" x="1080" y="376" as="geometry" /></mxCell>
<mxCell id="a717" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=9;align=left;verticalAlign=middle;spacingLeft=12;" value="for msg in result[&#x27;messages&#x27;]:&#xa;    if isinstance(msg, AIMessage) and msg.tool_calls:&#xa;        for c in msg.tool_calls:&#xa;            print(c[&#x27;name&#x27;], c[&#x27;args&#x27;])" vertex="1"><mxGeometry height="92" width="460" x="1080" y="488" as="geometry" /></mxCell>
<mxCell id="a718" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;" value="审计 / 调试：从消息历史筛 tool_calls，可还原实际执行过的 SQL 与工具参数。" vertex="1"><mxGeometry height="40" width="460" x="1080" y="592" as="geometry" /></mxCell>
<mxCell id="a719" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 踩坑清单" vertex="1"><mxGeometry height="250" width="1000" x="40" y="680" as="geometry" /></mxCell>
<mxCell id="a720" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="bind_tools 后拿不到答案：正常，那只是调用请求；要应用执行或直接用 create_agent" vertex="1"><mxGeometry height="62" width="470" x="60" y="720" as="geometry" /></mxCell>
<mxCell id="a721" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="取不到文本：V1.0 返回 dict，取 result[&#x27;messages&#x27;][-1].content，不是 output / str" vertex="1"><mxGeometry height="62" width="470" x="550" y="720" as="geometry" /></mxCell>
<mxCell id="a722" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="模型不选 / 选错工具：docstring 写清用途与边界；确认模型支持 function calling" vertex="1"><mxGeometry height="62" width="470" x="60" y="790" as="geometry" /></mxCell>
<mxCell id="a723" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="多用户串会话：必须传 thread_id 且 checkpointer 已配置；不同用户不同 id" vertex="1"><mxGeometry height="62" width="470" x="550" y="790" as="geometry" /></mxCell>
