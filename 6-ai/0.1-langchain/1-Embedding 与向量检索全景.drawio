<diagram id="e2" name="② 相似度计算与向量库内部">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="e21" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="Embedding（二）· 相似度计算与向量库内部" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="e22" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="三种度量 · 分数口径坑 · collection 存什么 / 索引算什么 · 四大向量库选型" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="e23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 三种相似度度量（方向别记反）" vertex="1"><mxGeometry height="440" width="760" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="e24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=12;align=center;verticalAlign=middle;" value="余弦相似度 Cosine ｜ cos(θ) = A·B / (‖A‖‖B‖)&#xa;越大越相似，范围 [-1, 1] ｜ 只看方向不看长度，文本检索默认" vertex="1"><mxGeometry height="96" width="720" x="60" y="150" as="geometry" /></mxCell>
<mxCell id="e25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=12;align=center;verticalAlign=middle;" value="欧式距离 L2 ｜ d = √Σ(Ai − Bi)²&#xa;越小越相似 ｜ 关注绝对位置差异；Chroma 默认 hnsw:space = &#x27;l2&#x27;" vertex="1"><mxGeometry height="96" width="720" x="60" y="260" as="geometry" /></mxCell>
<mxCell id="e26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=12;align=center;verticalAlign=middle;" value="点积 Dot / ip ｜ A·B = Σ Ai·Bi&#xa;越大越相似 ｜ 归一化后 ≡ 余弦，省两次开方，向量库内部常用" vertex="1"><mxGeometry height="96" width="720" x="60" y="370" as="geometry" /></mxCell>
<mxCell id="e27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="归一化（模长 = 1）后 ‖A‖‖B‖ = 1，余弦在数值上就等于点积 —— 这就是「点积适合归一化向量」的原因。&#xa;numpy 十行可复现：cos_sim = dot(a,b)/(norm(a)*norm(b))；l2 = norm(a-b)。" vertex="1"><mxGeometry height="46" width="720" x="60" y="490" as="geometry" /></mxCell>
<mxCell id="e28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 分数口径：LangChain 里最容易踩的对照" vertex="1"><mxGeometry height="440" width="740" x="820" y="100" as="geometry" /></mxCell>
<mxCell id="e29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=11;align=center;verticalAlign=middle;" value="vector_store.similarity_search_with_score(query)&#xa;Chroma 返回 L2 距离 → 越小越像（讲义 04 §5）" vertex="1"><mxGeometry height="90" width="700" x="840" y="150" as="geometry" /></mxCell>
<mxCell id="e210" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=11;align=center;verticalAlign=middle;" value="as_retriever(search_type=&#x27;similarity_score_threshold&#x27;,&#xa;        search_kwargs={&#x27;score_threshold&#x27;: 0.5})&#xa;用的是向量库内部相关性分 → 越大越相关" vertex="1"><mxGeometry height="105" width="700" x="840" y="255" as="geometry" /></mxCell>
<mxCell id="e211" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="⚠ 两者口径相反：别把 with_score 的数值直接拿来调 score_threshold" vertex="1"><mxGeometry height="62" width="700" x="840" y="375" as="geometry" /></mxCell>
<mxCell id="e212" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="检索质量排查顺序：① SoupStrainer 是否圈对正文 → ② chunk_size / chunk_overlap →&#xa;③ embedding 是否适配中文 / 领域 → ④ k 过大或过小 → ⑤ 写入与查询的度量是否同源。" vertex="1"><mxGeometry height="60" width="700" x="840" y="455" as="geometry" /></mxCell>
<mxCell id="e213" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 向量数据库：存什么、算什么、怎么调" vertex="1"><mxGeometry height="180" width="1520" x="40" y="560" as="geometry" /></mxCell>
<mxCell id="e214" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="存（collection）&#xa;embeddings（必须）· documents（原文）&#xa;ids（必须）· metadata（过滤用）" vertex="1"><mxGeometry height="100" width="340" x="60" y="610" as="geometry" /></mxCell>
<mxCell id="e215" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="算（索引）&#xa;IVF：聚类分桶，只搜最近几个桶&#xa;HNSW：多层图逐层跳查（当前主流）" vertex="1"><mxGeometry height="100" width="340" x="420" y="610" as="geometry" /></mxCell>
<mxCell id="e216" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="Chroma 原生 API&#xa;Client() / PersistentClient(path)&#xa;create_collection(metadata={&#x27;hnsw:space&#x27;:&#x27;l2&#x27;})&#xa;collection.add() / query(n_results=5)" vertex="1"><mxGeometry height="100" width="340" x="780" y="610" as="geometry" /></mxCell>
<mxCell id="e217" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="⭐ 字段分离技巧&#xa;用 instruction / 问题 算向量，documents 存 output / 答案&#xa;FAQ 场景拿「问题」建索引，别拿答案 —— 搜到却答非所问多半是这里错" vertex="1"><mxGeometry height="100" width="400" x="1140" y="610" as="geometry" /></mxCell>
<mxCell id="e218" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 四大向量库选型" vertex="1"><mxGeometry height="150" width="1520" x="40" y="760" as="geometry" /></mxCell>
<mxCell id="e219" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="Pinecone ｜ 闭源商业 · 全托管云服务&#xa;不想运维时选，重复检测 / 排名跟踪" vertex="1"><mxGeometry height="88" width="355" x="60" y="805" as="geometry" /></mxCell>
<mxCell id="e220" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="Milvus ｜ 中国 ZILLIZ 开源 · 分布式&#xa;十亿级毫秒检索 / 混合搜索 / 企业生产（你的 192.168.0.106）" vertex="1"><mxGeometry height="88" width="355" x="435" y="805" as="geometry" /></mxCell>
<mxCell id="e221" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="FAISS ｜ Meta · 检索库而非数据库&#xa;只算不存；批量搜索 / 向量量化，极致性能与图像推荐" vertex="1"><mxGeometry height="88" width="355" x="810" y="805" as="geometry" /></mxCell>
<mxCell id="e222" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="Chroma ｜ 开源社区 · 轻量级易集成&#xa;Notebook 到集群同一套 API，LangChain 原生支持，开发测试首选" vertex="1"><mxGeometry height="88" width="355" x="1185" y="805" as="geometry" /></mxCell>
<mxCell id="e223" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="FAISS 没有持久化 / 增删改查服务那一套；要「数据库」语义选 Milvus / Chroma，要「算得快」用 FAISS。" vertex="1"><mxGeometry height="20" width="1480" x="60" y="888" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="e3" name="③ LangChain 1.0 API 地图">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="e31" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="Embedding（三）· LangChain 1.0 API 地图" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="e32" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 04-RAG §四/§五 · 09-API 速查菜单 §1.3 / §4.4 · 0-知识体系全景 第①页包分层" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="e33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 抽象层 → 实现层 → 包路径" vertex="1"><mxGeometry height="300" width="760" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="e34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="langchain_core.embeddings.Embeddings（抽象基类）&#xa;统一接口：embed_documents / embed_query；实例化产物叫「嵌入模型包装器」" vertex="1"><mxGeometry height="74" width="720" x="60" y="145" as="geometry" /></mxCell>
<mxCell id="e35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="langchain_community.embeddings.DashScopeEmbeddings&#xa;讲义用：model=&#x27;text-embedding-v3&#x27;，key 从环境变量 DASHSCOPE_API_KEY 读" vertex="1"><mxGeometry height="74" width="720" x="60" y="230" as="geometry" /></mxCell>
<mxCell id="e36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="合作伙伴包（V1.0 独立安装）&#xa;langchain_openai.OpenAIEmbeddings · langchain_milvus.Milvus · langchain_chroma" vertex="1"><mxGeometry height="74" width="720" x="60" y="315" as="geometry" /></mxCell>
<mxCell id="e37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="V1.0 把厂商实现拆到独立包；可用实现列表见 langchain_community/embeddings/__init__.py。&#xa;旧式 Chain 在 langchain_classic，Embeddings 本身不在其中。" vertex="1"><mxGeometry height="46" width="720" x="60" y="400" as="geometry" /></mxCell>
<mxCell id="e38" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 两个方法，两个时机" vertex="1"><mxGeometry height="300" width="740" x="820" y="100" as="geometry" /></mxCell>
<mxCell id="e39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="embed_documents(texts: List[str]) → List[List[float]]&#xa;离线建库：一次送一批 chunk；各平台单次条数有限 → 自己按 batch_size 分批循环" vertex="1"><mxGeometry height="95" width="700" x="840" y="150" as="geometry" /></mxCell>
<mxCell id="e310" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="embed_query(text: str) → List[float]&#xa;在线检索：把用户问题映射进同一个向量空间" vertex="1"><mxGeometry height="95" width="700" x="840" y="265" as="geometry" /></mxCell>
<mxCell id="e311" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="⚠ 基类默认 embed_query = embed_documents([text])[0]，但部分实现会给 query 加检索前缀（instruction），&#xa;两者不一定完全等价 —— 建库与查询各用各的，别混。" vertex="1"><mxGeometry height="46" width="700" x="840" y="375" as="geometry" /></mxCell>
<mxCell id="e312" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 代码串起来就这四行（讲义 04 §四 + §五）" vertex="1"><mxGeometry height="270" width="1520" x="40" y="420" as="geometry" /></mxCell>
<mxCell id="e313" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="from langchain_community.embeddings import DashScopeEmbeddings" vertex="1"><mxGeometry height="42" width="1480" x="60" y="470" as="geometry" /></mxCell>
<mxCell id="e314" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="embeddings = DashScopeEmbeddings(model=&#x27;text-embedding-v3&#x27;, dashscope_api_key=os.getenv(&#x27;DASHSCOPE_API_KEY&#x27;))" vertex="1"><mxGeometry height="42" width="1480" x="60" y="520" as="geometry" /></mxCell>
<mxCell id="e315" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="vector_store = Chroma.from_documents(documents=documents, embedding=embeddings)   # 内部自动对 chunks 调 embed_documents" vertex="1"><mxGeometry height="42" width="1480" x="60" y="570" as="geometry" /></mxCell>
<mxCell id="e316" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="retriever = vector_store.as_retriever(search_kwargs={&#x27;k&#x27;: 4})                   # 查询时自动调 embed_query" vertex="1"><mxGeometry height="42" width="1480" x="60" y="620" as="geometry" /></mxCell>
<mxCell id="e317" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="别混：get_lc_model_client() / ChatOpenAI 是对话模型，DashScopeEmbeddings 是嵌入模型 —— 用途、模型名、计费都不同，RAG 里两个都要用。" vertex="1"><mxGeometry height="24" width="1480" x="60" y="675" as="geometry" /></mxCell>
<mxCell id="e318" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · Embeddings 在 RAG 里的四个出口" vertex="1"><mxGeometry height="200" width="1520" x="40" y="710" as="geometry" /></mxCell>
<mxCell id="e319" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="① 建库 from_documents / from_texts&#xa;Chroma · FAISS · Milvus 都吃 embedding 参数" vertex="1"><mxGeometry height="92" width="355" x="60" y="755" as="geometry" /></mxCell>
<mxCell id="e320" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="② 直查 similarity_search(k=1)&#xa;调试用，但绑死在某一家的 API 上" vertex="1"><mxGeometry height="92" width="355" x="435" y="755" as="geometry" /></mxCell>
<mxCell id="e321" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="③ 包成 Runnable&#xa;RunnableLambda(similarity_search).bind(k=1)&#xa;才能进 LCEL 并行调度" vertex="1"><mxGeometry height="92" width="355" x="810" y="755" as="geometry" /></mxCell>
<mxCell id="e322" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="④ as_retriever() ★ 推荐&#xa;检索器 = 向量库的统一 Runnable 包装器&#xa;换库不改查询代码" vertex="1"><mxGeometry height="92" width="355" x="1185" y="755" as="geometry" /></mxCell>
<mxCell id="e323" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="VectorStore 负责「存得下、算得动」，Retriever 负责「统一查、可编排」→ 详见 [[04.1-Retriever 检索器]]。" vertex="1"><mxGeometry height="26" width="1480" x="60" y="860" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="e4" name="④ 铁律 · 踩坑 · 工程落地">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="e41" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="Embedding（四）· 一致性铁律、踩坑清单与工程落地" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="e42" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 7-向量化与向量检索 §八 · ruoyi-chat：ada-002 → DashScope、Milvus 192.168.0.106、文档上传先切片再入库" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="e43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" value="⭐ 一致性铁律：模型 + 维度 + 度量，建库与查询三一致。换 embedding 模型 = 重建整个集合，旧向量一条都不能留。" vertex="1"><mxGeometry height="70" width="1520" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="e44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 8 个高频坑" vertex="1"><mxGeometry height="480" width="760" x="40" y="190" as="geometry" /></mxCell>
<mxCell id="e45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="1  在线模型偷偷更新 → 向量漂移，全量重灌；保留巡检集定期比对" vertex="1"><mxGeometry height="48" width="720" x="60" y="235" as="geometry" /></mxCell>
<mxCell id="e46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="2  低维 ≠ 原生低维 → 动态裁剪引入偏差，优先选原生维度" vertex="1"><mxGeometry height="48" width="720" x="60" y="290" as="geometry" /></mxCell>
<mxCell id="e47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="3  batch 不控制 → 各平台单次条数限制不同，统一写分批循环" vertex="1"><mxGeometry height="48" width="720" x="60" y="345" as="geometry" /></mxCell>
<mxCell id="e48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="4  显存不足 → Ollama 加 options={&#x27;num_gpu&#x27;: 0} 降到 CPU" vertex="1"><mxGeometry height="48" width="720" x="60" y="400" as="geometry" /></mxCell>
<mxCell id="e49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="5  chromadb.Client() 只存内存 → 生产用 PersistentClient(path)" vertex="1"><mxGeometry height="48" width="720" x="60" y="455" as="geometry" /></mxCell>
<mxCell id="e410" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="6  hnsw:space 乱选 → l2 / cosine / ip 建库即定，写入与查询同源" vertex="1"><mxGeometry height="48" width="720" x="60" y="510" as="geometry" /></mxCell>
<mxCell id="e411" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="7  拿答案字段算向量 → 应拿「会被查询语义命中的字段」（问题 / instruction）" vertex="1"><mxGeometry height="48" width="720" x="60" y="565" as="geometry" /></mxCell>
<mxCell id="e412" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="8  换模型不清库 → 新旧向量混存，检索错乱，必须重建集合与索引" vertex="1"><mxGeometry height="48" width="720" x="60" y="620" as="geometry" /></mxCell>
<mxCell id="e413" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 向量漂移：怎么发现、怎么处理" vertex="1"><mxGeometry height="480" width="740" x="820" y="190" as="geometry" /></mxCell>
<mxCell id="e414" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" value="① 发现：同一段文本，今天和上周请求同一在线模型，向量不一致" vertex="1"><mxGeometry height="70" width="700" x="840" y="235" as="geometry" /></mxCell>
<mxCell id="e415" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" value="② 判断：F16 → numpy 精度误差（正常、微小） / 厂商更新模型（异常、显著）" vertex="1"><mxGeometry height="70" width="700" x="840" y="320" as="geometry" /></mxCell>
<mxCell id="e416" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" value="③ 防御：保留少量数据作巡检集，定期请求比对向量是否漂移" vertex="1"><mxGeometry height="70" width="700" x="840" y="405" as="geometry" /></mxCell>
<mxCell id="e417" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" value="④ 处置：确认模型变更 → 所有分块重新向量化 + 重建集合 / 索引" vertex="1"><mxGeometry height="70" width="700" x="840" y="490" as="geometry" /></mxCell>
<mxCell id="e418" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=1;" edge="1" source="e414" target="e415"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e419" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=1;" edge="1" source="e415" target="e416"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e420" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=1;" edge="1" source="e416" target="e417"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e421" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="在线 API（DashScope）：质量好、维度可调，但版本不可控、文本出网。&#xa;本地 Ollama + bge-m3：版本完全自己控、数据不出内网，代价是要管显存与运维。&#xa;Ollama 默认端口 11434；推理引擎 ≠ 向量模型（引擎是底座，模型跑在引擎上）。" vertex="1"><mxGeometry height="76" width="700" x="840" y="585" as="geometry" /></mxCell>
<mxCell id="e422" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 工程落地：ruoyi-chat / Spring AI ↔ LangChain" vertex="1"><mxGeometry height="220" width="1520" x="40" y="690" as="geometry" /></mxCell>
<mxCell id="e423" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="嵌入渠道：OpenAI text-embedding-ada-002 → DashScope&#xa;迁移 = 换模型 → 旧向量必须全量重灌，别只改配置" vertex="1"><mxGeometry height="95" width="355" x="60" y="740" as="geometry" /></mxCell>
<mxCell id="e424" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="向量库：Milvus 192.168.0.106&#xa;参考 sp-milvus-demo / Spring AI Milvus starter&#xa;集合 dimension 与度量建库即定" vertex="1"><mxGeometry height="95" width="355" x="435" y="740" as="geometry" /></mxCell>
<mxCell id="e425" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="文档上传：md/pdf/txt/doc/docx/xlsx/csv ≤ 20MB&#xa;先解析 → 切片 → 向量化 → 入库&#xa;别把全文直接拼进 prompt" vertex="1"><mxGeometry height="95" width="355" x="810" y="740" as="geometry" /></mxCell>
<mxCell id="e426" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=10;align=center;verticalAlign=middle;" value="⚠ 整篇进 prompt ≠ 向量检索&#xa;前者每次几十万 token 重复发送；后者只送 top-K chunk&#xa;这是 token 成本数量级差异的根因" vertex="1"><mxGeometry height="95" width="355" x="1185" y="740" as="geometry" /></mxCell>
<mxCell id="e427" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="关联：[[7-向量化与向量检索-Embedding相似度与向量数据库]] · [[04-RAG 数据连接与检索]] · [[04-RAG 知识点梳理]] · [[04.1-Retriever 检索器]] · [[Milvus 学习文档]] · [[pgvector vs Milvus 选型对比]]" vertex="1"><mxGeometry height="34" width="1480" x="60" y="850" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
