<mxCell id="e11" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="Embedding（一）· 是什么，以及 RAG 的双链路全景" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="e12" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 6-ai/0-LLM/7-向量化与向量检索 ｜ 18-LangChain/04-RAG 数据连接与检索 ｜ 离线建库 5 步 · 在线问答 5 步" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="e13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" value="Embedding = 把文本映射为「固定维度的浮点向量」；语义相近的文本在向量空间里距离更近。向量模型负责「变」，向量库负责「存 + 算」。" vertex="1"><mxGeometry height="56" width="1520" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="e14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 概念：什么是 Embedding" vertex="1"><mxGeometry height="540" width="430" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="e15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="文本 → 一串数字&#xa;「长沙」= [0.8, -0.3, 0.5, …]（示意 1024 维）" vertex="1"><mxGeometry height="72" width="390" x="60" y="215" as="geometry" /></mxCell>
<mxCell id="e16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="一个输入 → 一个输出&#xa;输入多长都不影响输出维度（实测 3 字 / 几十字 → 同为 64 维）" vertex="1"><mxGeometry height="72" width="390" x="60" y="299" as="geometry" /></mxCell>
<mxCell id="e17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="语义相近 ⇒ 向量距离近&#xa;模型质量决定检索上限：它分不清的语义，检索永远找不回来" vertex="1"><mxGeometry height="72" width="390" x="60" y="383" as="geometry" /></mxCell>
<mxCell id="e18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" value="向量模型 ≠ 对话大模型&#xa;不预测下一个词，只做映射；RAG 里两个都要用" vertex="1"><mxGeometry height="72" width="390" x="60" y="467" as="geometry" /></mxCell>
<mxCell id="e19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=11;align=center;verticalAlign=middle;" value="三参数：维度 / 窗口 / batch&#xa;维度权衡信息量与资源；context window 决定分块上限" vertex="1"><mxGeometry height="72" width="390" x="60" y="551" as="geometry" /></mxCell>
<mxCell id="e110" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="课堂验证：text-embedding-v4 · dimensions=64；&#xa;生产常用 1024 维，能选原生维度就别用动态裁剪。" vertex="1"><mxGeometry height="56" width="390" x="60" y="645" as="geometry" /></mxCell>
<mxCell id="e111" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 离线建库（一次性）：前三步产生向量，后两步让向量可检索" vertex="1"><mxGeometry height="220" width="1070" x="490" y="175" as="geometry" /></mxCell>
<mxCell id="e112" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="① 数据清洗&#xa;去噪 / bs4.SoupStrainer 圈正文" vertex="1"><mxGeometry height="80" width="188" x="510" y="225" as="geometry" /></mxCell>
<mxCell id="e113" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="② 文本分块&#xa;RecursiveCharacterTextSplitter&#xa;chunk_size=500 / overlap=50" vertex="1"><mxGeometry height="80" width="188" x="718" y="225" as="geometry" /></mxCell>
<mxCell id="e114" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="③ 向量化 ⭐&#xa;embed_documents(chunks)&#xa;同一模型 · 同一维度" vertex="1"><mxGeometry height="80" width="188" x="926" y="225" as="geometry" /></mxCell>
