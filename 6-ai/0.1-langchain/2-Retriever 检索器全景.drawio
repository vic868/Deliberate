<diagram id="r1" name="① 定位 · 为什么需要检索器">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="r11" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="Retriever（一）· 定位：向量库本来就能查，为什么还要检索器" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="r12" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 04.1-Retriever 检索器 §1/§2 · 04-RAG §5.1 · 04.2-检索器（科普类比）" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="r13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" value="检索器 = 向量库的包装器。它把「怎么查」从「查什么」里剥出来：底层换成 Milvus 或 FAISS，查询代码一个字不改。" vertex="1"><mxGeometry height="56" width="1520" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="r14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 图书馆管理员类比：检索器到底省了什么" vertex="1"><mxGeometry height="330" width="430" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="r15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=11;align=center;verticalAlign=middle;" value="❌ 把整座图书馆（全部文档）塞给 LLM&#xa;超出上下文长度 / 看多了走神 / 调用成本极高" vertex="1"><mxGeometry height="82" width="390" x="60" y="215" as="geometry" /></mxCell>
<mxCell id="r16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="✅ 懂语义的图书馆管理员&#xa;不回答问题，只按语义相似度先翻出最相关的 3~5 页" vertex="1"><mxGeometry height="82" width="390" x="60" y="310" as="geometry" /></mxCell>
<mxCell id="r17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="召回 Top-K（默认 k=4）→ 塞进 {context}&#xa;让大模型「看着资料作答」，可溯源、成本低" vertex="1"><mxGeometry height="82" width="390" x="60" y="405" as="geometry" /></mxCell>
<mxCell id="r18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 三层关系：Retriever 夹在问题与向量库之间" vertex="1"><mxGeometry height="330" width="1070" x="490" y="175" as="geometry" /></mxCell>
<mxCell id="r19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="① 用户问题（str）：「张成刚是谁？」" vertex="1"><mxGeometry height="54" width="930" x="560" y="212" as="geometry" /></mxCell>
<mxCell id="r110" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="② Retriever 层 · 统一接口：VectorStoreRetriever&#xa;invoke / batch / stream，本身就是 Runnable" vertex="1"><mxGeometry height="54" width="930" x="560" y="278" as="geometry" /></mxCell>
<mxCell id="r111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="③ VectorStore 层 · 各家实现：Chroma / FAISS / Milvus / Pinecone&#xa;查询语法、连接鉴权、返回结构、分数口径各不相同" vertex="1"><mxGeometry height="54" width="930" x="560" y="344" as="geometry" /></mxCell>
<mxCell id="r112" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="④ List[Document] → context → Prompt → LLM" vertex="1"><mxGeometry height="54" width="930" x="560" y="410" as="geometry" /></mxCell>
<mxCell id="r113" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" edge="1" source="r19" target="r110"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="r114" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" edge="1" source="r110" target="r111"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="r115" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" edge="1" source="r111" target="r112"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="r116" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="② 天生是 Runnable → 可直接作为 RunnableParallel 的值进 LCEL；换库只改 from_documents(...) 一行。" vertex="1"><mxGeometry height="24" width="930" x="560" y="476" as="geometry" /></mxCell>
<mxCell id="r117" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 四个理由（按重要性排）" vertex="1"><mxGeometry height="200" width="760" x="40" y="525" as="geometry" /></mxCell>
<mxCell id="r118" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="1  统一接口：换向量库不改查询与链路代码" vertex="1"><mxGeometry height="58" width="345" x="60" y="570" as="geometry" /></mxCell>
<mxCell id="r119" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="2  是 Runnable：invoke / batch / stream 原生可用" vertex="1"><mxGeometry height="58" width="345" x="425" y="570" as="geometry" /></mxCell>
<mxCell id="r120" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="3  可组合：多个检索器用 EnsembleRetriever 融合" vertex="1"><mxGeometry height="58" width="345" x="60" y="638" as="geometry" /></mxCell>
<mxCell id="r121" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="4  关注点分离：策略调参不碰业务代码" vertex="1"><mxGeometry height="58" width="345" x="425" y="638" as="geometry" /></mxCell>
<mxCell id="r122" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 向量库直查 vs 检索器（别混用）" vertex="1"><mxGeometry height="200" width="740" x="820" y="525" as="geometry" /></mxCell>
<mxCell id="r123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="vector_store.similarity_search()&#xa;· 存储层 API，调试用&#xa;· 换库 → 查询代码跟着改&#xa;· 进 LCEL 需 RunnableLambda 手工包装&#xa;· 不方便被融合" vertex="1"><mxGeometry height="135" width="340" x="840" y="570" as="geometry" /></mxCell>
<mxCell id="r124" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="retriever.invoke() ★ 生产用&#xa;· 抽象层 Runnable&#xa;· 换库 → 不改&#xa;· 天生可进 LCEL，.batch 原生支持&#xa;· 可当 EnsembleRetriever 成员" vertex="1"><mxGeometry height="135" width="340" x="1200" y="570" as="geometry" /></mxCell>
<mxCell id="r125" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" value="⭐ VectorStore 负责「存得下、算得动」，Retriever 负责「统一查、可编排」。因为它是 Runnable，才能被并行调度、被组合、被 Agent 当工具调用 —— 这是直查给不了的。" vertex="1"><mxGeometry height="60" width="1520" x="40" y="745" as="geometry" /></mxCell>
<mxCell id="r126" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="关联：[[04.1-Retriever 检索器]] §1/§2 · [[04-RAG 数据连接与检索]] §5.1 / §5 · [[04.2-检索器]]（科普） · 讲义原问题见 04 §5.1" vertex="1"><mxGeometry height="30" width="1520" x="40" y="820" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="r2" name="② 参数与检索策略">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="r21" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="Retriever（二）· as_retriever 参数、三种检索策略与分数口径" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="r22" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 04.1 §3（官方文档延伸，讲义未展开） · 04.1 §6 排查清单 · 09-API 速查菜单 §4.4" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="r23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" value="retriever = vector_store.as_retriever(search_type=&#x27;similarity&#x27;, search_kwargs={&#x27;k&#x27;: 4})&#xa;# search_type 决定委托底层哪个方法；search_kwargs 把参数原样透传给该方法" vertex="1"><mxGeometry height="56" width="1520" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="r24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 三种 search_type" vertex="1"><mxGeometry height="340" width="940" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="r25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="similarity（默认）｜相似度 top-k&#xa;配套：k（默认 4）｜最常用，按分数排序取前 k；结果可能彼此重复" vertex="1"><mxGeometry height="90" width="900" x="60" y="215" as="geometry" /></mxCell>
<mxCell id="r26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="mmr｜最大边际相关性：既相关又彼此不重复&#xa;配套：k · fetch_k（候选池，默认 20）· lambda_mult（0 最多多样性 / 1 最多相关性，默认 0.5）&#xa;用于缓解「结果高度重复」" vertex="1"><mxGeometry height="90" width="900" x="60" y="315" as="geometry" /></mxCell>
<mxCell id="r27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="similarity_score_threshold｜只返回相关性达标的结果&#xa;配套：score_threshold · k｜结果条数不固定，可能一条都没有（prompt 要能兜底）" vertex="1"><mxGeometry height="90" width="900" x="60" y="415" as="geometry" /></mxCell>
<mxCell id="r28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · search_kwargs 参数地图" vertex="1"><mxGeometry height="340" width="560" x="1000" y="175" as="geometry" /></mxCell>
<mxCell id="r29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="k ｜ 返回条数，默认 4" vertex="1"><mxGeometry height="50" width="520" x="1020" y="215" as="geometry" /></mxCell>
<mxCell id="r210" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="fetch_k ｜ MMR 候选池大小，默认 20" vertex="1"><mxGeometry height="50" width="520" x="1020" y="273" as="geometry" /></mxCell>
<mxCell id="r211" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="lambda_mult ｜ 多样性 ↔ 相关性，默认 0.5" vertex="1"><mxGeometry height="50" width="520" x="1020" y="331" as="geometry" /></mxCell>
<mxCell id="r212" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="score_threshold ｜ 阈值检索的最低相关性" vertex="1"><mxGeometry height="50" width="520" x="1020" y="389" as="geometry" /></mxCell>
<mxCell id="r213" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="filter ｜ 按 Document.metadata 过滤&#xa;如 {&#x27;source&#x27;: &#x27;鱼类宠物文档&#x27;} 限定来源 / 章节" vertex="1"><mxGeometry height="50" width="520" x="1020" y="447" as="geometry" /></mxCell>
<mxCell id="r214" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D06060;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 分数口径坑（务必别串台）" vertex="1"><mxGeometry height="210" width="760" x="40" y="535" as="geometry" /></mxCell>
<mxCell id="r215" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=11;align=center;verticalAlign=middle;" value="similarity_search_with_score()&#xa;Chroma 返回 L2 距离 → 越小越相似" vertex="1"><mxGeometry height="60" width="720" x="60" y="580" as="geometry" /></mxCell>
<mxCell id="r216" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D06060;fontSize=11;align=center;verticalAlign=middle;" value="search_type=&#x27;similarity_score_threshold&#x27;&#xa;score_threshold 用向量库内部相关性分 → 越大越相关" vertex="1"><mxGeometry height="60" width="720" x="60" y="650" as="geometry" /></mxCell>
<mxCell id="r217" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#C0392B;" value="⚠ 两者口径相反：别把 with_score 的数值直接拿来调 score_threshold。" vertex="1"><mxGeometry height="24" width="720" x="60" y="715" as="geometry" /></mxCell>
<mxCell id="r218" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 按现象选策略" vertex="1"><mxGeometry height="210" width="740" x="820" y="535" as="geometry" /></mxCell>
<mxCell id="r219" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="结果高度重复 → 换 mmr，调 fetch_k / lambda_mult" vertex="1"><mxGeometry height="36" width="700" x="840" y="575" as="geometry" /></mxCell>
<mxCell id="r220" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="需要限定范围 → search_kwargs={&#x27;filter&#x27;: {...}} 用 metadata" vertex="1"><mxGeometry height="36" width="700" x="840" y="615" as="geometry" /></mxCell>
<mxCell id="r221" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="精确词（编号 / 人名）查不准 → 叠加 BM25 走混合检索" vertex="1"><mxGeometry height="36" width="700" x="840" y="655" as="geometry" /></mxCell>
<mxCell id="r222" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="换库要改一堆代码 → 统一 as_retriever()，别直调各家 API" vertex="1"><mxGeometry height="36" width="700" x="840" y="695" as="geometry" /></mxCell>
<mxCell id="r223" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="E · 出处与版本口径" vertex="1"><mxGeometry height="145" width="1520" x="40" y="765" as="geometry" /></mxCell>
<mxCell id="r224" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="讲义 P35–P45 只演示了 as_retriever() 无参形式与 RunnableLambda(...).bind(k=1)；以上参数属官方文档延伸，以所装版本为准：&#xa;https://python.langchain.com/docs/how_to/vectorstore_retriever/&#xa;★ 稳定的版本结论：检索这一页 V0.3 P21 / V1.0 P11 逐页对比完全一致，跨版本通用 —— 唯一要留意的是 import 路径。" vertex="1"><mxGeometry height="82" width="1480" x="60" y="810" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="r3" name="③ 检索器家族与混合检索">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="r31" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="Retriever（三）· 四种创建方式与混合检索" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="r32" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 08-Day03 课堂复盘 §4.2（V1.0 P11 / V0.3 P21） · 04.1 §5 · 09-API 速查菜单 §4.4" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="r33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 四种创建方式（课件示意代码）" vertex="1"><mxGeometry height="360" width="940" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="r34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="retriever_faiss  = FAISS.from_texts(texts, embeddings).as_retriever()    # 语义 · 纯文本建库" vertex="1"><mxGeometry height="64" width="900" x="60" y="145" as="geometry" /></mxCell>
<mxCell id="r35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;" value="retriever_chroma = Chroma.from_documents(docs, embeddings).as_retriever() # 语义 · Document 建库" vertex="1"><mxGeometry height="64" width="900" x="60" y="220" as="geometry" /></mxCell>
