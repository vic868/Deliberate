<mxCell id="g12" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 00-LangChain V1.0 学习总览 · 09-API 速查菜单 §五 · 官方 Graph API overview" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="g13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" value="LangChain 1.0 = 建在 LangGraph 之上的 Agent 工程化框架。create_agent 是 V1.0 唯一入口，底层跑的就是一张带环的 LangGraph 图。" vertex="1"><mxGeometry height="56" width="1520" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="g14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 三个核心元素：State / Node / Edge" vertex="1"><mxGeometry height="300" width="760" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="g15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=11;align=center;verticalAlign=middle;" value="State 共享状态&#xa;应用的共享快照；TypedDict 声明 channels，reducer 决定更新如何合并" vertex="1"><mxGeometry height="76" width="720" x="60" y="215" as="geometry" /></mxCell>
<mxCell id="g16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;" value="Node 节点&#xa;普通函数：读 state → 干活 → 返回 partial updates（nodes do the work）" vertex="1"><mxGeometry height="76" width="720" x="60" y="300" as="geometry" /></mxCell>
<mxCell id="g17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;" value="Edge 边&#xa;固定或条件转移，决定下一个跑谁（edges decide what runs next）；可形成分支与环" vertex="1"><mxGeometry height="76" width="720" x="60" y="385" as="geometry" /></mxCell>
<mxCell id="g18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="三者组合出 sequence / branch / loop；compile() 检查图结构后才能 invoke / stream。" vertex="1"><mxGeometry height="24" width="720" x="60" y="470" as="geometry" /></mxCell>
<mxCell id="g19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · 什么时候该用图，而不是 LCEL 链" vertex="1"><mxGeometry height="300" width="740" x="820" y="175" as="geometry" /></mxCell>
<mxCell id="g110" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="LCEL 链：线性 DAG，一步接一步&#xa;适合 RAG 顺序流水线、单轮检索问答 —— 简单场景别过度设计" vertex="1"><mxGeometry height="105" width="700" x="840" y="215" as="geometry" /></mxCell>
<mxCell id="g111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="图：带环 + 显式状态 + 可持久化 ★&#xa;适合重试 / 反思循环、条件路由、跨轮记忆、人工审批、多 Agent 协作" vertex="1"><mxGeometry height="105" width="700" x="840" y="335" as="geometry" /></mxCell>
<mxCell id="g112" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="判断标准：需要循环、分支、持久状态或人工介入才上图；纯顺序流程 LCEL 更快更好维护。" vertex="1"><mxGeometry height="24" width="700" x="840" y="450" as="geometry" /></mxCell>
<mxCell id="g113" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · V1.0 版本坐标（与你 18-LangChain 笔记对齐）" vertex="1"><mxGeometry height="200" width="1520" x="40" y="495" as="geometry" /></mxCell>
<mxCell id="g114" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="00-学习总览 主线&#xa;Model I/O → LCEL → RAG → Agent / 中间件&#xa;→ FastAPI + LangServe 部署" vertex="1"><mxGeometry height="100" width="355" x="60" y="540" as="geometry" /></mxCell>
<mxCell id="g115" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="09-API 速查：包分工&#xa;langgraph.* = 图运行时与状态持久化&#xa;langchain.* = Agent 高层 API" vertex="1"><mxGeometry height="100" width="355" x="435" y="540" as="geometry" /></mxCell>
<mxCell id="g116" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="V0.3 → V1.0&#xa;AgentExecutor / create_react_agent&#xa;→ langchain.agents.create_agent" vertex="1"><mxGeometry height="100" width="355" x="810" y="540" as="geometry" /></mxCell>
<mxCell id="g117" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="记忆机制迁移&#xa;ConversationBufferMemory → checkpointer + thread_id&#xa;（thread_id 就是 session_id 换名）" vertex="1"><mxGeometry height="100" width="355" x="1185" y="540" as="geometry" /></mxCell>
<mxCell id="g118" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 四张图的分工（本系列）" vertex="1"><mxGeometry height="195" width="1520" x="40" y="715" as="geometry" /></mxCell>
