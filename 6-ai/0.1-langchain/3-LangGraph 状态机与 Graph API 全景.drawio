<diagram id="g2" name="② Graph API 核心">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="g21" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="LangGraph（二）· Graph API 核心：State / Node / Edge / Super-step" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="g22" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="官方口径：docs.langchain.com/oss/python/langgraph/graph-api · 最小可运行示例 + 三要素精确 API" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="g23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;" value="from langgraph.graph import START, END, StateGraph&#xa;graph = StateGraph(State).add_node(&#x27;a&#x27;, node_a).add_edge(START,&#x27;a&#x27;).add_edge(&#x27;a&#x27;,END).compile()   # → graph.invoke({&#x27;text&#x27;:&#x27;&#x27;})" vertex="1"><mxGeometry height="56" width="1520" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="g24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · State：schema + reducers" vertex="1"><mxGeometry height="370" width="760" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="g25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="Schema：TypedDict（推荐）/ dataclass / Pydantic；create_agent 的 state 必须 TypedDict，不支持 Pydantic" vertex="1"><mxGeometry height="64" width="720" x="60" y="215" as="geometry" /></mxCell>
<mxCell id="g26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="Channels + Reducers：默认覆盖（last-write-wins）；带 reducer 的 key 按规则合并，节点只返回 partial updates" vertex="1"><mxGeometry height="64" width="720" x="60" y="287" as="geometry" /></mxCell>
<mxCell id="g27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="from langgraph.graph.message import add_messages → Annotated[list, add_messages]：追加消息并按 ID 更新；MessagesState 是预置的 messages-only state" vertex="1"><mxGeometry height="64" width="720" x="60" y="359" as="geometry" /></mxCell>
<mxCell id="g28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="operator.add 只追加不更新；Overwrite 可绕过合并 reducer 直接替换 / 清空字段" vertex="1"><mxGeometry height="64" width="720" x="60" y="431" as="geometry" /></mxCell>
<mxCell id="g29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="B · Node 与 Edge" vertex="1"><mxGeometry height="370" width="740" x="820" y="175" as="geometry" /></mxCell>
<mxCell id="g210" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="Node：fn(state, config, runtime) → 部分更新；底层包装为 RunnableLambda，是 checkpoint 与 retry 边界" vertex="1"><mxGeometry height="76" width="700" x="840" y="215" as="geometry" /></mxCell>
<mxCell id="g211" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="add_edge(A,B) / add_edge(START,...) / add_edge(...,END)：固定转移；compile() 会检查孤立节点并挂运行时选项" vertex="1"><mxGeometry height="76" width="700" x="840" y="300" as="geometry" /></mxCell>
<mxCell id="g212" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="add_conditional_edges(A, router, {path: node})：router 读 state 决定下一跳，可返回节点名 / 名称列表（并行）/ END / Send" vertex="1"><mxGeometry height="76" width="700" x="840" y="385" as="geometry" /></mxCell>
<mxCell id="g213" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" value="⚠ 同一节点别混用静态边与动态路由（conditional edges / Command），否则两条路径可能同时跑。&#xa;只做路由优先 conditional edges；要「改状态 + 定下一跳」一起做才用 Command。" vertex="1"><mxGeometry height="50" width="700" x="840" y="480" as="geometry" /></mxCell>
<mxCell id="g214" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0E9FA;strokeColor=#9B6BC7;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="C · 执行模型与动态控制" vertex="1"><mxGeometry height="200" width="1520" x="40" y="565" as="geometry" /></mxCell>
<mxCell id="g215" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="Super-step（Pregel 消息传递）&#xa;并行节点共享一个 super-step，顺序节点分步执行；&#xa;所有节点 inactive 且无在途消息时结束。recursion_limit 是 config 顶层键（不在 configurable 下），超限抛 GraphRecursionError。" vertex="1"><mxGeometry height="110" width="460" x="60" y="610" as="geometry" /></mxCell>
<mxCell id="g216" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="Send：运行时才知道数量的 fan-out&#xa;[Send(&#x27;worker&#x27;, {&#x27;subject&#x27;: s}) for s in state[&#x27;subjects&#x27;]]&#xa;worker 并行执行，结果由 reducer 合并（map-reduce / orchestrator-worker）" vertex="1"><mxGeometry height="110" width="460" x="540" y="610" as="geometry" /></mxCell>
<mxCell id="g217" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=10;align=center;verticalAlign=middle;" value="Command：一步内同时更新状态 + 路由&#xa;Command(update={&#x27;foo&#x27;:&#x27;bar&#x27;}, goto=&#x27;next&#x27;)&#xa;从 subgraph 回父图用 graph=Command.PARENT；中断恢复用 Command(resume=...)" vertex="1"><mxGeometry height="110" width="520" x="1020" y="610" as="geometry" /></mxCell>
<mxCell id="g218" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#7F8C8D;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="D · 出处与学习定位" vertex="1"><mxGeometry height="125" width="1520" x="40" y="785" as="geometry" /></mxCell>
<mxCell id="g219" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=11;align=center;verticalAlign=middle;" value="本页 State/Reducer/Send/Command/Super-step 口径来自官方 Graph API overview；recursion_limit 默认值随版本变化（1.0.6–1.1.3 为 10000，1.1.4+ 为 10007）。&#xa;V1.0 课程把 create_agent 作为写新代码的唯一入口；本节是理解其底层运行时的教学路径，不是要求你手写图替代 create_agent。" vertex="1"><mxGeometry height="66" width="1480" x="60" y="830" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="g3" name="③ 执行流 · 带工具循环的 Agent 图">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="g31" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1F3864;" value="LangGraph（三）· 执行流：一个带工具循环的 Agent 图" vertex="1"><mxGeometry height="40" width="1520" x="40" y="20" as="geometry" /></mxCell>
<mxCell id="g32" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="对齐 05-Agent 工具调用与中间件 §2.1 · 09-API 速查菜单 §5.2 · 官方 Graph API 条件边示例" vertex="1"><mxGeometry height="26" width="1520" x="40" y="62" as="geometry" /></mxCell>
<mxCell id="g33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#4A90D9;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" value="最小 Agent 图 = 模型节点 + 条件边 + 工具节点 + 一条回边。这个「环」正是 create_agent 内置的 Tool Calling 循环。" vertex="1"><mxGeometry height="56" width="1520" x="40" y="100" as="geometry" /></mxCell>
<mxCell id="g34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#5AA469;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" value="A · 图的拓扑（注意 tools → model 那条回边）" vertex="1"><mxGeometry height="350" width="1520" x="40" y="175" as="geometry" /></mxCell>
<mxCell id="g35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" value="START" vertex="1"><mxGeometry height="60" width="130" x="80" y="330" as="geometry" /></mxCell>
<mxCell id="g36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90D9;fontSize=10;align=center;verticalAlign=middle;" value="① model（call_model）&#xa;model.invoke(state[&#x27;messages&#x27;])&#xa;→ AIMessage（可能含 tool_calls）" vertex="1"><mxGeometry height="80" width="230" x="280" y="320" as="geometry" /></mxCell>
<mxCell id="g37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B6BC7;fontSize=10;align=center;verticalAlign=middle;" value="② should_continue&#xa;条件边路由函数：&#xa;最后一条消息有 tool_calls？" vertex="1"><mxGeometry height="80" width="230" x="580" y="320" as="geometry" /></mxCell>
<mxCell id="g38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;align=center;verticalAlign=middle;" value="③a tools（ToolNode）&#xa;执行工具 → ToolMessage" vertex="1"><mxGeometry height="80" width="230" x="880" y="220" as="geometry" /></mxCell>
<mxCell id="g39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5AA469;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="③b END&#xa;输出最终答案" vertex="1"><mxGeometry height="70" width="230" x="880" y="430" as="geometry" /></mxCell>
<mxCell id="g310" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;fontSize=10;align=center;verticalAlign=middle;" value="环的意义&#xa;模型 → 工具结果 → 模型可多轮往返，直到没有 tool_calls 才结束。&#xa;这正是 05-Agent 笔记里「模型只发起调用请求，执行与回灌由应用 / Agent 负责」的分工。" vertex="1"><mxGeometry height="105" width="330" x="1180" y="315" as="geometry" /></mxCell>
<mxCell id="g311" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" edge="1" source="g35" target="g36"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="g312" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B6BC7;strokeWidth=1;" edge="1" source="g36" target="g37"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="g313" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=1;" value="有 tool_calls" edge="1" source="g37" target="g38"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="g314" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5AA469;strokeWidth=1;" value="无 → END" edge="1" source="g37" target="g39"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="g315" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D06060;strokeWidth=1;dashed=1;" value="工具结果回灌，再决策（形成环）" edge="1" source="g38" target="g36"><mxGeometry relative="1" as="geometry" /></mxCell>
