        <mxCell id="n111" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;短期记忆 Short-term&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;thread 内消息历史：由 LangGraph checkpointer（InMemorySaver / SqliteSaver / PostgresSaver）自动持久化&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="790.0" y="1251" width="234.66666666666666" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n112" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;长期记忆 Long-term&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;跨 thread 的 Store（InMemoryStore / 数据库）：按 namespace 存 (key, value) + 向量检索&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1032.6666666666667" y="1251" width="234.66666666666666" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n113" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;读记忆&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;在 before_model 钩子或工具中按 user_id 检索 store，把相关片段拼进 system prompt&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1275.3333333333333" y="1251" width="234.66666666666666" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n114" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;写记忆&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;在 after_agent 钩子或后台任务中抽取事实/偏好 → 写入 store；要处理冲突与遗忘&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="790.0" y="1331" width="234.66666666666666" height="74" as="geometry"/>
