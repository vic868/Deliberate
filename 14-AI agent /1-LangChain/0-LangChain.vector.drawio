        <mxCell id="n308" value="&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;&lt;b&gt;术语对照（避免混淆）&lt;/b&gt;&lt;/div&gt;&lt;table style=&quot;font-size:11px;margin-top:2px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#f5f5f5;border:1px solid #666666&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;Chain（v1 前）= Runnable 组合出的处理管线（旧的「链」）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#dae8fc;border:1px solid #6c8ebf&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;Agent = 模型 + 工具 + 循环（v1 用 create_agent 构建）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#d5e8d4;border:1px solid #82b366&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;Graph = LangGraph 的状态机；Agent 只是其中一类图&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#ffe6cc;border:1px solid #d79b00&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;Run / Trace = LangSmith 中一次调用 / 一棵调用树的记录&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#e1d5e7;border:1px solid #9673a6&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;Middleware = 主循环上的「可挂钩点」，v1 的扩展核心&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#fff2cc;border:1px solid #d6b656&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;State / Thread / Checkpoint = LangGraph 的运行期状态、会话、快照&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="1050" width="740" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="n309" value="&lt;div style=&quot;font-size:12px;text-align:left&quot;&gt;&lt;b&gt;从 LangChain 到 LangGraph 的迁移信号（出现这些需求时就该上 LangGraph）&lt;/b&gt;&lt;/div&gt;&lt;table style=&quot;font-size:11px;margin-top:2px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#d5e8d4;border:1px solid #82b366&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;需要在 Agent 内部做显式分支（如「分类 → 走不同流程」）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#d5e8d4;border:1px solid #82b366&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;多个 Agent 协作：Supervisor 分派、并行评审、层级团队&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#d5e8d4;border:1px solid #82b366&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;复杂状态：任务清单、多个子产出、人工审阅节点&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#fff2cc;border:1px solid #d6b656&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;需要长时运行、断点续跑、time travel 回放&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#f5f5f5;border:1px solid #666666&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;需要把「非 LLM 的确定性步骤」也画进流程图&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 6px 1px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:22px;height:10px;background:#ffe6cc;border:1px solid #d79b00&quot;&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;font-size:11px&quot;&gt;需要精细控制循环次数、容错、重试与人工介入点&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="780" y="1050" width="740" height="170" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
