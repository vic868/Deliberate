<mxfile host="embed.diagrams.net" agent="dsh" version="24.7.17">
  <diagram id="page-knowledge-map" name="1 知识地图">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n10" value="&lt;b&gt;LangChain 1.x 知识地图  ——  模型 → 消息 → 提示 → 工具 → 智能体中间件 → 检索 → 记忆/RAG → 可观测&lt;/b&gt;" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=18;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1500" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="学习主线：LangChain（本节） → LangGraph（有状态图 / 多 Agent 编排，本页底部） → LangSmith（可观测、评测、提示管理）。标注「v1」的为新版推荐写法；标注「classic」的需 pip install langchain-classic 才可用。源码：docs.langchain.com" style="rounded=0;fillColor=#ffffff;strokeColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="68" width="1500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;① 模型层 Models —— 统一接口，屏蔽供应商差异&lt;/b&gt;" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=12;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="105" width="1500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;init_chat_model()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;v1 统一入口：模型 / 供应商 / 密钥 / 温度一次指定，切换供应商只改一行，支持 model=&amp;quot;provider:model&amp;quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• langchain.chat_models&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="141" width="240.0" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;invoke / stream / batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;invoke 一次返回；stream 逐 token 流式；batch 并发批量；异步为 ainvoke / astream，均返回 AIMessage&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• ChatModel 三件套&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="278.0" y="141" width="240.0" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;bind_tools / with_structured_output&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;把工具 schema 绑定给模型；with_structured_output(Pydantic) 直接产出结构化对象，无需解析 JSON&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 扩展能力&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="526.0" y="141" width="240.0" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;多模态与工具调用&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;图片 / 音频 / 文件放进 content_blocks；模型生成 tool_calls，交给 ToolNode 执行并回填结果&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 多模态&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="774.0" y="141" width="240.0" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;提供商包 langchain-*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;langchain-openai / anthropic / google-genai / ollama / aws … 独立发版、按需安装、可混用&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 生态包&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1022.0" y="141" width="240.0" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;Embeddings 向量模型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;init_embeddings() 或直接实例化；给文本转向量，用于语义检索、去重与聚类&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Embeddings&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1270.0" y="141" width="240.0" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;② 消息 Messages —— Agent 之间流动的「货币」（跨模型、跨轮次统一格式）&lt;/b&gt;" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=12;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="275" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;SystemMessage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;角色、约束、输出格式；v1 用 create_agent(system_prompt=...)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="311" width="189.0" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;HumanMessage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;用户输入；多模态内容放进 content_blocks&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="227.0" y="311" width="189.0" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;AIMessage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;模型回复：text + tool_calls + reasoning 推理块&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="424.0" y="311" width="189.0" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;ToolMessage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;工具结果，必须带 tool_call_id 与 AI 调用配对&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="621.0" y="311" width="189.0" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;content_blocks（v1 标准内容块）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;text / reasoning / tool_call / citation / image …… 同一个属性跨 Provider 统一访问，不同厂商的元能力用一致结构表达&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="385" width="189.0" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;消息操作与状态&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;add_messages reducer 追加消息；trim_messages 按 token 裁剪历史；messages_to_dict 序列化后存库或传给前端&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="227.0" y="385" width="189.0" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;多模态消息&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;文本 + 图片 + 文件 + 音频混排在一条消息里；能否使用取决于所选模型能力，不支持的模型会报错&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="424.0" y="385" width="189.0" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;消息即状态&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;LangGraph 里 messages 是最核心的 state 字段；所谓「多轮对话」就是把历史消息不断追加后重新提交&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="621.0" y="385" width="189.0" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;典型消息序列&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Human → AI(tool_calls) → Tool×N → AI(最终回答)，如此循环直到模型不再请求工具。&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="489" width="780" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;③ 提示 Prompts&lt;/b&gt;" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=12;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="350" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;ChatPromptTemplate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;角色 → 变量，format_messages / invoke 生成消息列表&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="654" width="330" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;MessagesPlaceholder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;在模板中预留对话历史 / 工具结果位置&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="686" width="330" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;PromptTemplate / FewShot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;纯字符串模板与示例注入（少样本提示）&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="718" width="330" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;hub / partial / 版本化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;集中管理 + 预填部分变量；hub 在 v1 已挪到 langchain-classic&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="750" width="330" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;v1 推荐&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;system_prompt 参数 + 代码拼装，复杂逻辑交给 middleware&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="782" width="330" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;为什么要模板&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;变量化 + 复用 + 可测试：同一套提示注入不同用户 / 语言 / 风格&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="822" width="106.0" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;提示即代码&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;写进 Git、走 Code Review、配单元测试；重要提示单独文件版本化&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="142.0" y="822" width="106.0" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;与 middleware 分工&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;模板负责「静态结构」，middleware 负责「运行时动态注入」&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="254.0" y="822" width="106.0" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;④ 工具 Tools&lt;/b&gt;" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=12;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="390" y="620" width="370" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;@tool 装饰器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;函数签名 + docstring 自动生成 schema，供 bind_tools&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="654" width="350" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;BaseTool / StructuredTool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;复杂参数、异步、校验、错误处理&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="686" width="350" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;设计原则&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;单一职责、描述清晰、幂等安全、限制返回长度&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="718" width="350" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;集成与注入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;MCP / 社区工具；State、Store、Runtime、Context 注入&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="750" width="350" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;错误策略&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;出错返回错误 ToolMessage 让模型自纠，而非抛异常中断&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="782" width="350" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;描述决定能力&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;模型只看 name + description + 参数 schema；含糊描述 = 用错工具&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="822" width="112.66666666666667" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;小而稳&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;一个工具一件事；复杂流程交给图编排，而不是塞进一个大工具&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="518.6666666666666" y="822" width="112.66666666666667" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;让模型能自纠&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;返回短而结构化的结果，失败时给出可读错误原因，而不是抛异常&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
