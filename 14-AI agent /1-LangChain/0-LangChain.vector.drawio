        <mxCell id="n156" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=1;fontSize=10;fontColor=#d6b656;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" edge="1" parent="1" source="        <mxCell id="n153" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontSize=11;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="1887.9375" width="22" height="22" as="geometry"/>
        </mxCell>" target="n155">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n157" value="&lt;b&gt;⑪ 常见陷阱 &amp;amp; 概念辨析（易错点）&lt;/b&gt;" style="rounded=0;fillColor=#b85450;strokeColor=#b85450;fontSize=12;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="785" y="1585" width="735" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n158" value="&lt;b&gt;LangChain != LangGraph&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LangChain 提供「组件 + 高层 Agent」；LangGraph 提供「状态图编排」。create_agent 就是一层 LangGraph 封装，两者不是竞争关系&lt;/font&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="795" y="1619.0" width="715" height="35.57142857142857" as="geometry"/>
        </mxCell>
        <mxCell id="n159" value="&lt;b&gt;v1 起 create_react_agent 已过时&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;改用 create_agent；import 报模块不存在，多半是没装 langchain-classic（旧链/旧 Retriever/hub）&lt;/font&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="795" y="1662.5714285714287" width="715" height="35.57142857142857" as="geometry"/>
        </mxCell>
        <mxCell id="n160" value="&lt;b&gt;消息配对要完整&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AIMessage.tool_calls 与 ToolMessage.tool_call_id 必须一一对应，否则模型报错或行为异常&lt;/font&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="795" y="1706.142857142857" width="715" height="35.57142857142857" as="geometry"/>
        </mxCell>
        <mxCell id="n161" value="&lt;b&gt;RAG 不是万能药&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;检索失败占多数：切分太大/太小、向量模型不匹配领域、召回未重排；先加 LangSmith 追踪看命中&lt;/font&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="795" y="1749.7142857142858" width="715" height="35.57142857142857" as="geometry"/>
        </mxCell>
        <mxCell id="n162" value="&lt;b&gt;Prompt 与代码耦合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;把提示写死在几十处难维护；用 hub / 版本管理 / 模板集中存放，并纳入评测&lt;/font&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="795" y="1793.2857142857142" width="715" height="35.57142857142857" as="geometry"/>
        </mxCell>
        <mxCell id="n163" value="&lt;b&gt;评测优先&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;先建数据集与指标，再谈优化；否则每次「优化」都靠感觉&lt;/font&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="795" y="1836.857142857143" width="715" height="35.57142857142857" as="geometry"/>
        </mxCell>
        <mxCell id="n164" value="&lt;b&gt;密钥安全&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;.env + 环境变量，绝不硬编码；Agent 工具要做权限/确认（HITL）&lt;/font&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="795" y="1880.4285714285716" width="715" height="35.57142857142857" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
