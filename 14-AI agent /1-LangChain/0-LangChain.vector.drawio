          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1358" y="812"/><mxPoint x="1128" y="812"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="n62" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;一句话理解&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 提示告诉模型「怎么回答」，工具告诉模型「能做什么」，消息是交互留下的「记录」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 模型本身没有记忆：每次调用都把 messages + 系统提示 + 工具清单一起提交，这就是它的「世界」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 优化 Agent 的四个杠杆：提示、工具、上下文（消息 + 检索）、外层循环（middleware / 图）。&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;verticalAlign=top;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="794" y="842" width="700" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="n63" value="&lt;b&gt;⑤ Agent 主循环（v1 核心：create_agent）—— 模型决定调用工具，结果回灌消息，再进模型，无工具调用即结束&lt;/b&gt;" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=12;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="965" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n64" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;输入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;user messages / context&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#1f3864;fontSize=11;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="32" y="1003" width="146" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n65" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;① 调用模型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;bind_tools → AIMessage.tool_calls&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#1f3864;fontSize=11;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="32" y="1059" width="146" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n66" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;② 有 tool_calls？&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;判断是否还要用工具&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#1f3864;fontSize=11;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="226" y="1059" width="146" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n67" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;③ 执行工具&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;ToolNode → ToolMessage&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#1f3864;fontSize=11;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="32" y="1115" width="146" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n68" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;无 tool_calls → 最终回答&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#1f3864;fontSize=11;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="226" y="1115" width="146" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="n69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1f3864;strokeWidth=1.3;fontSize=10;fontColor=#1f3864;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" edge="1" parent="1" source="n64" target="n65">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1f3864;strokeWidth=1.3;fontSize=10;fontColor=#1f3864;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" edge="1" parent="1" source="n65" target="n66">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" edge="1" parent="1" source="n66" target="n68">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#b85450;strokeWidth=1.3;fontSize=10;fontColor=#b85450;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;" edge="1" parent="1" source="n67" target="n65">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n73" value="是：执行工具，回灌 ToolMessage" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450;strokeColor=none;fillColor=#ffffff;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="184" y="1107" width="200" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="n74" value="否" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;strokeColor=none;fillColor=#ffffff;whiteSpace=wrap;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="376" y="1071" width="22" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="n75" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;理解要点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 一次响应可含多个 tool_calls → 并行执行，各自回一条 ToolMessage&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 工具报错不中断：错误写进 ToolMessage，让模型自己修正&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 循环上限靠 middleware 或图的条件边兜底，防止死循环&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 每轮都提交完整消息历史 → 所以需要压缩与记忆机制&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;verticalAlign=top;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="382" y="1001" width="186" height="186" as="geometry"/>
        </mxCell>
        <mxCell id="n76" value="" style="rounded=0;fillColor=#fbfbf9;strokeColor=#1f3864;align=left;verticalAlign=top;spacing=6;overflow:hidden!important;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="432" y="999" width="474" height="190" as="geometry"/>
        </mxCell>
