        <mxCell id="n306" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;动手项目&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;个人笔记问答（本知识库）、自动化研究报告 Agent、带审批的邮件/日历助手&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
