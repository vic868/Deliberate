          <mxGeometry x="272.66666666666663" y="1251" width="234.66666666666666" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n106" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;向量存储 Vector Stores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;Chroma / FAISS / pgvector / Milvus / Qdrant / Pinecone；similarity_search、MMR 去冗余&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
