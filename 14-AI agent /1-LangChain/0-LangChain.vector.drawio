          <mxGeometry x="30.0" y="1331" width="234.66666666666666" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="n108" value="&lt;div style=&quot;text-align:left;line-height:1.35;margin-left:4px&quot;&gt;&lt;b&gt;RAG 进阶&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#555555&quot;&gt;查询改写 → 路由 → 多路召回 → 融合 → 重排 → 压缩 → 生成；评估用 RAGAS / LangSmith 数据集&lt;/font&gt;&lt;/div&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1a1a1a;arcSize=6;spacing=6;opacity=100;html=1;align=left;verticalAlign=middle;;whiteSpace=wrap;" vertex="1" parent="1">
