        </mxCell>
        <mxCell id="n110" value="&lt;b&gt;⑧ 记忆 Memory —— 短期会话记忆 + 长期语义记忆&lt;/b&gt;" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=12;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;" vertex="1" parent="1">
