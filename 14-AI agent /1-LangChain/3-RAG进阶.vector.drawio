        <mxCell id="c58" value="中文或多语言任务可作对比项" style="rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
