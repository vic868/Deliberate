        <mxCell id="c89" value="&lt;b&gt;稳定标签&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="516.7" y="729" width="233.3" height="22" as="geometry">
