            <mxRectangle width="740" height="28" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;Recursive 递归切分&lt;/b&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="164" width="172.5" height="26" as="geometry">
            <mxRectangle width="172.5" height="26" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c24" value="按段落→行→空格&#10;逐级降级拆分；&#10;chunk_size 与 overlap&#10;是两个大旋钮，&#10;默认基线就用它" style="rounded=1;fillColor=#fbfbf9;strokeColor=#6c8ebf;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="190" width="172.5" height="122" as="geometry">
            <mxRectangle width="172.5" height="122" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;中文/日文换分隔符&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="212.5" y="164" width="172.5" height="26" as="geometry">
            <mxRectangle width="172.5" height="26" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c26" value="默认分隔符不友好：&#10;加入全角逗号「，」、&#10;顿号「、」、句号「。」，&#10;避免把词切成两半" style="rounded=1;fillColor=#fbfbf9;strokeColor=#6c8ebf;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="212.5" y="190" width="172.5" height="122" as="geometry">
            <mxRectangle width="172.5" height="122" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;按 Markdown 标题切&lt;/b&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="395.0" y="164" width="172.5" height="26" as="geometry">
            <mxRectangle width="172.5" height="26" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c28" value="按 # / ## 分层切，&#10;标题层级写进 metadata；&#10;命中后能知道&#10;出自哪一节的第几段" style="rounded=1;fillColor=#fbfbf9;strokeColor=#6c8ebf;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="395.0" y="190" width="172.5" height="122" as="geometry">
            <mxRectangle width="172.5" height="122" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;语义切分（实验性）&lt;/b&gt;" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="577.5" y="164" width="172.5" height="26" as="geometry">
            <mxRectangle width="172.5" height="26" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c30" value="基于句向量邻接相似度&#10;找断点，比长度切分&#10;更贴语义；更慢、&#10;结果不稳定，慎用于长文" style="rounded=1;fillColor=#fbfbf9;strokeColor=#6c8ebf;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="577.5" y="190" width="172.5" height="122" as="geometry">
            <mxRectangle width="172.5" height="122" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c31" value="切分评测法：固定 embedder，扫 chunk_size ∈ {256,512,1024}、overlap ∈ {0,10%,20%}，在固定 query 集上看 Hit@5 与拼接后的回答质量。没有评测就不要调参。" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
