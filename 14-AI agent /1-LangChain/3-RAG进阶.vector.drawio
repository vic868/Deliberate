          </mxGeometry>
        </mxCell>
        <mxCell id="c59" value="&lt;b&gt;对比方法&lt;/b&gt;：同一份切分、同一批 query、只换 embedder，看检索指标（第 ⑥ 节）与成本/延迟。换 embedder = 全量重建向量库；把模型版本号写进 collection 名或 metadata。" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
