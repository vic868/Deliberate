        </mxCell>
        <mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;strokeWidth=1.4;fontSize=9;fontColor=#555555;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c66" target="c67">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c74" value="from langchain_milvus import Milvus, BM25BuiltInFunction&lt;br&gt;vs = Milvus.from_documents(docs, embedding=emb,&lt;br&gt;    builtin_function=BM25BuiltInFunction(),&lt;br&gt;    vector_field=[&quot;dense&quot;, &quot;sparse&quot;],  # 稠密 + BM25 稀疏&lt;br&gt;    connection_args={&quot;uri&quot;: URI}, drop_old=True)&lt;br&gt;vs.similarity_search(q, k=5, ranker_type=&quot;rrf&quot;)&lt;br&gt;vs.similarity_search(q, k=5, ranker_type=&quot;weighted&quot;,&lt;br&gt;                      ranker_params={&quot;weights&quot;: [0.6, 0.4]})" style="rounded=1;fillColor=#fbfbf9;strokeColor=#1f3864;fontSize=8;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1010" y="389" width="500" height="112" as="geometry">
            <mxRectangle width="500" height="112" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c75" value="&lt;b&gt;易错点&lt;/b&gt;：BM25 内置函数要 Milvus Standalone/Distributed，&lt;b&gt;Milvus Lite 不支持&lt;/b&gt;（这也是上第 3 页的原因）；改 BM25 分词要设 analyzer_params；Rerank 后要把 rerank_score 写回 metadata 方便调试。" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="534" width="980" height="40" as="geometry">
            <mxRectangle width="980" height="40" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c76" value="&lt;b&gt;为什么 Hybrid 有用&lt;/b&gt;：查询含编号/专有名词（如「TS-999」）时 BM25 命中精确串、稠密向量易漏；Anthropic 实测（Contextual Retrieval）：&lt;br&gt;Contextual Embeddings 单独让检索失败率 -35%，&lt;br&gt;再加 Contextual BM25 共 -49%。" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1020" y="509" width="490" height="76" as="geometry">
            <mxRectangle width="490" height="76" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c77" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9aa6b2;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="611" width="740" height="200" as="geometry">
            <mxRectangle width="740" height="200" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c78" value="④  Prompt 里怎样拼检索结果最有效" style="rounded=0;fillColor=#1f3864;strokeColor=#1f3864;fontSize=10;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="20" y="611" width="740" height="28" as="geometry">
            <mxRectangle width="740" height="28" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c79" value="&lt;b&gt;带来源与定位&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="647" width="233.3" height="22" as="geometry">
            <mxRectangle width="233.3" height="22" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c80" value="每条放 [id] 标题 / 来源路径 / 段落号，正文里要求引用 [id]，便于回查、评测与引用" style="rounded=1;fillColor=#fffaf0;strokeColor=#d6b656;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="669" width="233.3" height="54" as="geometry">
            <mxRectangle width="233.3" height="54" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c81" value="&lt;b&gt;去重与截断&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="273.3" y="647" width="233.3" height="22" as="geometry">
            <mxRectangle width="233.3" height="22" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c82" value="按 parent doc 去重，单文档最多 k 条；每条截断到 800~1500 字，长文用摘要 + 原文双轨" style="rounded=1;fillColor=#fffaf0;strokeColor=#d6b656;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="273.3" y="669" width="233.3" height="54" as="geometry">
            <mxRectangle width="233.3" height="54" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c83" value="&lt;b&gt;顺序有讲究&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="516.7" y="647" width="233.3" height="22" as="geometry">
            <mxRectangle width="233.3" height="22" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c84" value="「关键信息在开头结尾、中间容易丢」：最相关的放最前，其次是最后，弱相关的放中间" style="rounded=1;fillColor=#fffaf0;strokeColor=#d6b656;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="516.7" y="669" width="233.3" height="54" as="geometry">
            <mxRectangle width="233.3" height="54" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c85" value="&lt;b&gt;上下文增强&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="729" width="233.3" height="22" as="geometry">
            <mxRectangle width="233.3" height="22" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c86" value="切分时给每个 chunk 加段落摘要/标题上下文（Contextual Retrieval 思路），检索与生成都受益" style="rounded=1;fillColor=#fffaf0;strokeColor=#d6b656;fontSize=7.5;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="751" width="233.3" height="54" as="geometry">
            <mxRectangle width="233.3" height="54" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c87" value="&lt;b&gt;明确边界&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="273.3" y="729" width="233.3" height="22" as="geometry">
            <mxRectangle width="233.3" height="22" as="alternateBounds"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c88" value="明确说「只用给定资料，资料里没有就说不知道」，降低幻觉" style="rounded=1;fillColor=#fffaf0;strokeColor=#d6b656;fontSize=8;fontColor=#1a1a1a;arcSize=8;spacing=6;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;" vertex="1" parent="1">
