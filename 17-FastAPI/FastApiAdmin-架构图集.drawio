  <diagram id="page-6" name="6 国密加密">
    <mxGraphModel dx="1869" dy="1153" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="国密加密体系：SM2 / SM3 / SM4 各管一段" vertex="1">
          <mxGeometry height="36" width="760" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sm2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" value="&lt;b&gt;SM2（非对称）&lt;/b&gt;&lt;br/&gt;登录密码传输加密&lt;br/&gt;&lt;font style=&#39;font-size:11px&#39;&gt;前端公钥加密 → 后端私钥解密&lt;br/&gt;密文以 04 开头（非压缩点格式）&lt;br/&gt;坑：Java 端默认密文格式是 C1C3C2&lt;br/&gt;Python gmssl 是 C1C2C3，跨端要统一&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="360" x="80" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sm3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" value="&lt;b&gt;SM3（哈希）&lt;/b&gt;&lt;br/&gt;密码存储&lt;br/&gt;&lt;font style=&#39;font-size:11px&#39;&gt;PwdUtil：SM3(明文 + 随机盐)&lt;br/&gt;存储格式：{salt_hex}${hash_hex}&lt;br/&gt;不用 bcrypt：等保/密评要求国密算法&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="360" x="500" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sm4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;" value="&lt;b&gt;SM4（对称，CBC）&lt;/b&gt;&lt;br/&gt;字段级加密&lt;br/&gt;&lt;font style=&#39;font-size:11px&#39;&gt;手机号/身份证等敏感字段落库前加密&lt;br/&gt;TypeDecorator 透明加解密&lt;br/&gt;查询需先加密后比对（等值查询）&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="920" y="100" as="geometry" />
        </mxCell>
        <mxCell id="gf6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;opacity=70" value="登录加密时序（三端互通的关键）" vertex="1">
          <mxGeometry height="260" width="1180" x="80" y="300" as="geometry" />
        </mxCell>
        <mxCell id="q1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" value="前端 SM2 公钥加密 密码" vertex="1">
          <mxGeometry height="80" width="170" x="110" y="370" as="geometry" />
        </mxCell>
        <mxCell id="q2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" value="传输 04 开头密文" vertex="1">
          <mxGeometry height="80" width="170" x="350" y="370" as="geometry" />
        </mxCell>
        <mxCell id="q3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" value="后端 SM2 私钥解密" vertex="1">
          <mxGeometry height="80" width="170" x="550" y="370" as="geometry" />
        </mxCell>
        <mxCell id="q4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" value="SM3(明文+盐) 比对库中 hash" vertex="1">
          <mxGeometry height="80" width="170" x="750" y="370" as="geometry" />
        </mxCell>
        <mxCell id="q5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" value="通过 → 签发 JWT" vertex="1">
          <mxGeometry height="80" width="170" x="980" y="370" as="geometry" />
        </mxCell>
        <mxCell id="qe1" edge="1" parent="1" source="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=11;fontColor=#333333;" target="q2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe2" edge="1" parent="1" source="q2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=11;fontColor=#333333;" target="q3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe3" edge="1" parent="1" source="q3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=11;fontColor=#333333;" target="q4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe4" edge="1" parent="1" source="q4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;fontSize=11;fontColor=#333333;" target="q5" value="通过">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" value="跨端互通要点：Web / UniApp / Flutter 三端必须使用同一套 SM2 密钥对与密文排列（C1C2C3 或 C1C3C2 二选一），SM4 使用统一的 KEY 与 IV 约定。 utils/sm_crypto_util.py 是唯一的加解密封装 —— 密码哈希（PwdUtil）也在这里，不在 security.py（security.py 只管 JWT）。" vertex="1">
          <mxGeometry height="90" width="1180" x="80" y="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
