          <mxGeometry height="22" width="440" x="1060" y="328" as="geometry" />
        </mxCell>
        <mxCell id="p04_t44" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" value="投了 Yes，却既不能单方面提交，也不能回滚。&#xa;唯一能做的是阻塞等待。" vertex="1">
          <mxGeometry height="48" width="440" x="1060" y="358" as="geometry" />
        </mxCell>
