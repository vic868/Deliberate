          <mxGeometry height="24" width="460" x="1044" y="168" as="geometry" />
        </mxCell>
        <mxCell id="p04_p39" parent="1" style="rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="100" width="480" x="1040" y="202" as="geometry" />
