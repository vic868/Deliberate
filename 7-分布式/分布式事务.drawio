        <mxCell id="p04_t40" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="① 协调者单点" vertex="1">
