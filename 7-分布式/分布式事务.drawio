          <mxGeometry height="22" width="440" x="1060" y="558" as="geometry" />
        </mxCell>
        <mxCell id="p04_t50" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" value="多一轮 CanCommit + 参与者超时自主提交；&#xa;只缓解协调者宕机，不解决分区脑裂，工程几乎不用。" vertex="1">
          <mxGeometry height="46" width="440" x="1060" y="584" as="geometry" />
        </mxCell>
        <mxCell id="p04_p51" parent="1" style="rounded=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" value="" vertex="1">
