            <mxPoint x="1160" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p07_t42" value="返回事务状态" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
