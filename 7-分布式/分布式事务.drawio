        <mxCell id="p07_t44" value="⑥ 投递消息" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#0891B2;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="636" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p07_t45" value="回查逻辑必须能从 DB 查到确定答案，不能依赖 JVM 内存；&#xa;达到上限后的默认策略，决定极端情况下是丢消息还是多消息。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="692" width="660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p07_p46" value="" style="rounded=1;arcSize=10;fillColor=#ECFEFF;strokeColor=#A5F3FC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="770" width="660" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p07_t47" value="顺序与本地消息表相反：这里是「先发半消息，后写本地事务」。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="858" y="782" width="624" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p07_p48" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p07_t49" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p07_t50" value="不丢 ≠ 不重：at-least-once 是事实，「消费幂等」才是把重复收敛成一次效果的解。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p08" name="07 Seata AT">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p08_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="42" width="7" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p08_title" value="Seata AT：本地事务先提交，再用 undo log 事后补偿" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="36" width="1180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p08_sub" value="它用「全局锁」换取写隔离，用「本地提交」换取性能；不是免费的强一致。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="82" width="1330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p08_num" value="08 / 10" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1370" y="44" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p08_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="118" as="sourcePoint" />
            <mxPoint x="1540" y="118" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="940" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p08_t2" value="一阶段：拦截、记录、申请锁、本地提交" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="168" width="880" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p08_b3" value="① 拦截 SQL&#xa;解析 before / after image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=11;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p08_b4" value="② 写 undo log&#xa;和业务数据同库" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=11;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="240" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p08_b5" value="③ 申请全局锁&#xa;拿到才允许提交" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=11;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="240" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p08_b6" value="④ 提交本地事务&#xa;本地锁随即释放" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=11;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="240" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p08_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1" source="p08_b3" target="p08_b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p08_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1" source="p08_b4" target="p08_b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p08_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1" source="p08_b5" target="p08_b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p08_bl10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D97706;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="385" as="sourcePoint" />
            <mxPoint x="980" y="385" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_bt111" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D97706;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="379" as="sourcePoint" />
            <mxPoint x="560" y="391" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_bt212" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#D97706;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="379" as="sourcePoint" />
            <mxPoint x="980" y="391" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_t13" value="全局锁：一直持有到全局事务结束" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10.5;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="402" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p08_t14" value="二阶段：根据全局结果，删除 undo 或反向补偿" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="428" width="880" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08_b15" value="全局提交&#xa;异步删除 undo log（很快）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=12;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="490" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p08_b16" value="全局回滚&#xa;before image → 反向 SQL → 删除 undo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="490" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p08_a17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.4;endArrow=none;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="385" as="sourcePoint" />
            <mxPoint x="750" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_a18" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#D97706;strokeWidth=1.4;endArrow=none;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="460" as="sourcePoint" />
            <mxPoint x="290" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_a19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="460" as="sourcePoint" />
            <mxPoint x="290" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_a20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="460" as="sourcePoint" />
            <mxPoint x="750" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p08_p21" value="" style="rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="860" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p08_t22" value="关键差异：一阶段本地事务已经提交，数据对外可见。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="120" y="644" width="820" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p08_t23" value="所以 AT 的回滚不是「撤销未提交」，而是「用 undo log 做补偿」；&#xa;补偿窗口内，别人可能已经读到了中间态。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="120" y="674" width="820" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p08_t24" value="一句话：本地事务换性能，全局锁换隔离，undo log 换回滚。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="104" y="732" width="840" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08_p25" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="150" width="520" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p08_t26" value="两把锁，决定 AT 的脾气" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1044" y="168" width="460" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p08_t27" value="本地锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1044" y="212" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p08_p28" value="" style="rounded=1;arcSize=6;fillColor=#059669;strokeColor=#059669;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="215" width="70" height="12" as="geometry" />
        </mxCell>
        <mxCell id="p08_t29" value="毫秒级" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="212" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p08_t30" value="全局锁" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1044" y="248" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p08_p31" value="" style="rounded=1;arcSize=6;fillColor=#D97706;strokeColor=#D97706;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="251" width="340" height="12" as="geometry" />
        </mxCell>
        <mxCell id="p08_t32" value="整个全局事务期间（远长于本地锁）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="270" width="380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p08_p33" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="300" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p08_t34" value="热点行排队" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="312" width="440" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08_t35" value="同一行的全局事务在 TC 上排队；&#xa;高峰出现 lock wait timeout。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="340" width="440" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p08_p36" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="404" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p08_t37" value="undo log 膨胀" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="416" width="440" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08_t38" value="每个分支一条记录；&#xa;必须配置保留时长与清理任务。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="444" width="440" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p08_p39" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="508" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p08_t40" value="绕过 Seata = 脏写" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="520" width="440" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p08_t41" value="全局锁只在 Seata 体系内有效；&#xa;直连 SQL 会让回滚覆盖别人的更新。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="548" width="440" height="42" as="geometry" />
        </mxCell>
        <mxCell id="p08_p42" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="620" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p08_t43" value="AT 的准确定位" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1062" y="636" width="440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p08_t44" value="不是「无侵入的强一致」，&#xa;而是「低侵入 + 足够好的一致性&#xa;+ 全局锁的热点代价」。&#xa;&#xa;适用：短事务、简单 SQL、非热点。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1062" y="668" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p08_p45" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p08_t46" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p08_t47" value="AT 最危险的不是性能，而是在全局事务里做 RPC / 等回调 —— 全局锁会被拉到你无法承受的长度。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p09" name="08 三道防线">
    <mxGraphModel dx="1986" dy="1183" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p09_accent" parent="1" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="54" width="7" x="60" y="42" as="geometry" />
        </mxCell>
        <mxCell id="p09_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" value="最终一致的三道防线：幂等 → 可观测 → 对账" vertex="1">
          <mxGeometry height="44" width="1180" x="82" y="36" as="geometry" />
        </mxCell>
        <mxCell id="p09_sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" value="前两道是乐观假设；对账是唯一的双向、独立校验，也是最后一道防线。" vertex="1">
          <mxGeometry height="24" width="1330" x="82" y="82" as="geometry" />
        </mxCell>
        <mxCell id="p09_num" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" value="09 / 10" vertex="1">
          <mxGeometry height="24" width="170" x="1370" y="44" as="geometry" />
        </mxCell>
        <mxCell id="p09_hdrline" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="118" as="sourcePoint" />
            <mxPoint x="1540" y="118" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p09_p1" parent="1" style="rounded=1;arcSize=16;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" value="" vertex="1">
