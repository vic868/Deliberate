        <mxCell id="p04_t35" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="为什么锁会被拉长？" vertex="1">
          <mxGeometry height="24" width="840" x="104" y="734" as="geometry" />
        </mxCell>
        <mxCell id="p04_t36" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" value="本地事务：锁持有时间由本地 CPU / IO 决定，毫秒级。&#xa;2PC：锁持有时间 = 网络 RTT + 最慢参与者 + 协调者是否还活着。" vertex="1">
          <mxGeometry height="50" width="840" x="104" y="762" as="geometry" />
        </mxCell>
        <mxCell id="p04_p37" parent="1" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" value="" vertex="1">
