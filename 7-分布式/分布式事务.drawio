          <mxGeometry height="48" width="440" x="1060" y="246" as="geometry" />
        </mxCell>
        <mxCell id="p04_p42" parent="1" style="rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" value="" vertex="1">
