        <mxCell id="p07_a39" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 5;" edge="1" parent="1">
