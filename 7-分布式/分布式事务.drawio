          <mxGeometry height="22" width="440" x="1060" y="440" as="geometry" />
        </mxCell>
        <mxCell id="p04_t47" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" value="A 已提交、B 未提交；系统进入坏状态。&#xa;只能等协调者恢复，或 DBA 手工处理。" vertex="1">
          <mxGeometry height="48" width="440" x="1060" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p04_p48" parent="1" style="rounded=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" value="" vertex="1">
