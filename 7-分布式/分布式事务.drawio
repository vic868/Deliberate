            <mxPoint x="1160" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p07_t38" value="④ commit / rollback" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="940" y="476" width="220" height="20" as="geometry" />
