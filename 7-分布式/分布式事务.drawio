        </mxCell>
        <mxCell id="p04_t52" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="XA：把 2PC 做成标准接口" vertex="1">
          <mxGeometry height="22" width="440" x="1060" y="666" as="geometry" />
        </mxCell>
        <mxCell id="p04_t53" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="XA START → END → PREPARE → COMMIT" vertex="1">
          <mxGeometry height="24" width="440" x="1060" y="696" as="geometry" />
        </mxCell>
        <mxCell id="p04_t54" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" value="PREPARE 才真正持锁；&#xa;XA RECOVER 查看处于 prepared 的未决事务。&#xa;事务边界与业务边界，往往对不齐。" vertex="1">
          <mxGeometry height="74" width="440" x="1060" y="724" as="geometry" />
        </mxCell>
        <mxCell id="p04_p55" parent="1" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="72" width="1480" x="60" y="892" as="geometry" />
        </mxCell>
        <mxCell id="p04_t56" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="记住" vertex="1">
          <mxGeometry height="44" width="86" x="88" y="906" as="geometry" />
        </mxCell>
        <mxCell id="p04_t57" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" value="2PC 提供原子性，却把可用性绑在协调者身上；互联网核心链路通常不选它。" vertex="1">
          <mxGeometry height="52" width="1330" x="176" y="902" as="geometry" />
