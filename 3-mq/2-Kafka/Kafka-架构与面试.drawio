        <mxCell id="k05_t43" value="acks=all：等当前 ISR 全部确认；&#xa;ISR 数量 &lt; min.insync.replicas 时，leader 直接拒写（保可靠、牺牲可用）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="650" width="640" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k05_t44" value="幂等：PID + epoch + seq；broker 每个 (PID, 分区) 只保留最近 5 个批次。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
