        <mxCell id="k10_t2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="Q1" vertex="1">
          <mxGeometry height="24" width="40" x="80" y="176" as="geometry" />
        </mxCell>
        <mxCell id="k10_t3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="如何保证消息不丢失？" vertex="1">
          <mxGeometry height="26" width="400" x="122" y="174" as="geometry" />
        </mxCell>
        <mxCell id="k10_t4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" value="·  生产端：acks=all + retries + 处理回调" vertex="1">
          <mxGeometry height="20" width="438" x="82" y="214" as="geometry" />
        </mxCell>
        <mxCell id="k10_t5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" value="·  Broker：RF≥3 + minISR≥2 + unclean=false" vertex="1">
          <mxGeometry height="20" width="438" x="82" y="239" as="geometry" />
        </mxCell>
        <mxCell id="k10_t6" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" value="·  消费端：关闭自动提交，处理成功再提交" vertex="1">
          <mxGeometry height="20" width="438" x="82" y="264" as="geometry" />
        </mxCell>
        <mxCell id="k10_t7" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.3;fontColor=#7F1D1D;fontFamily=PingFang SC;spacing=0;" value="边界：整机断电仍可能丢未刷盘数据；acks=all 不是充分条件。" vertex="1">
          <mxGeometry height="40" width="438" x="82" y="320" as="geometry" />
        </mxCell>
        <mxCell id="k10_p8" parent="1" style="rounded=1;arcSize=16;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="210" width="480" x="560" y="160" as="geometry" />
        </mxCell>
        <mxCell id="k10_t9" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="Q2" vertex="1">
          <mxGeometry height="24" width="40" x="580" y="176" as="geometry" />
        </mxCell>
        <mxCell id="k10_t10" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" value="如何保证消息不重复？" vertex="1">
          <mxGeometry height="26" width="400" x="622" y="174" as="geometry" />
        </mxCell>
        <mxCell id="k10_t11" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" value="·  幂等生产者：PID + 分区级 sequence" vertex="1">
          <mxGeometry height="20" width="438" x="582" y="214" as="geometry" />
        </mxCell>
        <mxCell id="k10_t12" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" value="·  事务：跨分区原子写 + 位移入事务" vertex="1">
          <mxGeometry height="20" width="438" x="582" y="239" as="geometry" />
        </mxCell>
        <mxCell id="k10_t13" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" value="·  业务侧：唯一键 / 去重表 / 状态机" vertex="1">
          <mxGeometry height="20" width="438" x="582" y="264" as="geometry" />
        </mxCell>
        <mxCell id="k10_t14" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.3;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" value="边界：幂等只覆盖单会话单分区；事务只覆盖 Kafka 内部。" vertex="1">
          <mxGeometry height="40" width="438" x="582" y="320" as="geometry" />
        </mxCell>
        <mxCell id="k10_p15" parent="1" style="rounded=1;arcSize=16;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1;" value="" vertex="1">
