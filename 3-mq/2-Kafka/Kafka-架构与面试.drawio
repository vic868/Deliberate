        </mxCell>
        <mxCell id="k09_lso" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#DC2626;strokeWidth=1.4;dashed=1;dashPattern=6 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="636" as="sourcePoint" />
            <mxPoint x="1170" y="684" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_t48" value="LSO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1138" y="662" width="34" height="18" as="geometry" />
        </mxCell>
        <mxCell id="k09_p49" value="" style="rounded=1;arcSize=4;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="636" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="k09_t50" value="T2 Ongoing" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=8.5;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1170" y="640" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k09_t51" value="LSO 之前的已提交数据可读；LSO 之后即使已提交也读不到。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1084" y="680" width="420" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k09_t52" value="长事务会把 LSO 钉住 → 队头阻塞；&#xa;transaction.timeout.ms 是兜底，不是越大越好。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1084" y="708" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k09_t53" value="公式：EOS = 幂等 + 事务 + read_committed&#xa;+ sendOffsetsToTransaction。&#xa;边界：只在 Kafka 内部闭环。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1084" y="770" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k09_p54" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="k09_t55" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k09_t56" value="幂等解决“重试重复”，事务解决“输出 + 位移的原子性”；一旦出了 Kafka，仍然要靠业务幂等。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
