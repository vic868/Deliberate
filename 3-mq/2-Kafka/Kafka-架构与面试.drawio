        </mxCell>
        <mxCell id="k04_p57" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="552" width="460" height="128" as="geometry" />
        </mxCell>
        <mxCell id="k04_t58" value="常见误区：Broker 是无状态的" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1078" y="566" width="420" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k04_t59" value="错。它实实在在存着分区副本；只是不保存消费进度。&#xa;正因为不保存“谁读到哪”，消费者才能任意上下线。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1078" y="596" width="420" height="72" as="geometry" />
        </mxCell>
        <mxCell id="k04_p60" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="696" width="460" height="132" as="geometry" />
        </mxCell>
        <mxCell id="k04_t61" value="面试点：线程数与背压" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1078" y="710" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k04_t62" value="num.network.threads 只收发、入队；&#xa;num.io.threads 才做重活；&#xa;队列满会背压；磁盘满时加线程没用。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1078" y="738" width="420" height="78" as="geometry" />
        </mxCell>
        <mxCell id="k04_p63" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="k04_t64" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k04_t65" value="网络线程不做重活，IO 线程做重活；队列是背压；真正的瓶颈通常在磁盘与副本，而不在线程数。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
