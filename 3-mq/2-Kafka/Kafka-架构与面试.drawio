        <mxCell id="k08_t3" value="顺序写" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="82" y="224" width="240" height="28" as="geometry" />
