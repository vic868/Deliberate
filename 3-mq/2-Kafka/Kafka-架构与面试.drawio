        <mxCell id="k10_t39" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" value="·  看曲线：持续增长 / 突增 / 锯齿" vertex="1">
