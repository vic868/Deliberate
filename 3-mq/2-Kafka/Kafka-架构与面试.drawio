        </mxCell>
        <mxCell id="k03_t47" value="面试点：分区数 = 吞吐上限 = 消费并行度上限；扩分区会打乱同 key 的归属。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
