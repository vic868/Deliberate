        <mxCell id="k08_b7" value="0" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#D97706;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="84" y="500" width="50" height="34" as="geometry" />
