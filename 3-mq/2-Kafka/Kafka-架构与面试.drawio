        <mxCell id="k07_t31" value="fetch" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
