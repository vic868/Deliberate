        <mxCell id="k02_t52" value="Controller：分区 / 副本状态、leader 选举" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
