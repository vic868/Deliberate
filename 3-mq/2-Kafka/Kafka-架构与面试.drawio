        <mxCell id="k07_p37" value="" style="rounded=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="330" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k07_t38" value="F2 不在 ISR" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1058" y="342" width="190" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k07_t39" value="不能接 leader；只能继续追" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1058" y="366" width="190" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k07_t40" value="ISR 判定基于时间：follower 在 replica.lag.time.max.ms 内没发 fetch 或没追到 LEO，就被踢出。&#xa;不是“所有活着的副本”，也不是“落后多少条”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="470" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k07_p41" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="700" height="270" as="geometry" />
        </mxCell>
        <mxCell id="k07_t42" value="Leader 挂了：谁接班？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="598" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k07_p43" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k07_t44" value="Controller 从 ISR 选新 leader" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="116" y="642" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k07_t45" value="通常是 F1；F2 没有资格" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="116" y="668" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k07_p46" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k07_t47" value="unclean=false（默认）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="416" y="642" width="290" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k07_t48" value="宁可分区不可用，也不丢数据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="416" y="668" width="290" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k07_t49" value="unclean=true：允许非 ISR 副本当选，分区恢复可用，但会截断已确认数据。&#xa;选举前先比较 Leader Epoch，再决定截断点。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="718" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k07_p50" value="" style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="786" width="620" height="48" as="geometry" />
        </mxCell>
        <mxCell id="k07_t51" value="Leader Epoch = 每次换 leader +1；用 OffsetsForLeaderEpoch 协商截断点，替代用 HW 猜。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="116" y="796" width="590" height="28" as="geometry" />
        </mxCell>
        <mxCell id="k07_p52" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="580" width="740" height="270" as="geometry" />
        </mxCell>
        <mxCell id="k07_t53" value="面试点：四个必须说清的概念" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="824" y="598" width="680" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k07_t54" value="·" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="824" y="634" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t55" value="HW ≠ LEO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="634" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t56" value="HW 是 ISR 全部同步到的位置；leader 的 LEO 通常更大。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="656" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t57" value="·" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="824" y="684" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t58" value="ISR ≠ 所有活副本" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="684" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t59" value="落后超时会被踢出；ISR 是动态集合。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="706" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t60" value="·" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="824" y="734" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t61" value="acks=all 仍可能丢" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="734" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t62" value="还要 min.insync.replicas≥2 + unclean=false。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="756" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t63" value="·" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="824" y="784" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t64" value="消费者只能读到 HW" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="784" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_t65" value="HW 封住“已确认但未同步完”的窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="806" width="650" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k07_p66" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="k07_t67" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k07_t68" value="HW 是副本安全性边界，不是 leader 的 LEO；ISR 是动态集合，不是存活副本列表。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
