        <mxCell id="k08_b10" value="3" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#D97706;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
