        <mxCell id="k03_t41" value="Replica" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="942" y="592" width="120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k03_t42" value="高可用。1 leader + N-1 follower；读写都走 leader，follower 只同步。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
