        </mxCell>
        <mxCell id="k03_t39" value="并行 + 有序。数量决定消费并行度上限；只能增不能减。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
