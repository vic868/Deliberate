        <mxCell id="k02_t53" value="Coordinator：成员、位移、Rebalance" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
