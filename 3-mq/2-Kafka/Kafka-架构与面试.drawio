        <mxCell id="k05_t17" value="send() 只保证“进了缓冲区”，不保证发出去；&#xa;成败要看 Callback / future.get() / flush()。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="310" width="380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k05_t18" value="batch 就绪 = 满 / linger.ms 到期 / 重试到期；&#xa;按 leader broker 分组后发 ProduceRequest。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="850" y="310" width="620" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k05_t19" value="关键超时：max.block.ms 管“入队/等 metadata”；delivery.timeout.ms 管“端到端（含重试）”的总预算。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#D97706;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
