        <mxCell id="k08_t22" value="sendfile" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0891B2;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="682" y="258" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k08_t23" value="传统 4 拷贝 / 4 切换；&#xa;sendfile 2 次 DMA / 0 次 CPU 拷贝。&#xa;TLS 会让它失效。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.2;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="682" y="296" width="236" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k08_t24" value="数据不进用户态" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#0891B2;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="682" y="388" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k08_t25" value="read+write：4 拷贝&#xa;sendfile：2 DMA + 0 CPU" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.5;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="684" y="500" width="232" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k08_p26" value="" style="rounded=1;arcSize=16;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="160" width="280" height="410" as="geometry" />
        </mxCell>
        <mxCell id="k08_t27" value="04" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="982" y="180" width="80" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_t28" value="批量 + 压缩" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="982" y="224" width="240" height="28" as="geometry" />
        </mxCell>
        <mxCell id="k08_t29" value="摊薄单位开销" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="982" y="258" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k08_t30" value="batch.size + linger.ms 攒批；&#xa;批次级 lz4/zstd，broker 不解压。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.2;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="982" y="296" width="236" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k08_t31" value="压缩在 producer 端做" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="982" y="388" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k08_b32" value="records" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=7.5;fontColor=#0F172A;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="984" y="500" width="80" height="32" as="geometry" />
        </mxCell>
        <mxCell id="k08_a33" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1064" y="516" as="sourcePoint" />
            <mxPoint x="1098" y="516" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k08_b34" value="compressed batch" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=7;fontColor=#7C3AED;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1098" y="500" width="118" height="32" as="geometry" />
        </mxCell>
        <mxCell id="k08_p35" value="" style="rounded=1;arcSize=16;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="160" width="280" height="410" as="geometry" />
        </mxCell>
        <mxCell id="k08_t36" value="05" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1282" y="180" width="80" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_t37" value="分区并行" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1282" y="224" width="240" height="28" as="geometry" />
        </mxCell>
        <mxCell id="k08_t38" value="唯一的水平扩展" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1282" y="258" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k08_t39" value="分区分散到多 broker；&#xa;生产/存储/消费都可并行。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.2;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1282" y="296" width="236" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k08_t40" value="分区是并行上限" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#059669;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1282" y="388" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k08_b41" value="P0" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1284" y="500" width="64" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_b42" value="P1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1358" y="500" width="64" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_b43" value="P2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1432" y="500" width="64" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_p44" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="k08_t45" value="别忘了：索引与读取路径也在为“快”服务" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="618" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k08_t46" value="稀疏索引：大约每 4KB 一条，索引小到可常驻 PageCache。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="658" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k08_t47" value="offset 查找 = 文件定位 + 二分 + 最多 4KB 顺序扫，不是全文件扫描。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="688" width="700" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k08_p48" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="650" width="670" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k08_t49" value="一次消费读取的完整成本" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="858" y="662" width="640" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k08_t50" value="索引 mmap（内存操作） → 日志 sendfile（DMA） → 网卡&#xa;几乎没有 CPU 参与数据搬运。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="858" y="688" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k08_p51" value="" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="760" width="1410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k08_t52" value="面试收尾：按「磁盘 → 内存 → 网络 → 结构 → 并行」答；最后补一句 TLS / 格式转换会让零拷贝失效。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.8;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="118" y="772" width="1370" height="36" as="geometry" />
        </mxCell>
        <mxCell id="k08_p53" value="" style="rounded=1;arcSize=12;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="892" width="1480" height="72" as="geometry" />
        </mxCell>
        <mxCell id="k08_t54" value="记住" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#93C5FD;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="88" y="906" width="86" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k08_t55" value="Kafka 的快是系统设计的结果：把随机变顺序，把拷贝变描述符，把单机变分区。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#F8FAFC;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="902" width="1330" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="k09" name="09 事务与 EOS">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="k09_accent" value="" style="rounded=1;arcSize=40;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="42" width="7" height="54" as="geometry" />
        </mxCell>
        <mxCell id="k09_title" value="事务与 Exactly-Once：幂等是地基，事务是闭环" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#0F172A;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="36" width="1180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k09_sub" value="PID + Sequence 解决重试重复；Transaction Coordinator 用两阶段提交，把输出与位移绑在一起。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#64748B;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="82" y="82" width="1330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_num" value="09 / 11" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1370" y="44" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_hdrline" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#E2E8F0;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="118" as="sourcePoint" />
            <mxPoint x="1540" y="118" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_p1" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="740" height="360" as="geometry" />
        </mxCell>
        <mxCell id="k09_t2" value="幂等生产者：给每个批次一个身份" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="168" width="680" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_t3" value="broker 端按 (PID, 分区) 记住最近 5 个批次的 sequence。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="204" width="680" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k09_b4" value="Producer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="248" width="150" height="54" as="geometry" />
        </mxCell>
        <mxCell id="k09_b5" value="PID + epoch&#xa;seq=0,1,2..." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="248" width="170" height="54" as="geometry" />
        </mxCell>
        <mxCell id="k09_b6" value="Broker 的&#xa;ProducerState" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FED7AA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#EA580C;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="530" y="248" width="220" height="54" as="geometry" />
        </mxCell>
        <mxCell id="k09_a7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="240" y="275" as="sourcePoint" />
            <mxPoint x="300" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_a8" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#94A3B8;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="275" as="sourcePoint" />
            <mxPoint x="530" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_b9" value="seq=0" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="340" width="80" height="48" as="geometry" />
        </mxCell>
        <mxCell id="k09_b10" value="seq=1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#059669;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="340" width="80" height="48" as="geometry" />
        </mxCell>
        <mxCell id="k09_b11" value="seq=1 重试" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#DC2626;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="340" width="80" height="48" as="geometry" />
        </mxCell>
        <mxCell id="k09_t12" value="重复序号 → 丢弃并返回成功；&#xa;跳号 → OutOfOrderSequenceException。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="346" width="420" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k09_t13" value="边界：只覆盖单 producer 会话 + 单分区；跨会话 / 业务重复要靠事务或业务幂等。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="414" width="680" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_t14" value="max.in.flight ≤ 5，因为 broker 只保留 5 个批次状态；&#xa;显式设 enable.idempotence=true，别让冲突参数把它静默关掉。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="452" width="680" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k09_p15" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="150" width="720" height="360" as="geometry" />
        </mxCell>
        <mxCell id="k09_t16" value="事务：把“输出”与“位移”放进同一个提交" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="168" width="660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_b17" value="Producer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=10;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="844" y="212" width="160" height="54" as="geometry" />
        </mxCell>
        <mxCell id="k09_b18" value="Transaction&#xa;Coordinator" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="212" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="k09_b19" value="__transaction_state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="212" width="220" height="54" as="geometry" />
        </mxCell>
        <mxCell id="k09_a20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1004" y="239" as="sourcePoint" />
            <mxPoint x="1050" y="239" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_a21" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="239" as="sourcePoint" />
            <mxPoint x="1290" y="239" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_t22" value="transactional.id → 哈希到 __transaction_state 分区 → 该分区 leader 就是 Coordinator。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="282" width="660" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k09_p23" value="" style="rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="844" y="318" width="660" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k09_t24" value="Coordinator 记录" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="330" width="630" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k09_t25" value="transactionalId · PID · epoch · state · partitions · groupMetadata" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="356" width="630" height="30" as="geometry" />
        </mxCell>
        <mxCell id="k09_t26" value="epoch 递增 = fencing：旧实例再写 → ProducerFenced，必须退出。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="414" width="660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_t27" value="事务只覆盖 Kafka Topic；数据库 / HTTP 不在事务里，仍需业务幂等。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#DC2626;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="844" y="448" width="660" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k09_p28" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="980" height="310" as="geometry" />
        </mxCell>
        <mxCell id="k09_t29" value="两阶段提交：Prepare 落盘 = 事务已经决定" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="84" y="558" width="920" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_b30" value="① Init&#xa;PID/epoch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="602" width="135" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k09_a31" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="225" y="634" as="sourcePoint" />
            <mxPoint x="247" y="634" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_b32" value="② Begin&#xa;纯本地" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="247" y="602" width="135" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k09_a33" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="382" y="634" as="sourcePoint" />
            <mxPoint x="404" y="634" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_b34" value="③ Send&#xa;登记分区" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="404" y="602" width="135" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k09_a35" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="539" y="634" as="sourcePoint" />
            <mxPoint x="561" y="634" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_b36" value="④ Offsets&#xa;位移挂起" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="561" y="602" width="135" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k09_a37" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="696" y="634" as="sourcePoint" />
            <mxPoint x="718" y="634" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_b38" value="⑤ EndTxn&#xa;Prepare" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="718" y="602" width="135" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k09_a39" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="853" y="634" as="sourcePoint" />
            <mxPoint x="875" y="634" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k09_b40" value="⑥ Markers&#xa;Commit/Abort" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="875" y="602" width="135" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k09_t41" value="Commit 控制批次写进业务分区日志；消费者读不到它，但它决定前面哪些批次可见。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="686" width="920" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k09_t42" value="Abort 不删除数据批次，只写 ABORT marker；read_committed 扫到 marker 后跳过整段。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="712" width="920" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k09_t43" value="PrepareCommit 一旦落盘，Coordinator 崩溃重启也会继续提交。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#7C3AED;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="748" width="920" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k09_t44" value="关键参数：transaction.timeout.ms ≤ broker 的 transaction.max.timeout.ms；&#xa;max.poll.interval.ms 必须大于一次事务的最长耗时。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8.8;fontColor=#64748B;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="90" y="780" width="920" height="40" as="geometry" />
        </mxCell>
        <mxCell id="k09_p45" value="" style="rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="540" width="480" height="310" as="geometry" />
        </mxCell>
        <mxCell id="k09_t46" value="read_committed 与 LSO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#059669;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1084" y="558" width="430" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k09_t47" value="LSO = 最早未结束事务的起始 offset" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#0F172A;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1084" y="594" width="420" height="22" as="geometry" />
        </mxCell>
        <mxCell id="k09_tl" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.2;" edge="1" parent="1">
