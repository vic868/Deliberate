        <mxCell id="k08_t4" value="append only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="82" y="258" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k08_t5" value="随机写 → 顺序写：少寻道、无原地更新；&#xa;段文件只在末尾追加。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.2;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="82" y="296" width="236" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k08_t6" value="顺序写是吞吐的地基" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#D97706;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="82" y="388" width="236" height="64" as="geometry" />
