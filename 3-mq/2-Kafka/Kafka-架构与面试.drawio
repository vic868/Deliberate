        <mxCell id="k03_t45" value="物理与保留。删除 / 清理 / 查找都以段为单位；活跃段永不删。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.8;fontColor=#475569;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
