          <mxGeometry x="660" y="160" width="280" height="410" as="geometry" />
        </mxCell>
        <mxCell id="k08_t20" value="03" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="682" y="180" width="80" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_t21" value="零拷贝" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#0891B2;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
