        <mxCell id="k09_tick6" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="640" as="sourcePoint" />
            <mxPoint x="1420" y="662" as="targetPoint" />
          </mxGeometry>
        </mxCell>
