          <mxGeometry x="382" y="180" width="80" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_t13" value="PageCache" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#2563EB;fontFamily=PingFang SC;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="382" y="224" width="240" height="28" as="geometry" />
        </mxCell>
        <mxCell id="k08_t14" value="OS 帮你缓存" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.5;fontColor=#2563EB;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="382" y="258" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k08_t15" value="写入先落 PageCache；热数据不碰磁盘。&#xa;Broker JVM heap 可以很小，GC 压力低。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.2;fontColor=#334155;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="382" y="296" width="236" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k08_t16" value="缓存交给 OS，JVM 保持小" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9.2;fontColor=#2563EB;fontFamily=PingFang SC;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="382" y="388" width="236" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k08_b17" value="JVM" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#0F172A;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="384" y="500" width="110" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k08_b18" value="PageCache" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=8;fontColor=#2563EB;fontFamily=PingFang SC;spacing=8;" vertex="1" parent="1">
